{
  "about": "Facet bench suite (facet-153), read by tools/bench.mjs. Every registered component and screen gets the auto scenarios with its default props; `cases` add named variants and interactions; `anchors` are the scenarios also measured on the panels (budgets.json), used to fit the WASM -> panel line; they keep `fades: true` because the panels were measured with fades. Scenarios: idle (settle 1 s, then 2 s with no input: a still component must not redraw), animate (2 s from the first frame: opening motion and loops), drag (settle, press, move along `path` for 600 ms, release, 400 ms), navigate (device runtime: go(`to`), 1.2 s, back, 1.2 s). `live` = the case redraws forever by design (idle redraw allowed; frame budget still applies). `stage: content` = width of the device, height of the content (doc pages).",
  "panel_skip": {},
  "timing": { "tick_ms": 16, "settle_ms": 1000, "window_ms": 2000, "drag_ms": 600, "after_ms": 400, "nav_ms": 1200 },
  "auto": { "sections": ["components", "screens"], "scenarios": ["idle", "animate"], "skip": ["device"] },
  "live": ["weather_icon", "tile", "toast_layer", "media_visual", "media_disc"],
  "cases": [
    { "id": "weather_icon.feature", "comp": "weather_icon", "props": { "icon": "rain-heavy", "size": "feature" }, "scenarios": ["animate"], "live": true, "tags": ["weather"] },
    { "id": "weather_icon.card", "comp": "weather_icon", "props": { "icon": "rain-heavy", "size": "card" }, "scenarios": ["animate"], "live": true, "tags": ["weather"] },
    { "id": "weather_icon.hero", "comp": "weather_icon", "props": { "icon": "rain-heavy", "size": "hero" }, "scenarios": ["animate"], "live": true, "tags": ["weather"] },
    { "id": "weather_icon.hero-thunder", "comp": "weather_icon", "props": { "icon": "thunder-rain", "size": "hero" }, "scenarios": ["animate"], "live": true, "tags": ["weather"] },
    { "id": "weather_icon.hero-partly", "comp": "weather_icon", "props": { "icon": "partly-day", "size": "hero" }, "scenarios": ["animate"], "live": true, "tags": ["weather"] },
    { "id": "weather_icon.hero-static", "comp": "weather_icon", "props": { "icon": "rain-heavy", "size": "hero", "animated": false }, "scenarios": ["idle"], "tags": ["weather"] },
    { "id": "icons.animated-page", "comp": "icons", "props": { "section": "animated" }, "stage": "content", "scenarios": ["animate"], "live": true, "tags": ["weather"], "about": "the Icons page Animated weather section (the 2026-10-22 lag)" },
    { "id": "thermostat_dial.drag", "comp": "thermostat_dial", "props": {}, "scenarios": ["drag"], "path": [[0.15, 0.3], [0.85, 0.3]], "browser_only": "WIP (parity batch A): not in the panel firmware until committed" },
    { "id": "cover_visual.drag", "comp": "cover_visual", "props": {}, "scenarios": ["drag"], "path": [[0.5, 0.3], [0.5, 0.8]], "browser_only": "WIP (parity batch A): not in the panel firmware until committed" },
    { "id": "slider.drag", "comp": "slider", "props": {}, "scenarios": ["drag"], "path": [[0.2, 0.5], [0.8, 0.5]] },
    { "id": "dial.drag", "comp": "dial", "props": {}, "scenarios": ["drag"], "path": [[0.15, 0.3], [0.85, 0.3]] },
    { "id": "toast.swipe", "comp": "toast", "props": {}, "scenarios": ["drag"], "path": [[0.5, 0.5], [0.95, 0.5]] },
    { "id": "settings.scroll", "comp": "settings", "props": {}, "scenarios": ["drag"], "path": [[0.5, 0.85], [0.5, 0.25]] },
    { "id": "settings.sheet-loop", "comp": "settings", "props": { "sheet": "loop" }, "scenarios": ["animate"], "live": true },
    { "id": "bottom_sheet.theme", "comp": "bottom_sheet", "props": { "list": "theme", "selected": 0 }, "scenarios": ["animate"] },
    { "id": "toast_layer.stack3", "comp": "toast_layer", "props": { "push": "ok", "stack": 3, "timer": false }, "scenarios": ["animate"] },
    { "id": "device.home-settings", "comp": "device", "props": {}, "scenarios": ["idle", "navigate"], "to": "settings" }
  ],
  "anchors": [
    { "id": "anchor.motion-sheet-open", "comp": "motion", "props": { "fades": true, "loop": "sheet-open" }, "scenarios": ["animate"], "live": true },
    { "id": "anchor.motion-fade", "comp": "motion", "props": { "fades": true, "loop": "fade" }, "scenarios": ["animate"], "live": true },
    { "id": "anchor.motion-screen", "comp": "motion", "props": { "fades": true, "loop": "screen" }, "scenarios": ["animate"], "live": true },
    { "id": "anchor.motion-clock-hand", "comp": "motion", "props": { "fades": true, "loop": "clock-hand" }, "scenarios": ["animate"], "live": true },
    { "id": "anchor.mascots-agents", "comp": "mascots", "props": { "fades": true, "bench": "agents" }, "scenarios": ["animate"], "live": true }
  ]
