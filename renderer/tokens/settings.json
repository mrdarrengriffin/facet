{
  "$comment": "Facet personalisation settings (single source for the WASM renderer; copied 2026-10-22 from Facet main packages/settings/src/settings.json, accent colours left out: they live in tokens/colour.json accents, the generator checks the ids). tools/gen_settings.mjs -> settings_gen.h (fw::set::) -> screens/settings.cpp. Same schema later feeds the panel's Home Assistant entities and the ESPHome web page. Facet personalisation settings: the one schema behind the on-panel Settings screen, the panel's Home Assistant entities (ESPHome template selects/numbers/switches), the ESPHome web_server page and the docs playground controls. Option labels are the exact option strings Home Assistant shows. esphome.id keeps the firmware's existing entity ids so Home Assistant entity ids never change.",
  "version": 1,
  "groups": [
    {
      "id": "look",
      "label": "Look"
    },
    {
      "id": "sound",
      "label": "Sound"
    },
    {
      "id": "idle",
      "label": "Clock and idle"
    },
    {
      "id": "behaviour",
      "label": "Behaviour"
    },
    {
      "id": "units",
      "label": "Units"
    }
  ],
  "settings": [
    {
      "id": "theme",
      "group": "look",
      "label": "Theme",
      "kind": "select",
      "control": "segmented",
      "default": "auto",
      "options": [
        {
          "id": "auto",
          "label": "Auto",
          "hint": "light while the sun is up"
        },
        {
          "id": "light",
          "label": "Light"
        },
        {
          "id": "dark",
          "label": "Dark"
        }
      ],
      "esphome": {
        "id": "theme_select",
        "name": "Theme",
        "icon": "mdi:theme-light-dark"
      }
    },
    {
      "id": "accent",
      "group": "look",
      "label": "Accent",
      "kind": "select",
      "control": "swatches",
      "default": "ember",
      "about": "The one colour for what matters: playing, needs you, the hero ring. Every set passes contrast in both themes: fill 3:1 against the canvas and cards, accent text 4.5:1, label on accent 4.5:1.",
      "options": [
        {
          "id": "ember",
          "label": "Ember"
        },
        {
          "id": "rose",
          "label": "Rose"
        },
        {
          "id": "violet",
          "label": "Violet"
        },
        {
          "id": "teal",
          "label": "Teal"
        },
        {
          "id": "mono",
          "label": "Mono"
        }
      ],
      "esphome": {
        "id": "accent_select",
        "name": "Accent",
        "icon": "mdi:palette-outline"
      }
    },
    {
      "id": "textSize",
      "group": "look",
      "label": "Text size",
      "kind": "select",
      "control": "segmented",
      "default": "standard",
      "about": "Large sets the small text roles one step bigger inside the same line boxes, so nothing on a screen moves (480: titles only; body and label line boxes have no room there).",
      "options": [
        {
          "id": "standard",
          "label": "Standard"
        },
        {
          "id": "large",
          "label": "Large",
          "type": {
            "title": 32,
            "body": 26,
            "label": 20
          }
        }
      ],
      "esphome": {
        "id": "text_size_select",
        "name": "Text size",
        "icon": "mdi:format-size"
      }
    },
    {
      "id": "sounds",
