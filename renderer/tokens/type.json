{
  "$comment": "Facet type tokens, the single source for the WASM renderer and the panel firmware (tools/gen_type.mjs -> type_gen.h; tools/gen_fonts.py -> one bitmap font per family/weight/size per density). Values are the approved Facet tokens (main: packages/tokens/src/tokens.json screenType + type, density.1x). Sizes, boxes and letter spacing are device px: the top level is the 720 x 720 reference panel (1.5x), \"1x\" = the 480 x 480 panels (optical pass: thin weights one step heavier, small text one step up). dp = px / density.",
  "families": {
    "sans": {
      "family": "Inter",
      "metrics": {
        "unitsPerEm": 2048,
        "ascender": 0.96875,
        "descender": -0.24121,
        "capHeight": 0.72754,
        "xHeight": 0.5459
      }
    },
    "mono": {
      "family": "JetBrains Mono",
      "metrics": {
        "unitsPerEm": 1000,
        "ascender": 1.02,
        "descender": -0.3,
        "capHeight": 0.73,
        "xHeight": 0.55
      }
    }
  },
  "densities": {
    "1.5x": {
      "device": "720 x 720 (Waveshare ESP32-P4-86, Shelly X1i)",
      "scale": 1
    },
    "1x": {
      "device": "480 x 480 (Guition ESP32-4848S040)",
      "scale": 0.6667
    }
  },
  "scales": [
    {
      "id": "screen",
      "label": "Screen scale",
      "about": "One hero per screen in a large light weight; everything else stays quiet, hierarchy comes from colour rather than size. Every line box is a multiple of 8 (4 at 1x), so text sits on the grid."
    },
    {
      "id": "component",
      "label": "Component scale",
      "about": "Smaller text inside components: lists, chips, buttons, headers. At 1x these are the reference sizes x 2/3 (min 12 px), boxes snapped to 4 px."
    }
  ],
  "glyphsets": {
    "digits": {
      "about": "digits and what numbers carry",
      "chars": [
        "0123456789",
        ":%-.,°+−—"
      ]
    },
    "numeric": {
      "about": "digits, units and currency",
      "chars": [
        "0123456789",
        ":%-.,°+−£— ",
        "kmhWV"
      ]
    },
    "ascii": {
      "about": "printable ASCII + ° £ (short values: 18:56, Off, Quiet, 12 km); — = the states.json unavailable placeholder in every number set",
      "glyphset": "GF_Latin_Kernel",
      "chars": [
        "°£·−—"
      ]
    },
    "text": {
      "about": "Google Fonts Latin Core (UK/EU text)",
      "glyphset": "GF_Latin_Core",
      "chars": [
        "·−→▲▼"
      ]
    },
    "clock": {
      "about": "clock digits: 0-9, the colon and the placeholder (the big clock fonts carry nothing else)",
      "chars": [
        "0123456789:—"
      ]
    },
    "ampm": {
      "about": "12h marker letters",
      "chars": [
        "AMP"
      ]
    }
  },
  "numbers": [
    {
      "id": "temperature",
      "label": "Temperature",
      "style": "display",
      "sample": "21.4°",
      "unit": "inline",
      "about": "The screen hero: digits, decimal and degree in one style, no space before °."
    },
    {
      "id": "percent",
      "label": "Percent",
      "style": "hero",
      "sample": "60%",
      "unit": "inline",
      "about": "% set in the same style, no space."
    },
    {
      "id": "money",
      "label": "Money",
      "style": "value",
      "sample": "£2.42",
      "unit": "inline",
      "about": "Home card value: £ prefix, two decimals."
    },
    {
      "id": "distance",
      "label": "Distance",
      "style": "value",
      "sample": "12 km",
      "unit": "inline",
      "about": "Word units get a space."
    },
    {
      "id": "dial",
      "label": "Dial value",
      "style": "display",
      "sample": "65",
      "unit": "%",
      "unitStyle": "body",
      "unitColour": "text-mute",
      "about": "Dial: the value alone in the hero, its unit below in body, text-mute (Facet controls.ts f-dial-unit)."
    },
    {
      "id": "small",
      "label": "Readout",
      "style": "c-number",
      "sample": "8.69",
      "unit": "inline",
      "about": "Big numbers on data screens (component number)."
    }
  ],
  "tabular": {
    "styles": [
      "display",
      "hero",
      "value",
      "c-number"
    ],
    "about": "Digits 0-9 share one advance (the widest digit, glyph centred), like the web tabular-nums, so values do not shift as they change. LVGL bitmap fonts have no OpenType features, so the generator does this."
  },
