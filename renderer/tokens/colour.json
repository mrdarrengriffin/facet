      {"section": "special", "fg": "qr-fg", "bg": "qr-bg", "kind": "ui", "use": "QR modules"},
      {"section": "lines", "fg": "line", "bg": ["bg", "surface"], "kind": "decor", "use": "1 px outlines, separators"},
      {"section": "lines", "fg": "line-hi", "bg": ["bg", "surface"], "kind": "decor", "use": "active / pressed outline, ticks"},
      {"section": "button", "fg": "on-accent", "bg": "accent", "kind": "text", "use": "primary · default / active: label + icon"},
