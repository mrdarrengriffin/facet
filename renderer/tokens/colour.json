{
  "about": "Facet colour tokens, the single source for the WASM build (build.sh generates the C++ header from this file). Values = the approved Facet tokens (main: packages/tokens/src/tokens.json color.*, accent sets: packages/settings/src/settings.json setting accent).",
  "groups": [
    {"id": "surfaces", "label": "Backgrounds and surfaces", "about": "The canvas and what sits on it. Dark is the default on panels."},
    {"id": "text", "label": "Text", "about": "Three levels; hierarchy comes from colour, not size."},
    {"id": "lines", "label": "Lines", "about": "1 px outlines and ticks."},
    {"id": "accent", "label": "Accent", "about": "The one colour for what matters. These five roles come from the selected accent set (below); the values here are the default set."},
    {"id": "secondary", "label": "Secondary accents", "about": "Quiet support colours: weather, markers, done states."},
    {"id": "status", "label": "Status", "about": ""},
    {"id": "special", "label": "Special purpose", "about": "Charts, the moon glyph and QR codes (QR stays dark on light in both themes)."},
    {"id": "media", "label": "Media visuals", "about": "Only for the media visuals (disc, cassette, CD, vinyl, reel)."}
  ],
  "colours": {
    "bg": {"group": "surfaces", "dark": "#000000", "light": "#F4F2EE", "role": "canvas"},
    "surface": {"group": "surfaces", "dark": "#0A0B0E", "light": "#FFFFFF", "role": "tile / card / secondary button"},
    "surface-press": {"group": "surfaces", "dark": "#15171C", "light": "#E9E6E0", "role": "pressed surface"},
    "text": {"group": "text", "dark": "#F2F1EE", "light": "#16181C", "role": "primary text"},
    "text-dim": {"group": "text", "dark": "#8A919B", "light": "#5C636D", "role": "secondary text"},
    "text-mute": {"group": "text", "dark": "#585E68", "light": "#868C95", "role": "meta, disabled"},
    "line": {"group": "lines", "dark": "#22262D", "light": "#DDD9D2", "role": "1 px outlines"},
    "line-hi": {"group": "lines", "dark": "#3A404A", "light": "#B9B4AB", "role": "active / pressed outline, ticks"},
    "accent": {"group": "accent", "dark": "#E8542A", "light": "#E8542A", "role": "signature orange: fills, rings, ticks"},
    "accent-press": {"group": "accent", "dark": "#D54B22", "light": "#DD532A", "role": "pressed orange"},
    "accent-dim": {"group": "accent", "dark": "#5A2414", "light": "#F5CDBF", "role": "disabled orange, working tile outline"},
    "accent-text": {"group": "accent", "dark": "#E8542A", "light": "#B63F1A", "role": "orange used as text/icon"},
    "on-accent": {"group": "accent", "dark": "#0A0B0E", "light": "#16181C", "role": "label on orange"},
    "blue": {"group": "secondary", "dark": "#9CC3E6", "light": "#2F6A9E", "role": "secondary accent: artist, weather, markers"},
    "steel": {"group": "secondary", "dark": "#4D7092", "light": "#6E8FAF", "role": "tertiary accent: done mascots, ticks"},
    "steel-dim": {"group": "secondary", "dark": "#2B3F55", "light": "#B9C8D6", "role": "quiet fills"},
    "ok": {"group": "status", "dark": "#5DBE7E", "light": "#2A7D48", "role": "status ok"},
    "warn": {"group": "status", "dark": "#E8B33A", "light": "#926600", "role": "status warn / needs you"},
    "error": {"group": "status", "dark": "#E5484D", "light": "#C9302C", "role": "status error"},
    "band-normal": {"group": "special", "dark": "#8A919B", "light": "#868C95", "role": "chart: the normal price band (cheap = blue, peak = accent)"},
    "moon-lit": {"group": "special", "dark": "#E9E4D6", "light": "#FBF8F0", "role": "moon phase glyph: the lit part"},
    "moon-dark": {"group": "special", "dark": "#15171C", "light": "#5C636D", "role": "moon phase glyph: the dark side"},
    "moon-edge": {"group": "special", "dark": "#3A404A", "light": "#5C636D", "role": "moon phase glyph: outline"},
    "qr-bg": {"group": "special", "dark": "#F2F1EE", "light": "#FFFFFF", "role": "QR code light modules and quiet zone (always light: scanners want dark on light)"},
    "qr-fg": {"group": "special", "dark": "#000000", "light": "#16181C", "role": "QR code dark modules"},
    "disc": {"group": "media", "dark": "#0C0E11", "light": "#ECE9E3", "role": "media disc face"},
    "groove": {"group": "media", "dark": "#181B20", "light": "#DDD9D2", "role": "disc grooves, inner rings"},
    "mv-shell": {"group": "media", "dark": "#1C1E23", "light": "#26282E", "role": "media visuals: cassette shell (smoke plastic)"},
    "mv-shell-2": {"group": "media", "dark": "#22252B", "light": "#2E3137", "role": "cassette head area / raised parts"},
    "mv-shell-edge": {"group": "media", "dark": "#3A3F48", "light": "#4A4E56", "role": "media visuals: moulded edges, outlines"},
    "mv-screw": {"group": "media", "dark": "#6B717B", "light": "#8A9099", "role": "cassette screws"},
    "mv-gap": {"group": "media", "dark": "#050607", "light": "#0E0F12", "role": "holes, openings, rubber"},
    "mv-paper": {"group": "media", "dark": "#D8D2C3", "light": "#EEE8D9", "role": "cassette label paper, vinyl label ground"},
    "mv-ink": {"group": "media", "dark": "#23252A", "light": "#23252A", "role": "writing on the label"},
    "mv-window": {"group": "media", "dark": "#0D0F12", "light": "#16181C", "role": "cassette window (smoked clear)"},
    "mv-glare": {"group": "media", "dark": "#FFFFFF", "light": "#FFFFFF", "role": "reflections (used at 7-22 % opacity)"},
    "mv-tape": {"group": "media", "dark": "#3B2A1F", "light": "#4A3426", "role": "tape (oxide brown): packs, tape path"},
    "mv-tape-hi": {"group": "media", "dark": "#6E5140", "light": "#7E604B", "role": "tape pack sheen / tape edge"},
    "mv-hub": {"group": "media", "dark": "#CFCBC3", "light": "#F1EEE8", "role": "cassette hubs (white plastic)"},
    "mv-clear": {"group": "media", "dark": "#1E2228", "light": "#D3D0CA", "role": "CD clear polycarbonate"},
    "mv-clear-2": {"group": "media", "dark": "#2E333B", "light": "#BDB9B2", "role": "CD clamping area, stacking ring"},
    "mv-mirror": {"group": "media", "dark": "#A9AFB8", "light": "#B9BEC6", "role": "CD metallised band"},
    "mv-iri-a": {"group": "media", "dark": "#6FD3FF", "light": "#6FD3FF", "role": "CD sheen (pre-rendered image on the panel)"},
    "mv-iri-b": {"group": "media", "dark": "#FF8AD8", "light": "#FF8AD8", "role": "CD sheen"},
    "mv-iri-c": {"group": "media", "dark": "#FFE07A", "light": "#FFE07A", "role": "CD sheen"},
    "mv-vinyl": {"group": "media", "dark": "#0E0E10", "light": "#121214", "role": "vinyl"},
    "mv-vinyl-edge": {"group": "media", "dark": "#1D1D21", "light": "#232327", "role": "vinyl edge bead"},
    "mv-vinyl-gloss": {"group": "media", "dark": "#202025", "light": "#26262B", "role": "vinyl lead-in / run-out / band gaps"},
    "mv-groove": {"group": "media", "dark": "#1A1A1E", "light": "#1F1F23", "role": "vinyl groove rings"},
    "mv-metal": {"group": "media", "dark": "#9AA0A8", "light": "#A7ADB5", "role": "tonearm, heads, guides, spindles"},
    "mv-metal-2": {"group": "media", "dark": "#5D636C", "light": "#6E747D", "role": "headshell, counterweight, arm rest"},
    "mv-deck": {"group": "media", "dark": "#14161A", "light": "#E4E0D9", "role": "deck parts: arm base, head cover"},
    "mv-reel": {"group": "media", "dark": "#2C3038", "light": "#C2C7CE", "role": "reel flanges (plastic)"}
  },
  "components": {
    "card": {
      "press": {"value": "fill", "options": ["fill", "border", "border-fill"], "use": "how a pressed card looks: card-press tint (fill), 1 px accent border (border) or both; a theme may set it later (board facet-130)"},
      "press-tint": {"value": 0.05, "use": "opacity of the accent tint over the card surface while pressed (mix card-press); a theme may set it later"},
      "press-desat": {"value": 0.5, "use": "how far the accent is moved towards neutral grey (text-mute) before tinting the pressed card (0 = pure accent, 1 = grey); a theme may set it later"}
    }
  },
  "mixes": {
    "card-press": {"tint": "accent", "toward": "text-mute", "desat": "card.press-desat", "over": "surface", "opa": "card.press-tint", "use": "pressed card fill: a faint, greyed accent tint over the surface (Darren 2026-10-21, card rounds 4-5), per theme x accent set"}
  },
  "contrast": {
    "about": "WCAG 2.x AA contrast, tested for EVERY pair below x theme (dark, light) x accent set, on the exact values and on the RGB565 values the panel shows (the worse counts): node renderer/tools/contrast.mjs (build.sh prints the summary). Pairs are declared where colours meet: foundations first, then one block per component (section = the component id); bg may list several backgrounds (a transparent control sits on the canvas or a card). A label pair also covers that control's icon (same colour, stricter threshold).",
    "kinds": {
      "text": {"min": 4.5, "label": "text", "about": "WCAG 1.4.3 normal text. Facet labels and body sizes are all below large text"},
      "large": {"min": 3, "label": "large text", "about": "WCAG 1.4.3 large text: at least 24 px regular or 18.66 px bold at panel px"},
      "ui": {"min": 3, "label": "graphic", "about": "WCAG 1.4.11: fills, borders, focus rings, icons and marks needed to see a control or its state"},
      "disabled": {"min": 3, "label": "disabled", "about": "Facet rule: WCAG exempts disabled controls, Facet still wants them readable at 3:1"},
      "decor": {"min": 1, "label": "decorative", "about": "no WCAG requirement (1 px outlines and separators; the label or content identifies the control): shown for reference"}
    },
    "pairs": [
      {"section": "text", "fg": "text", "bg": ["bg", "surface", "surface-press"], "kind": "text", "use": "primary text"},
      {"section": "text", "fg": "text-dim", "bg": ["bg", "surface", "surface-press"], "kind": "text", "use": "secondary text"},
      {"section": "text", "fg": "text-mute", "bg": ["bg", "surface"], "kind": "disabled", "use": "meta, disabled labels"},
      {"section": "text", "fg": "accent-text", "bg": ["bg", "surface", "surface-press"], "kind": "text", "use": "accent as text / icon"},
      {"section": "text", "fg": "blue", "bg": ["bg", "surface"], "kind": "text", "use": "secondary accent as text (artist)"},
      {"section": "accent", "fg": "accent", "bg": ["bg", "surface"], "kind": "ui", "use": "accent fill, ring, tick against its surroundings"},
      {"section": "accent", "fg": "on-accent", "bg": "accent", "kind": "text", "use": "label on an accent fill"},
      {"section": "accent", "fg": "on-accent", "bg": "accent-press", "kind": "text", "use": "label on a pressed accent fill"},
      {"section": "accent", "fg": "steel", "bg": ["bg", "surface"], "kind": "ui", "use": "tertiary accent: done marks, ticks"},
      {"section": "status", "fg": "ok", "bg": ["bg", "surface"], "kind": "text", "use": "status ok as text or icon"},
      {"section": "status", "fg": "warn", "bg": ["bg", "surface"], "kind": "text", "use": "status warn as text or icon"},
      {"section": "status", "fg": "error", "bg": ["bg", "surface"], "kind": "text", "use": "status error as text or icon"},
      {"section": "special", "fg": "band-normal", "bg": ["bg", "surface"], "kind": "ui", "use": "chart: normal price band"},
      {"section": "special", "fg": "blue", "bg": ["bg", "surface"], "kind": "ui", "use": "chart: cheap band, markers"},
      {"section": "special", "fg": "moon-lit", "bg": "moon-dark", "kind": "ui", "use": "moon glyph: lit part against the dark side (the phase shape)"},
      {"section": "special", "fg": "qr-fg", "bg": "qr-bg", "kind": "ui", "use": "QR modules"},
      {"section": "lines", "fg": "line", "bg": ["bg", "surface"], "kind": "decor", "use": "1 px outlines, separators"},
      {"section": "lines", "fg": "line-hi", "bg": ["bg", "surface"], "kind": "decor", "use": "active / pressed outline, ticks"},
      {"section": "button", "fg": "on-accent", "bg": "accent", "kind": "text", "use": "primary · default / active: label + icon"},
      {"section": "button", "fg": "accent", "bg": ["bg", "surface"], "kind": "ui", "use": "primary · default: fill against its surroundings"},
