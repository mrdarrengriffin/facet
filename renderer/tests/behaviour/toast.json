{
  "id": "toast",
  "tests": [
    {
      "name": "tap dismisses",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "dismiss"
          ]
        ],
        "sounds": [
          "back"
        ]
      }
    },
    {
      "name": "swipe dismisses",
      "kind": "interaction",
      "steps": [
        {
          "drag": {
            "clk": 0
          },
          "by": [
            0.5,
            0
          ]
        }
      ],
      "expect": {
        "events": [
          [
            "dismiss"
          ]
        ],
        "sounds": [
          "back"
        ]
      }
    }
  ],
  "xfail": {
    "lag:same-update:default": "BF-004"
  }
}
