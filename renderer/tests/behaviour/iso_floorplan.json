{
  "id": "iso_floorplan",
  "tests": [
    {
      "name": "tap a room picks it",
      "kind": "interaction",
      "props": {},
      "steps": [
        {
          "tap": {
            "at": [
              0.32,
              0.52
            ]
          }
        }
      ],
      "expect": {
        "events": [
          [
            "pick",
            "Lounge:1"
          ]
        ],
        "sounds": [
          "tap"
        ]
      }
    },
    {
      "name": "during a run a tap is blocked",
      "kind": "interaction",
      "props": {
        "state": "cleaning",
        "here": "Lounge"
      },
      "steps": [
        {
          "tap": {
            "at": [
              0.32,
              0.52
            ]
          }
        }
      ],
      "expect": {
        "no_events": [
          "pick"
        ],
        "sounds": [
          "error"
        ]
      }
    },
    {
      "name": "the robot moving redraws only its boxes",
      "kind": "interaction",
      "props": {
        "state": "cleaning",
        "robot": "1.4,4.8"
      },
      "steps": [
        {
          "update": {
            "state": "cleaning",
            "robot": "2.4,5.8"
          }
        },
        {
          "wait": 2200
        }
      ],
      "expect": {
        "silent": true,
        "redraw_max": 0.05
      }
    },
    {
      "name": "a pick from the screen redraws one room",
      "kind": "interaction",
      "props": {},
      "steps": [
        {
          "update": {
            "picked": "Kitchen:3"
          }
        }
      ],
      "expect": {
        "silent": true,
        "redraw_max": 0.35
      }
    },
    {
      "name": "update is silent",
      "kind": "sound",
      "steps": [
        {
          "update": {
            "picked": "Hall:3"
          }
        }
      ],
      "expect": {
        "silent": true
      }
    }
  ],
  "xfail": {}
}
