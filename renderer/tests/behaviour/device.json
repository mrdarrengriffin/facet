{
  "id": "device",
  "live": true,
  "live_why": "the Clock card on Home: its orbit dot moves every frame (~170 px) and its time text repaints (~800 px); both by design",
  "live_px": 1000,
  "tests": [
    {
      "name": "settings button opens Settings",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "navigate",
            "settings"
          ],
          [
            "screen",
            "settings"
          ]
        ],
        "sounds": [
          "open"
        ],
        "stack": [
          "home",
          "settings"
        ]
      }
    },
    {
      "name": "Back from Settings returns Home",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "clk": 0
          }
        },
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "back"
          ],
          [
            "screen",
            "home"
          ]
        ],
        "stack": [
          "home"
        ]
      }
    },
    {
      "name": "Sounds off: taps play nothing",
      "kind": "sound",
      "steps": [
        {
          "setting": "sounds=false"
        },
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "sounds": []
      }
    }
  ],
  "xfail": {}
}
