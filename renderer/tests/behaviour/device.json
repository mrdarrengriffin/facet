{
  "id": "device",
  "tests": [
    {
      "name": "settings button opens Settings",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "navigate",
            "settings"
          ],
          [
            "screen",
            "settings"
          ]
        ],
        "sounds": [
          "open"
        ],
        "stack": [
          "home",
          "settings"
        ]
      }
    },
    {
      "name": "Back from Settings returns Home",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "clk": 0
          }
        },
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "back"
          ],
          [
            "screen",
            "home"
          ]
        ],
        "stack": [
          "home"
        ]
      }
    },
    {
      "name": "three deep and back again",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "clk": 0
          }
        },
        {
          "tap": {
            "text": "Screens"
          }
        },
        {
          "tap": {
            "text": "Living room"
          }
        },
        {
          "tap": {
            "clk": 0
          }
        },
        {
          "tap": {
            "clk": 0
          }
        },
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "screen",
            "settings"
          ],
          [
            "screen",
            "screens"
          ],
          [
            "screen",
            "screen_set"
          ],
          [
            "screen",
            "screens"
          ],
          [
            "screen",
            "settings"
          ],
          [
            "screen",
            "home"
          ]
        ],
        "stack": [
          "home"
        ]
      }
    },
    {
      "name": "Sounds off: taps play nothing",
      "kind": "sound",
      "steps": [
        {
          "setting": "sounds=false"
        },
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "sounds": []
      }
    },
    {
      "name": "a Home card opens its entity's screen, named after it; Back returns",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "text": "/^SPEAKER$|^Speaker$/"
          }
        },
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "navigate",
            "media\\?"
          ],
          [
            "screen",
            "media"
          ],
          [
            "back"
          ],
          [
            "screen",
            "home"
          ]
        ],
        "stack": [
          "home"
        ]
      }
    },
    {
      "name": "a Home tile toggles its light",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "text": "/^Ceiling$/"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "tap",
            "Ceiling"
          ],
          [
            "ha",
            "light.toggle"
          ]
        ],
        "stack": [
          "home"
        ]
      }
    }
  ],
  "xfail": {}
}
