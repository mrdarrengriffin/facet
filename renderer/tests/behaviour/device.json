{
  "id": "device",
  "tests": [
    {
      "name": "settings button opens Settings",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "navigate",
            "settings"
          ],
          [
            "screen",
            "settings"
          ]
        ],
        "sounds": [
          "open"
        ],
        "stack": [
          "home",
          "settings"
        ]
      }
    },
    {
      "name": "Back from Settings returns Home",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "clk": 0
          }
        },
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "back"
          ],
          [
            "screen",
            "home"
          ]
        ],
        "stack": [
          "home"
        ]
      }
    },
    {
      "name": "three deep and back again",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "clk": 0
          }
        },
        {
          "tap": {
            "text": "Screens"
          }
        },
        {
          "tap": {
            "text": "Living room"
          }
        },
        {
          "tap": {
            "clk": 0
          }
        },
        {
          "tap": {
            "clk": 0
          }
        },
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "screen",
            "settings"
          ],
          [
            "screen",
            "screens"
          ],
          [
            "screen",
            "screen_set"
          ],
          [
            "screen",
            "screens"
          ],
          [
            "screen",
            "settings"
          ],
          [
            "screen",
            "home"
          ]
        ],
        "stack": [
          "home"
        ]
      }
    },
    {
      "name": "Sounds off: taps play nothing",
      "kind": "sound",
      "steps": [
        {
          "setting": "sounds=false"
        },
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "sounds": []
      }
    },
    {
      "name": "a Home card opens its entity's screen, named after it; Back returns",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "text": "/^SPEAKER$|^Speaker$/"
          }
        },
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "navigate",
            "media\\?"
          ],
          [
            "screen",
            "media"
          ],
          [
            "back"
          ],
          [
            "screen",
            "home"
          ]
        ],
        "stack": [
          "home"
        ]
      }
    },
    {
      "name": "a Home tile toggles its light",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "text": "/^Ceiling$/"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "tap",
            "Ceiling"
          ],
          [
            "ha",
            "light.toggle"
          ]
        ],
        "stack": [
          "home"
        ]
      }
    },
    {
      "name": "a Home page's header shortcut opens above that Home page: Kitchen > Timer > Back = Kitchen (facet-188)",
      "kind": "interaction",
      "steps": [
        {
          "drag": {
            "at": [
              0.5,
              0.8
            ]
          },
          "by": [
            0,
            -240
          ]
        },
        {
          "wait": 600
        },
        {
          "tap": {
            "text": "/^Kitchen$|^KITCHEN$/"
          }
        },
        {
          "tap": {
            "clk": 1
          }
        },
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "screen",
            "home"
          ],
          [
            "navigate",
            "timer"
          ],
          [
            "screen",
            "timer"
          ],
          [
            "back"
          ],
          [
            "screen",
            "home"
          ]
        ],
        "stack": [
          "home",
          "home"
        ]
      }
    },
    {
      "name": "Kitchen keeps the Settings button beside its Timer shortcut",
      "kind": "interaction",
      "steps": [
        {
          "drag": {
            "at": [
              0.5,
              0.8
            ]
          },
          "by": [
            0,
            -240
          ]
        },
        {
          "wait": 600
        },
        {
          "tap": {
            "text": "/^Kitchen$|^KITCHEN$/"
          }
        },
        {
          "tap": {
            "clk": 2
          }
        }
      ],
      "expect": {
        "events": [
          [
            "navigate",
            "settings"
          ],
          [
            "screen",
            "settings"
          ]
        ],
        "stack": [
          "home",
          "home",
          "settings"
        ]
      }
    },
    {
      "name": "a sensor tile (size s) is read-only: a tap on it does nothing (only the Kitchen card's open sound)",
      "kind": "interaction",
      "steps": [
        {
          "drag": {
            "at": [
              0.5,
              0.8
            ]
          },
          "by": [
            0,
            -240
          ]
        },
        {
          "wait": 600
        },
        {
          "tap": {
            "text": "/^Kitchen$|^KITCHEN$/"
          }
        },
        {
          "tap": {
            "text": "/^Fridge$/"
          }
        }
      ],
      "expect": {
        "no_events": [
          "ha"
        ],
        "sounds": [
          "open"
        ],
        "stack": [
          "home",
          "home"
        ]
      }
    }
  ],
  "xfail": {}
}
