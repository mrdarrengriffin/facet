{
  "id": "spec",
  "live_screens": [
    "clock",
    "lightning",
    "overhead",
    "aircraft",
    "timer",
    "media",
    "agents",
    "print",
    "weather"
  ],
  "tests": [
    {
      "name": "Light: centre button switches the light",
      "kind": "interaction",
      "props": {
        "screen": "light",
        "entity": "light.test"
      },
      "steps": [
        {
          "tap": {
            "text": "/^(ON|OFF)$/"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "light\\.(turn_off|turn_on|toggle).*light\\.test"
          ]
        ]
      },
      "before_ha": [
        [
          "light.test",
          "",
          "on"
        ],
        [
          "light.test",
          "brightness",
          "128"
        ]
      ]
    },
    {
      "name": "Light: drag on the dial sets the brightness",
      "kind": "interaction",
      "props": {
        "screen": "light",
        "entity": "light.test"
      },
      "steps": [
        {
          "drag": {
            "at": [
              0.5,
              0.2
            ]
          },
          "by": [
            0.12,
            0.03
          ]
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "light\\.turn_on.*light\\.test.*brightness"
          ]
        ]
      },
      "before_ha": [
        [
          "light.test",
          "",
          "on"
        ],
        [
          "light.test",
          "brightness",
          "128"
        ]
      ]
    },
    {
      "name": "Light: unavailable dial calls nothing",
      "kind": "interaction",
      "props": {
        "screen": "light",
        "entity": "light.test"
      },
      "steps": [
        {
          "tap": {
            "at": [
              0.5,
              0.79
            ]
          }
        },
        {
          "drag": {
            "at": [
              0.5,
              0.2
            ]
          },
          "by": [
            0.12,
            0.03
          ]
        }
      ],
      "expect": {
        "no_events": [
          "ha"
        ]
      },
      "before_ha": [
        [
          "light.test",
          "",
          "unavailable"
        ]
      ]
    },
    {
      "name": "Media: play / pause calls the player",
      "kind": "interaction",
      "props": {
        "screen": "media",
        "entity": "media_player.alpha"
      },
      "steps": [
        {
          "tap": {
            "at": [
              0.5,
              0.625
            ]
          }
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "media_play_pause.*media_player\\.alpha"
          ]
        ]
      },
      "before_ha": [
        [
          "media_player.alpha",
          "",
          "playing"
        ]
      ]
    },
    {
      "name": "Media: picking a speaker rebinds the screen",
      "kind": "interaction",
      "props": {
        "screen": "media",
        "entity": "media_player.alpha",
        "speakers": "media_player.alpha,media_player.beta"
      },
      "steps": [
        {
          "tap": {
            "clk": 1
          }
        },
        {
          "tap": {
            "text": "/[Bb][Ee][Tt][Aa]/"
          }
        },
        {
          "tap": {
            "at": [
              0.5,
              0.625
            ]
          }
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "media_play_pause.*media_player\\.beta"
          ]
        ]
      },
      "before_ha": [
        [
          "media_player.alpha",
          "",
          "playing"
        ],
        [
          "media_player.beta",
          "",
          "paused"
        ],
        [
          "media_player.beta",
          "friendly_name",
          "Beta"
        ]
      ]
    },
    {
      "name": "Media: HA values arriving are silent",
      "kind": "sound",
      "props": {
        "screen": "media",
        "entity": "media_player.alpha"
      },
      "steps": [
        {
          "ha": [
            "media_player.alpha",
            "",
            "paused"
          ]
        },
        {
          "ha": [
            "media_player.alpha",
            "volume_level",
            "0.2"
          ]
        }
      ],
      "expect": {
        "silent": true
      },
      "before_ha": [
        [
          "media_player.alpha",
          "",
          "playing"
        ]
      ]
    }
  ],
