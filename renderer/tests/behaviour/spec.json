{
  "id": "spec",
  "live_screens": [
    "clock",
    "lightning",
    "overhead",
    "aircraft",
    "timer",
    "media",
    "agents",
    "print",
    "weather"
  ],
  "tests": [
    {
      "name": "Light: centre button switches the light",
      "kind": "interaction",
      "props": {
        "screen": "light",
        "entity": "light.test"
      },
      "steps": [
        {
          "tap": {
            "text": "/^(ON|OFF)$/"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "light\\.(turn_off|turn_on|toggle).*light\\.test"
          ]
        ]
      },
      "before_ha": [
        [
          "light.test",
          "",
          "on"
        ],
        [
          "light.test",
          "brightness",
          "128"
        ]
      ]
    },
    {
      "name": "Light: drag on the dial sets the brightness",
      "kind": "interaction",
      "props": {
        "screen": "light",
        "entity": "light.test"
      },
      "steps": [
        {
          "drag": {
            "at": [
              0.5,
              0.2
            ]
          },
          "by": [
            0.12,
            0.03
          ]
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "light\\.turn_on.*light\\.test.*brightness"
          ]
        ]
      },
      "before_ha": [
        [
          "light.test",
          "",
          "on"
        ],
        [
          "light.test",
          "brightness",
          "128"
        ]
      ]
    },
    {
      "name": "Light: unavailable dial calls nothing",
      "kind": "interaction",
      "props": {
        "screen": "light",
        "entity": "light.test"
      },
      "steps": [
        {
          "tap": {
            "at": [
              0.5,
              0.79
            ]
          }
        },
        {
          "drag": {
            "at": [
              0.5,
              0.2
            ]
          },
          "by": [
            0.12,
            0.03
          ]
        }
      ],
      "expect": {
        "no_events": [
          "ha"
        ]
      },
      "before_ha": [
        [
          "light.test",
          "",
          "unavailable"
        ]
      ]
    },
    {
      "name": "Media: play / pause calls the player",
      "kind": "interaction",
      "props": {
        "screen": "media",
        "entity": "media_player.alpha"
      },
      "steps": [
        {
          "tap": {
            "at": [
              0.5,
              0.625
            ]
          }
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "media_play_pause.*media_player\\.alpha"
          ]
        ]
      },
      "before_ha": [
        [
          "media_player.alpha",
          "",
          "playing"
        ]
      ]
    },
    {
      "name": "Media: picking a speaker rebinds the screen",
      "kind": "interaction",
      "props": {
        "screen": "media",
        "entity": "media_player.alpha",
        "speakers": "media_player.alpha,media_player.beta"
      },
      "steps": [
        {
          "tap": {
            "clk": 1
          }
        },
        {
          "tap": {
            "text": "/[Bb][Ee][Tt][Aa]/"
          }
        },
        {
          "tap": {
            "at": [
              0.5,
              0.625
            ]
          }
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "media_play_pause.*media_player\\.beta"
          ]
        ]
      },
      "before_ha": [
        [
          "media_player.alpha",
          "",
          "playing"
        ],
        [
          "media_player.beta",
          "",
          "paused"
        ],
        [
          "media_player.beta",
          "friendly_name",
          "Beta"
        ]
      ]
    },
    {
      "name": "Media: HA values arriving are silent",
      "kind": "sound",
      "props": {
        "screen": "media",
        "entity": "media_player.alpha"
      },
      "steps": [
        {
          "ha": [
            "media_player.alpha",
            "",
            "paused"
          ]
        },
        {
          "ha": [
            "media_player.alpha",
            "volume_level",
            "0.2"
          ]
        }
      ],
      "expect": {
        "silent": true
      },
      "before_ha": [
        [
          "media_player.alpha",
          "",
          "playing"
        ]
      ]
    },
    {
      "name": "Door lock: hold the ring unlocks the lock",
      "kind": "interaction",
      "props": {
        "screen": "lock",
        "entity": "lock.test"
      },
      "before_ha": [
        [
          "lock.test",
          "",
          "locked"
        ]
      ],
      "steps": [
        {
          "press": {
            "hit": "lock_ring"
          }
        },
        {
          "wait": 1400
        },
        {
          "release": {
            "hit": "lock_ring"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "lock\\.unlock.*lock\\.test"
          ]
        ]
      }
    },
    {
      "name": "Door lock: a tap on an unlocked lock locks it",
      "kind": "interaction",
      "props": {
        "screen": "lock",
        "entity": "lock.test"
      },
      "before_ha": [
        [
          "lock.test",
          "",
          "unlocked"
        ]
      ],
      "steps": [
        {
          "tap": {
            "hit": "lock_ring"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "lock\\.lock.*lock\\.test"
          ]
        ]
      }
    },
    {
      "name": "Door lock: hold Open opens the latch",
      "kind": "interaction",
      "props": {
        "screen": "lock",
        "entity": "lock.test"
      },
      "before_ha": [
        [
          "lock.test",
          "",
          "locked"
        ],
        [
          "lock.test",
          "supported_features",
          "1"
        ]
      ],
      "steps": [
        {
          "press": {
            "hit": "hold_button"
          }
        },
        {
          "wait": 1400
        },
        {
          "release": {
            "hit": "hold_button"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "lock\\.open.*lock\\.test"
          ]
        ]
      }
    },
    {
      "name": "Robot vacuum: suction sets the fan speed",
      "kind": "interaction",
      "props": {
        "screen": "vacuum",
        "entity": "vacuum.test"
      },
      "before_ha": [
        [
          "vacuum.test",
          "",
          "docked"
        ],
        [
          "vacuum.test",
          "fan_speed",
          "balanced"
        ]
      ],
      "steps": [
        {
          "tap": {
            "text": "/^(TURBO|Turbo)$/"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "vacuum\\.set_fan_speed.*vacuum\\.test.*turbo"
          ]
        ]
      }
    },
    {
      "name": "Robot vacuum: a room tap picks it",
      "kind": "interaction",
      "props": {
        "screen": "vacuum",
        "entity": "vacuum.test"
      },
      "before_ha": [
        [
          "vacuum.test",
          "",
          "docked"
        ]
      ],
      "steps": [
        {
          "tap": {
            "hit": "room_tile"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "pick",
            "3"
          ]
        ],
        "sounds": [
          "tap"
        ]
      }
    },
    {
      "name": "Cameras: a camera tap opens its own screen",
      "kind": "interaction",
      "props": {
        "screen": "cameras"
      },
      "steps": [
        {
          "tap": {
            "text": "Front door"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "navigate",
            "^camera\\?"
          ]
        ],
        "sounds": [
          "open"
        ]
      }
    },
    {
      "name": "Camera: a tap on the still goes back",
      "kind": "interaction",
      "props": {
        "screen": "camera"
      },
      "steps": [
        {
          "tap": {
            "at": [
              0.5,
              0.4
            ]
          }
        }
      ],
      "expect": {
        "events": [
          [
            "back",
            ""
          ]
        ],
        "sounds": [
          "back"
        ]
      }
    },
    {
      "name": "Robot vacuum: cleaning hides the rooms, Pause sends pause",
      "kind": "interaction",
      "props": {
        "screen": "vacuum",
        "entity": "vacuum.test"
      },
      "before_ha": [
        [
          "vacuum.test",
          "",
          "cleaning"
        ]
      ],
      "steps": [
        {
          "drag": {
            "at": [
              0.5,
              0.75
            ]
          },
          "by": [
            0,
            -0.6
          ]
        },
        {
          "tap": {
            "text": "PAUSE"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "ha",
            "vacuum\\.pause.*vacuum\\.test"
          ]
        ],
        "absent": {
          "hit": "room_tile"
        }
      }
    }
  ],
