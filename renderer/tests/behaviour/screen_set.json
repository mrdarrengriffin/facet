{
  "id": "screen_set",
  "tests": [
    {
      "name": "Show on Home toggles",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "text": "Show on Home"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "toggle",
            "on"
          ],
          [
            "deck",
            "on=true"
          ]
        ],
        "sounds": [
          "toggle-on"
        ]
      }
    },
    {
      "name": "Back goes back",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "clk": 0
          }
        }
      ],
      "expect": {
        "events": [
          [
            "back"
          ]
        ],
        "sounds": [
          "back"
        ]
      }
    }
  ],
  "xfail": {
    "lag:tap:default": "BF-042"
  }
}
