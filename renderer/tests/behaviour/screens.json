{
  "id": "screens",
  "tests": [
    {
      "name": "row opens its screen settings",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "text": "Clock"
          }
        }
      ],
      "expect": {
        "events": [
          [
            "navigate",
            "screen_set.*clock"
          ]
        ]
      }
    },
    {
      "name": "toggle takes a screen off Home",
      "kind": "interaction",
      "steps": [
        {
          "tap": {
            "clk": 2
          }
        }
      ],
      "expect": {
        "events": [
          [
            "toggle",
            "off"
          ],
          [
            "deck",
            "on=false"
          ]
        ],
        "sounds": [
          "toggle-off"
        ]
      }
    },
    {
      "name": "a sent screen shows under Sent",
      "kind": "interaction",
      "before_spec": [
        [
          "screen",
          {
            "v": 1,
            "id": "sent_a",
            "rev": 1,
            "name": "Sent A",
            "role": "page",
            "layout": "list",
            "header": {
              "label": "Sent A",
              "back": true
            },
            "nodes": [
              {
                "c": "list_row",
                "p": {
                  "title": "Sent row"
                }
              }
            ]
          }
        ]
      ],
      "steps": [
        {
          "drag": {
            "at": [
              0.5,
              0.85
            ]
          },
          "by": [
            0,
            -0.7
          ]
        },
        {
          "wait": 600
        },
        {
          "drag": {
            "at": [
              0.5,
              0.85
            ]
          },
          "by": [
            0,
            -0.7
          ]
        },
        {
          "wait": 600
        },
        {
          "drag": {
            "at": [
              0.5,
              0.85
            ]
          },
          "by": [
            0,
            -0.7
          ]
        },
        {
          "wait": 600
        },
        {
          "drag": {
            "at": [
              0.5,
              0.85
            ]
          },
          "by": [
            0,
            -0.7
          ]
        },
        {
          "wait": 600
        }
      ],
      "expect": {
        "exists": {
          "text": "/^(Add to deck|ADD TO DECK)$/"
        }
      }
    },
