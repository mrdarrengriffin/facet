{
 "v": 1,
 "id": "c_plantseach",
 "name": "Plants",
 "rev": 1,
 "role": "both",
 "header": {
  "label": "Plants",
  "back": true
 },
 "layout": "list",
 "nodes": [
  {
   "c": "plant_gauge",
   "p": {
    "name": {
     "e": "$entity",
     "fmt": "name",
     "s": "Fern"
    },
    "moisture": {
     "e": "$entity",
     "fmt": "num",
     "s": "32"
    }
   }
  },
  {
   "c": "section_header",
   "p": {
    "title": "all plants",
    "badge": false,
    "right": "none"
   }
  },
  {
   "c": "plant_row",
   "each": "plants",
   "p": {
    "name": {
     "e": "$item",
     "fmt": "name"
    },
    "moisture": {
     "e": "$item",
     "fmt": "num"
    },
    "entity": "$item"
   },
   "sample": [
    {
     "name": "Fern",
     "moisture": 32
    },
    {
     "name": "Basil",
     "moisture": 60
    },
    {
     "name": "Cactus",
     "moisture": 12
    }
   ]
  }
 ],
 "params": {
  "entity": {
   "type": "entity",
   "domain": "sensor",
   "label": "Plant",
   "default": "sensor.fern_moisture"
  },
  "plants": {
   "type": "entities",
   "domain": "sensor",
   "label": "Plants",
   "default": "sensor.fern_moisture"
  }
 }
}