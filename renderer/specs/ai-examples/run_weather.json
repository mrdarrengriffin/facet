{
 "v": 1,
 "id": "run_weather",
 "name": "Run weather",
 "rev": 1,
 "role": "page",
 "header": {
  "label": "Run weather",
  "back": true
 },
 "layout": "list",
 "nodes": [
  {
   "c": "grid",
   "p": {
    "cols": 2,
    "gap": "group",
    "aspect": "row"
   }
  },
  {
   "c": "weather_icon",
   "p": {
    "icon": {
     "e": "weather.home",
     "map": {
      "sunny": "clear-day",
      "partlycloudy": "partly-day",
      "cloudy": "cloudy",
      "rainy": "rain-light",
      "pouring": "rain-heavy",
      "fog": "fog"
     },
     "else": "cloudy",
     "s": "partlycloudy"
    },
    "size": "card",
    "animated": true
   },
   "in": 0,
   "slot": 0
  },
  {
   "c": "big_number",
   "p": {
    "label": "degrees outside",
    "value": {
     "e": "weather.home",
     "a": "temperature",
     "s": "14"
    },
    "unit": "",
    "decimals": 0
   },
   "in": 0,
   "slot": 1
  },
  {
   "c": "status_chip",
   "p": {
    "tone": "ok",
    "text": {
     "e": "sensor.run_verdict",
     "s": "Good for a run · dry until 18:00"
    }
   }
  },
  {
   "c": "segmented",
   "p": {
    "options": "Run,Ride",
    "selected": {
     "e": "input_select.activity",
     "s": "run"
    },
    "width": "fill"
   }
  },
  {
   "c": "grid",
   "p": {
    "cols": 2,
    "gap": "group",
    "aspect": "row"
   }
  },
  {
   "c": "stat",
   "p": {
    "label": "wind",
    "value": {
     "e": "weather.home",
     "a": "wind_speed",
     "tpl": "{} km/h",
     "s": "12"
    }
   },
   "in": 5,
   "slot": 0
  },
  {
   "c": "stat",
   "p": {
    "label": "rain",
    "value": {
     "e": "sensor.rain_chance",
     "tpl": "{}%",
     "s": "5"
    },
    "tone": "ok"
   },
   "in": 5,
   "slot": 1
  },
  {
   "c": "stat",
   "p": {
    "label": "uv",
    "value": {
     "e": "sensor.uv_index",
     "tpl": "{} low",
     "s": "2"
    }
   },
   "in": 5,
   "slot": 2
  },
  {
   "c": "stat",
   "p": {
    "label": "sunset",
    "value": {
     "e": "sun.sun",
     "a": "next_setting",
     "s": "17:41"
    }
   },
   "in": 5,
   "slot": 3
  }
 ]
}
