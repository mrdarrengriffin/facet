{
 "v": 1,
 "id": "homelab",
 "name": "Homelab",
 "rev": 1,
 "role": "page",
 "header": {
  "label": "Homelab",
  "back": true
 },
 "layout": "list",
 "nodes": [
  {
   "c": "grid",
   "p": {
    "cols": 2,
    "gap": "near",
    "aspect": "row"
   }
  },
  {
   "c": "status_chip",
   "p": {
    "tone": {
     "e": "binary_sensor.nas",
     "map": {
      "on": "ok"
     },
     "else": "warn",
     "s": "on"
    },
    "text": "NAS",
    "pulse": false
   },
   "in": 0,
   "slot": 0
  },
  {
   "c": "status_chip",
   "p": {
    "tone": {
     "e": "binary_sensor.proxmox",
     "map": {
      "on": "ok"
     },
     "else": "warn",
     "s": "on"
    },
    "text": "Proxmox",
    "pulse": false
   },
   "in": 0,
   "slot": 1
  },
  {
   "c": "status_chip",
   "p": {
    "tone": {
     "e": "binary_sensor.backup",
     "map": {
      "on": "ok"
     },
     "else": "warn",
     "s": "off"
    },
    "text": "Backup box",
    "pulse": true
   },
   "in": 0,
   "slot": 2
  },
  {
   "c": "status_chip",
   "p": {
    "tone": {
     "e": "binary_sensor.router",
     "map": {
      "on": "ok"
     },
     "else": "warn",
     "s": "on"
    },
    "text": "Router",
    "pulse": false
   },
   "in": 0,
   "slot": 3
  },
  {
   "c": "section_header",
   "p": {
    "title": "nas cpu",
    "badge": false,
    "right": "meta",
    "meta": "last hour"
   }
  },
  {
   "c": "sparkline",
   "p": {
    "values": {
     "e": "sensor.nas_cpu_history",
     "s": "22,25,31,28,35,52,47,39,41"
    },
    "colour": "accent",
    "width": 224,
    "dot": true
   }
  },
  {
   "c": "grid",
   "p": {
    "cols": 2,
    "gap": "group",
    "aspect": "row"
   }
  },
  {
   "c": "stat",
   "p": {
    "label": "cpu",
    "value": {
     "e": "sensor.nas_cpu",
     "tpl": "{}%",
     "s": "41"
    }
   },
   "in": 7,
   "slot": 0
  },
  {
   "c": "stat",
   "p": {
    "label": "memory",
    "value": {
     "e": "sensor.nas_memory",
     "tpl": "{}%",
     "s": "63"
    }
   },
   "in": 7,
   "slot": 1
  },
  {
   "c": "stat",
   "p": {
    "label": "disk",
    "value": {
     "e": "sensor.nas_disk",
     "tpl": "{}%",
     "s": "78"
    },
    "tone": "warn"
   },
   "in": 7,
   "slot": 2
  },
  {
   "c": "stat",
   "p": {
    "label": "uptime",
    "value": {
     "e": "sensor.nas_uptime",
     "tpl": "{} days",
     "s": "12"
    }
   },
   "in": 7,
   "slot": 3
  }
 ]
}
