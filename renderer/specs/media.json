{
 "v": 1,
 "id": "media",
 "name": "Media",
 "rev": 3,
 "role": "both",
 "params": {
  "entity": {"about": "The media player this screen controls.", "type": "entity", "domain": "media_player", "label": "Player", "default": "media_player.sitting_room_speaker"},
  "speakers": {"about": "The speakers you can switch between in the speaker picker.", "type": "entities", "domain": "media_player", "label": "Speakers", "default": ""},
  "auto": {"about": "A sensor that names the speaker in the room you are in. When set, the picker offers Auto, which follows you.", "type": "entity", "domain": "sensor", "label": "Auto follows", "default": ""},
  "visual": {"about": "What is drawn for the music: disc is a plain record with a progress ring; cassette, cd and vinyl are drawn to their real look and turn while playing.", "type": "select", "options": ["disc", "cassette", "cd", "vinyl"], "label": "Visual", "default": "cd"}
 },
 "header": {
  "label": "Media",
  "back": true
 },
 "layout": "center",
 "nodes": [
  {
   "c": "media_view",
   "p": {
    "state": {"e": "$entity"},
    "title": {"e": "$entity", "a": "media_title"},
    "artist": {"e": "$entity", "a": "media_artist"},
    "volume": {"e": "$entity", "a": "volume_level", "fmt": "frac"},
    "position": {"e": "$entity", "a": "media_position", "fmt": "num"},
    "duration": {"e": "$entity", "a": "media_duration", "fmt": "num"},
    "position_at": {"e": "$entity", "a": "media_position_updated_at"},
    "visual": "$visual",
    "player": "$entity",
    "speakers": "$speakers",
    "mode": "$mode"
   },
   "on": {
    "media": {"do": "media.control", "e": "$entity"},
    "speaker": {"do": "screen.param", "param": "entity", "from": "speakers", "auto": "auto"}
   }
  }
 ]
}
