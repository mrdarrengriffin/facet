{
 "v": 1,
 "id": "lock",
 "name": "Door lock",
 "rev": 3,
 "role": "detail",
 "params": {
  "entity": {
   "type": "entity",
   "domain": "lock",
   "label": "Lock",
   "default": ""
  },
  "name": {
   "type": "text",
   "label": "Name (header)",
   "default": ""
  },
  "activity": {
   "type": "hidden",
   "default": ""
  },
  "demo": {
   "type": "select",
   "options": [
    "locked",
    "unlocked",
    "jammed",
    "locking",
    "unavailable"
   ],
   "label": "Sample state",
   "default": "locked"
  }
 },
 "header": {
  "label": "$name",
  "back": true
 },
 "layout": "list",
 "nodes": [
  {
   "c": "split",
   "p": {}
  },
  {
   "c": "lock_ring",
   "in": 0,
   "slot": 0,
   "p": {
    "state": {
     "e": "$entity",
     "s": "$demo"
    }
   },
   "on": {
    "lock": {
     "do": "lock.control",
     "e": "$entity"
    }
   }
  },
  {
   "c": "hold_button",
   "in": 0,
   "slot": 1,
   "p": {
    "label": "Hold to open door",
    "value": "open",
    "mask": 1,
    "features": {
     "e": "$entity",
     "a": "supported_features",
     "fmt": "num",
     "s": "1"
    },
    "state": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "unavailable": "disabled",
      "unknown": "disabled",
      "locking": "disabled",
      "unlocking": "disabled",
      "opening": "disabled"
     },
     "else": "default"
    }
   },
   "on": {
    "confirm": {
     "do": "lock.control",
     "e": "$entity"
    }
   }
  },
  {
   "c": "status_block",
   "in": 0,
   "slot": 2,
   "p": {
    "caption": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "locked": "secure",
      "unlocked": "not locked",
      "open": "latch open",
      "locking": "locking",
      "unlocking": "unlocking",
      "opening": "opening",
      "jammed": "jammed · check the door"
     },
     "else": "offline"
    },
    "value": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "locked": "Locked",
      "unlocked": "Unlocked",
      "open": "Open",
      "locking": "Locking",
      "unlocking": "Unlocking",
      "opening": "Opening",
      "jammed": "Jammed"
     },
     "else": ""
    },
    "line": {
     "e": "$entity",
     "a": "last_changed",
     "fmt": "time",
     "s": "09:03",
     "tpl": "since {}"
    },
    "line2": {
     "e": "$entity",
     "a": "changed_by",
     "s": "Alex",
     "tpl": "by {}"
    },
    "tone": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "locked": "dim",
      "locking": "dim",
      "unlocked": "accent",
      "open": "accent",
      "unlocking": "accent",
      "opening": "accent",
      "jammed": "error"
     },
     "else": "off"
    }
   }
  },
  {
   "c": "section_header",
   "in": 0,
   "slot": 2,
   "p": {
    "title": "last 24 h",
    "badge": false,
    "right": "none",
    "size": "label"
   }
  },
  {
   "c": "event_row",
   "in": 0,
   "slot": 2,
   "each": "activity",
   "p": {
    "event": "$item"
   },
   "sample": [
    {
     "event": "09:03|locked|Alex"
    },
    {
     "event": "09:01|unlocked|keypad"
    },
    {
     "event": "06:35|locked|Night lock"
    },
    {
     "event": "01:45|unlocked|Alex"
    }
   ]
  }
 ]
}
