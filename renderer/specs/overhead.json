{
  "v": 1,
  "id": "overhead",
  "locked": true,
  "name": "Overhead",
  "rev": 1,
  "role": "page",
  "params": {
    "view": {
      "about": "Which view it shows: now (the aircraft that leads, the next two), radar (every aircraft round home), list (all aircraft, closest first) or detail (the one that leads, in full).",
      "type": "hidden",
      "default": "now"
    },
    "source": {
      "about": "Where the aircraft come from: adsb.lol (open ADS-B data, no account or key: the panel reads it over the internet every 10 s while this screen or its Home card shows), FlightRadar24 in Home Assistant, an ADS-B receiver in Home Assistant (dump1090, readsb, tar1090), or a made-up sky for previews. A flight with no route of its own gets its from and to by callsign from adsbdb.com (public, no key); FlightRadar24 brings its own.",
      "type": "select",
      "options": [
        "adsb_lol",
        "fr24",
        "adsb_ha",
        "sample"
      ],
      "label": "Source",
      "default": "adsb_lol"
    },
    "sensor": {
      "about": "With a Home Assistant source: the sensor that lists the aircraft. Found by itself (FlightRadar24's Current in area, or your receiver's sensor); set it only when Home Assistant has more than one, from the Source sheet.",
      "type": "hidden",
      "default": ""
    },
    "lat": {
      "about": "Your home's latitude in degrees, the radar's centre. Empty (the default) = Home Assistant's home (zone.home); set it only for a panel without Home Assistant.",
      "type": "hidden",
      "default": ""
    },
    "lon": {
      "about": "Your home's longitude in degrees. Empty (the default) = Home Assistant's home.",
      "type": "hidden",
      "default": ""
    },
    "range": {
      "about": "How far out the radar reaches, in your distance unit (Settings > Units).",
      "type": "select",
      "options": [
        "10",
        "25",
        "50",
        "100"
      ],
      "labels": [
        "10 km",
        "25 km",
        "50 km",
        "100 km"
      ],
      "labels_mi": [
        "10 mi",
        "25 mi",
        "50 mi",
        "100 mi"
      ],
      "label": "Range",
      "default": "50"
    },
    "min_alt": {
      "about": "Leaves out aircraft lower than this (aircraft on the ground are always left out).",
      "type": "select",
      "options": [
        "0",
        "1000",
        "3000",
        "10000"
      ],
      "labels": [
        "Any height",
        "300 m",
        "900 m",
        "3,000 m"
      ],
      "labels_mi": [
        "Any height",
        "1,000 ft",
        "3,000 ft",
        "10,000 ft"
      ],
      "label": "Lowest altitude",
      "default": "0"
    }
  },
  "feeds": {
    "panel.flights": {
      "source": "$source",
      "sensor": "$sensor",
      "lat": "$lat",
      "lon": "$lon",
      "range": "$range",
      "min_alt": "$min_alt"
    }
  },
  "header": {
    "label": "Overhead",
    "back": true
  },
  "layout": "list",
  "card": {
    "label": "Overhead",
    "icon": "overhead",
    "preview": "flights",
    "planes": {
      "e": "panel.flights",
      "a": "planes"
    },
    "radar_unit": {
      "e": "panel.flights",
      "a": "unit"
    },
    "radar_range": {
      "e": "panel.flights",
      "a": "range"
    },
    "mode": "text",
    "text": {
      "e": "panel.flights",
      "a": "card_text"
    },
    "sub": {
      "e": "panel.flights",
      "a": "card_sub"
    },
    "accent": {
      "e": "panel.flights",
      "a": "card_accent"
    }
  },
