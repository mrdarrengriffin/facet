{
 "v": 1,
 "id": "light",
 "name": "Light",
 "rev": 3,
 "role": "detail",
 "params": {
  "entity": {"about": "The light this screen controls.", 
   "type": "entity",
   "domain": "light",
   "label": "Light",
   "default": "light.living_room_ceiling"
  },
  "name": {"about": "The name shown in the header, such as Ceiling.", 
   "type": "text",
   "label": "Name",
   "default": "Ceiling"
  }
 },
 "header": {
  "label": "$name",
  "back": true
 },
 "layout": "center",
 "nodes": [
  {
   "c": "dial",
   "p": {
    "caption": "Brightness",
    "unit": "%",
    "value": {
     "e": "$entity",
     "a": "brightness",
     "fmt": "pct"
    },
    "on": {
     "e": "$entity",
     "fmt": "on"
    },
    "state": {
     "e": "$entity",
     "fmt": "avail"
    },
    "dimmable": {
     "e": "$entity",
     "fmt": "dim"
    }
   },
   "on": {
    "input": {
     "do": "light.brightness",
     "e": "$entity"
    },
    "change": {
     "do": "light.brightness",
     "e": "$entity"
    },
    "toggle": {
     "do": "light.switch",
     "e": "$entity"
    }
   }
  }
 ]
}
