{
 "v": 1,
 "id": "weather",
 "name": "Weather",
 "rev": 4,
 "role": "page",
 "params": {
  "source": {
   "about": "Where the weather comes from: a weather entity in Home Assistant (its forecast too), or a made-up forecast for previews.",
   "type": "select",
   "options": [
    "ha",
    "sample"
   ],
   "label": "Source",
   "default": "ha"
  },
  "weather": {
   "about": "The weather forecast to show, such as the one Home Assistant sets up for your home.",
   "type": "entity",
   "domain": "weather",
   "label": "Forecast",
   "default": "weather.forecast_home"
  }
 },
 "feeds": {
  "panel.weather": {
   "source": "$source",
   "weather": "$weather"
  }
 },
 "card": {
  "icon": "weather",
  "preview": "weather",
  "weather": {
   "e": "panel.weather",
   "a": "icon"
  },
  "mode": "value",
  "value": {
   "e": "panel.weather",
   "a": "temp"
  },
  "sub": {
   "e": "panel.weather",
   "a": "card"
  }
 },
 "header": {
  "label": "Weather",
  "back": true
 },
 "layout": "center",
 "nodes": [
  {
   "c": "column",
   "p": {}
  },
  {
   "c": "weather_icon",
   "p": {
    "layout": "hero",
    "icon": {
     "e": "panel.weather",
     "a": "icon"
    },
    "size": "hero",
    "value": {
     "e": "panel.weather",
     "a": "temp"
    },
    "label": {
     "e": "panel.weather",
     "a": "condition"
    },
    "line": {
     "e": "panel.weather",
     "a": "line"
    }
   },
   "in": 0,
   "slot": 0
  },
  {
   "c": "group",
   "p": {
    "flow": "stack",
    "space": "line",
    "align": "start"
   },
   "in": 0,
   "slot": 0,
   "show": {
    "e": "panel.weather",
    "a": "rain"
   }
  },
  {
   "c": "status_line",
   "p": {
    "text": {
     "e": "panel.weather",
     "a": "rain"
    },
    "tone": {
     "e": "panel.weather",
     "a": "rain_tone"
    }
   },
   "in": 2,
   "slot": 0
  },
  {
   "c": "group",
   "p": {
    "flow": "stack",
    "space": "strip",
    "align": "start"
   },
   "in": 0,
   "slot": 0,
   "show": {
    "e": "panel.weather",
    "a": "has_hours"
   }
  },
  {
   "c": "grid",
   "p": {
    "cols": 8,
    "gap": "none",
    "aspect": "hug",
    "items": {
     "e": "panel.weather",
     "a": "hours"
    },
    "empty": ""
   },
   "in": 4,
   "slot": 0,
   "cell": {
    "c": "weather_icon",
    "p": {
     "layout": "column",
     "size": "glyph",
     "animated": false,
     "icon": "$item.icon",
     "label": "$item.label",
     "value": "$item.value",
     "accent": "$item.accent"
    }
   }
  },
  {
   "c": "more_row",
   "p": {
    "text": "next 5 days"
   },
   "in": 0,
   "slot": 1,
   "show": {
    "e": "panel.weather",
    "a": "has_hours"
   },
   "on": {
    "tap": {
     "do": "nav.open",
     "screen": "weather_days",
     "params": {
      "source": "$source",
      "weather": "$weather"
     }
    }
   }
  }
 ]
}
