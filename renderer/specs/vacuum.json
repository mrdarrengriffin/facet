{
 "v": 1,
 "id": "vacuum",
 "name": "Robot vacuum",
 "rev": 4,
 "role": "both",
 "params": {
  "entity": {"about": "The robot vacuum this screen controls.", 
   "type": "entity",
   "domain": "vacuum",
   "label": "Robot vacuum",
   "default": ""
  },
  "battery": {"about": "The sensor for the robot's battery level, in per cent.", 
   "type": "entity",
   "domain": "sensor",
   "label": "Battery (%)",
   "default": ""
  },
  "room": {"about": "The sensor for the room the robot is in now.", 
   "type": "entity",
   "domain": "sensor",
   "label": "Current room",
   "default": ""
  },
  "progress": {"about": "The sensor for how much of the current clean is done, in per cent.", 
   "type": "entity",
   "domain": "sensor",
   "label": "Cleaning progress (%)",
   "default": ""
  },
  "time": {"about": "The sensor for how long the current clean has run, in minutes.", 
   "type": "entity",
   "domain": "sensor",
   "label": "Cleaning time (min)",
   "default": ""
  },
  "area": {"about": "The sensor for how much floor the current clean has covered, in square metres.", 
   "type": "entity",
   "domain": "sensor",
   "label": "Cleaning area (m²)",
   "default": ""
  },
  "last_clean": {"about": "The sensor for when the last clean ended.", 
   "type": "entity",
   "domain": "sensor",
   "label": "Last clean end",
   "default": ""
  },
  "modesel": {"about": "The setting that picks the cleaning mode: vacuum, mop or both.", 
   "type": "entity",
   "domain": "select",
   "label": "Cleaning mode",
   "default": ""
  },
  "mopsel": {"about": "The setting that picks how much water the mop uses.", 
   "type": "entity",
   "domain": "select",
   "label": "Water (mop intensity)",
   "default": ""
  },
  "position": {"about": "The sensor for where the robot is on the map, as x and y.", 
   "type": "entity",
   "domain": "sensor",
   "label": "Robot position (x,y)",
   "default": ""
  },
  "transform": {"about": "How to turn the robot's own position numbers into metres on the floor plan, as six numbers separated by commas. Leave empty when they already match.", 
   "type": "text",
   "label": "Position to plan metres (a,b,c,d,e,f)",
   "default": ""
  },
  "path": {"about": "The sensor whose points are the path the robot has taken on this run.", 
   "type": "entity",
   "domain": "sensor",
   "label": "Run path (points attribute)",
   "default": ""
  },
  "areas": {"about": "Your rooms as the vacuum knows them, as name:number pairs separated by commas, such as Kitchen:3.", 
   "type": "text",
   "label": "Rooms (name:segment, comma list)",
   "default": ""
  },
  "plan": {"about": "The floor plan drawn on the map: each room's name, number, corners and label spot.", 
   "type": "hidden",
   "default": "Dining|2|0,0 3.6,0 3.6,3 0,3|1.8,1.5;Utility||3.7,0 6.4,0 6.4,1.4 3.7,1.4|;Study||3.7,1.5 6.4,1.5 6.4,3 3.7,3|;Lounge|1|0,3.1 3.9,3.1 3.9,7.2 0,7.2|1.95,5.15;Hall|3|4,3.1 6.4,3.1 6.4,5.6 4,5.6|5.2,4.35;Cloakroom||4,5.7 6.4,5.7 6.4,7.2 4,7.2|"
  },
  "dock": {"about": "Where the charging dock sits on the floor plan and which way it faces.", 
   "type": "hidden",
   "default": "0,0.5,0.14,0.8,0.36"
  },
  "rooms": {"about": "The rooms picked for the next clean.", 
   "type": "hidden",
   "default": ""
  },
  "view": {"about": "Which view the screen opens on: the room list or the map.", 
   "type": "hidden",
   "default": "rooms"
  },
  "demo": {"about": "For previews only: which state the sample robot is in, such as docked or cleaning.", 
   "type": "select",
   "options": [
    "docked",
    "cleaning",
    "paused",
    "returning"
   ],
   "label": "Sample state",
   "default": "docked"
  }
 },
 "header": {
  "label": "Vacuum",
  "back": true
 },
 "layout": "list",
 "nodes": [
  {
   "c": "segmented",
   "in": "header",
   "p": {
    "options": "Rooms, Map",
    "selected": "$view"
   },
   "on": {
    "change": {
     "do": "screen.param",
     "param": "view"
    }
   }
  },
  {
   "c": "column",
   "p": {}
  },
  {
   "c": "group",
   "in": 1,
   "slot": 0,
   "p": {
    "flow": "stack"
   },
   "show": {
    "e": "",
    "s": "$view",
    "map": {
     "rooms": "1"
    },
    "else": ""
   }
  },
  {
   "c": "status_block",
   "in": 2,
   "p": {
    "size": "hero",
    "caption": "",
    "value": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "docked": "Docked",
      "cleaning": "Cleaning",
      "returning": "Going home",
      "paused": "Paused",
      "idle": "Idle",
      "error": "Stuck"
     },
     "else": ""
    },
    "line": {
     "e": "$battery",
     "s": "$demo",
     "map": {
      "docked": "100",
      "cleaning": "74",
      "paused": "71",
      "returning": "62",
      "idle": "88",
      "error": "40"
     },
     "tpl": "{}%"
    },
    "line2": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "docked": "charged",
      "returning": "back to the dock"
     },
     "else": ""
    },
    "line3": {
     "e": "$last_clean",
     "fmt": "day",
     "s": "yesterday 18:42",
     "tpl": "last run {}"
    },
    "tone": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "error": "error"
     },
     "else": "dim"
    }
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "cleaning": "",
     "paused": ""
    },
    "else": "1"
   }
  },
  {
   "c": "status_block",
   "in": 2,
   "p": {
    "size": "hero",
    "caption": "",
    "value": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "docked": "Docked",
      "cleaning": "Cleaning",
      "returning": "Going home",
      "paused": "Paused",
      "idle": "Idle",
      "error": "Stuck"
     },
     "else": ""
    },
    "line": {
     "e": "$room",
     "s": "Lounge"
    },
    "line2": {
     "e": "$progress",
     "s": "46",
     "tpl": "{}%"
    },
    "line3": {
     "e": "$time",
     "s": "9",
     "tpl": "{} min"
    },
    "line4": {
     "e": "$area",
     "s": "7.6",
     "tpl": "{} m²"
    },
    "tone": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "cleaning": "accent"
     },
     "else": "dim"
    }
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "cleaning": "1",
     "paused": "1"
    },
    "else": ""
   }
  },
  {
   "c": "level_bar",
   "in": 2,
   "p": {
    "value": {
     "e": "$progress",
     "fmt": "num",
     "s": "46"
    },
    "mark": -1,
    "tone": "accent"
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "cleaning": "1",
     "paused": "1"
    },
    "else": ""
   }
  },
  {
   "c": "group",
   "in": 2,
   "p": {
    "space": "block"
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "cleaning": "",
     "returning": "",
     "paused": ""
    },
    "else": "1"
   }
  },
  {
   "c": "room_tile",
   "in": 6,
   "each": "areas",
   "p": {
    "room": "$item",
    "picked": "$rooms",
    "here": {
     "e": "$room",
     "s": "Lounge"
    },
    "state": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "cleaning": "disabled",
      "returning": "disabled",
      "paused": "disabled"
     },
     "else": "default"
    }
   },
   "sample": [
    {
     "room": "Lounge:1"
    },
    {
     "room": "Dining:2"
    },
    {
     "room": "Hall:3"
    }
   ],
   "on": {
    "pick": {
     "do": "screen.toggle",
     "param": "rooms"
    }
   }
  },
  {
   "c": "group",
   "in": 2,
   "p": {
    "space": "block"
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "cleaning": "",
     "returning": "",
     "paused": ""
    },
    "else": "1"
   }
  },
  {
   "c": "vacuum_mode",
   "in": 8,
   "p": {
    "style": "row",
    "mode": {
     "e": "$modesel",
     "s": "vac_and_mop"
    },
    "fan": {
     "e": "$entity",
     "a": "fan_speed",
     "s": "turbo"
    },
    "mop": {
     "e": "$mopsel",
     "s": "high"
    }
   },
   "on": {
    "change": {
     "do": "vacuum.control",
     "e": "$entity",
     "mode": "$modesel",
     "mop": "$mopsel"
    }
   }
  },
  {
   "c": "group",
   "in": 1,
   "slot": 0,
   "p": {
    "flow": "stack"
   },
   "show": {
    "e": "",
    "s": "$view",
    "map": {
     "map": "1"
    },
    "else": ""
   }
  },
  {
   "c": "status_block",
   "in": 10,
   "p": {
    "size": "title",
    "caption": "",
    "value": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "docked": "Docked",
      "cleaning": "Cleaning",
      "returning": "Going home",
      "paused": "Paused",
      "idle": "Idle",
      "error": "Stuck"
     },
     "else": ""
    },
    "value2": {
     "e": "$battery",
     "s": "$demo",
     "map": {
      "docked": "100",
      "cleaning": "74",
      "paused": "71",
      "returning": "62",
      "idle": "88",
      "error": "40"
     },
     "tpl": "{}%"
    },
    "line": {
     "e": "$last_clean",
     "fmt": "day",
     "s": "yesterday 18:42",
     "tpl": "last run {}"
    },
    "tone": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "error": "error"
     },
     "else": "dim"
    }
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "cleaning": "",
     "paused": ""
    },
    "else": "1"
   }
  },
  {
   "c": "status_block",
   "in": 10,
   "p": {
    "size": "title",
    "caption": "",
    "value": {
     "e": "$entity",
     "s": "$demo",
     "map": {
      "docked": "Docked",
      "cleaning": "Cleaning",
      "returning": "Going home",
      "paused": "Paused",
      "idle": "Idle",
      "error": "Stuck"
     },
     "else": ""
    },
    "value2": {
     "e": "$room",
     "s": "Lounge"
    },
    "line": {
     "e": "$progress",
     "s": "46",
     "tpl": "{}%"
    },
    "line2": {
     "e": "$time",
     "s": "9",
     "tpl": "{} min"
    },
    "line3": {
     "e": "$area",
     "s": "7.6",
     "tpl": "{} m²"
    },
    "line4": {
     "e": "$battery",
     "s": "74",
     "tpl": "battery {}%"
    }
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "cleaning": "1",
     "paused": "1"
    },
    "else": ""
   }
  },
  {
   "c": "group",
   "in": 10,
   "p": {
    "space": "near"
   }
  },
  {
   "c": "iso_floorplan",
   "in": 13,
   "p": {
    "plan": "$plan",
    "dock": "$dock",
    "transform": "$transform",
    "robot": {
     "e": "$position",
     "s": "$demo",
     "map": {
      "cleaning": "1.4,4.8",
      "paused": "1.4,4.8",
      "returning": "2.0,2.6"
     }
    },
    "trail": {
     "e": "$path",
     "a": "points",
     "s": "$demo",
     "map": {
      "docked": "0.6,0.7 3.1,0.7 3.1,1.3 0.6,1.3 0.6,1.9 3.1,1.9 3.1,2.5 0.6,2.5",
      "cleaning": "0.5,3.6 3.4,3.6 3.4,4.2 0.5,4.2 0.5,4.8 1.4,4.8",
      "paused": "0.5,3.6 3.4,3.6 3.4,4.2 0.5,4.2 0.5,4.8 1.4,4.8"
     },
     "else": ""
    },
    "picked": "$rooms",
    "here": {
     "e": "$room",
     "s": "Lounge"
    },
    "state": {
     "e": "$entity",
     "s": "$demo"
    }
   },
   "on": {
    "pick": {
     "do": "screen.toggle",
     "param": "rooms"
    }
   }
  },
  {
   "c": "group",
   "in": 1,
   "slot": 1,
   "p": {
    "align": "end"
   }
  },
  {
   "c": "vacuum_mode",
   "in": 15,
   "p": {
    "style": "button",
    "view": "$view",
    "mode": {
     "e": "$modesel",
     "s": "vac_and_mop"
    },
    "fan": {
     "e": "$entity",
     "a": "fan_speed",
     "s": "turbo"
    },
    "mop": {
     "e": "$mopsel",
     "s": "high"
    }
   },
   "on": {
    "change": {
     "do": "vacuum.control",
     "e": "$entity",
     "mode": "$modesel",
     "mop": "$mopsel"
    }
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "cleaning": "",
     "returning": "",
     "paused": ""
    },
    "else": "1"
   }
  },
  {
   "c": "button",
   "in": 15,
   "p": {
    "kind": "outline",
    "label": "Dock",
    "width": 112
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "docked": "",
     "returning": "",
     "unavailable": "",
     "unknown": ""
    },
    "else": "1"
   },
   "on": {
    "tap": {
     "do": "vacuum.control",
     "e": "$entity"
    }
   }
  },
  {
   "c": "button",
   "in": 15,
   "p": {
    "kind": "secondary",
    "label": "Pause",
    "width": 128
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "cleaning": "1",
     "returning": "1"
    },
    "else": ""
   },
   "on": {
    "tap": {
     "do": "vacuum.control",
     "e": "$entity"
    }
   }
  },
  {
   "c": "button",
   "in": 15,
   "p": {
    "kind": "primary",
    "label": "Resume",
    "width": 128
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "paused": "1"
    },
    "else": ""
   },
   "on": {
    "tap": {
     "do": "vacuum.control",
     "e": "$entity"
    }
   }
  },
  {
   "c": "button",
   "in": 15,
   "p": {
    "kind": "primary",
    "label": {
     "e": "",
     "s": "$rooms",
     "fmt": "count",
     "map": {
      "0": "Clean all",
      "1": "Clean {}"
     },
     "else": "Clean {} rooms"
    }
   },
   "show": {
    "e": "$entity",
    "s": "$demo",
    "map": {
     "docked": "1",
     "idle": "1",
     "error": "1"
    },
    "else": ""
   },
   "on": {
    "tap": {
     "do": "vacuum.control",
     "e": "$entity",
     "rooms": "$rooms"
    }
   }
  }
 ]
}
