{
 "v": 1,
 "id": "vacuum",
 "name": "Robot vacuum",
 "rev": 5,
 "role": "both",
 "params": {
  "source": {
   "about": "Where the robot vacuum comes from: a vacuum in Home Assistant with its sensors, or a made-up robot for previews.",
   "type": "select",
   "options": [
    "ha",
    "sample"
   ],
   "label": "Source",
   "default": "sample"
  },
  "entity": {
   "about": "The robot vacuum this screen controls.",
   "type": "entity",
   "domain": "vacuum",
   "label": "Robot vacuum",
   "default": ""
  },
  "battery": {
   "about": "The sensor for the robot's battery level, as a percentage.",
   "type": "entity",
   "domain": "sensor",
   "label": "Battery (%)",
   "default": ""
  },
  "room": {
   "about": "The sensor for the room the robot is in now.",
   "type": "entity",
   "domain": "sensor",
   "label": "Current room",
   "default": ""
  },
  "progress": {
   "about": "The sensor for how much of the current clean is done, as a percentage.",
   "type": "entity",
   "domain": "sensor",
   "label": "Cleaning progress (%)",
   "default": ""
  },
  "time": {
   "about": "The sensor for how long the current clean has run, in minutes.",
   "type": "entity",
   "domain": "sensor",
   "label": "Cleaning time (min)",
   "default": ""
  },
  "area": {
   "about": "The sensor for how much floor the current clean has covered, in square metres.",
   "type": "entity",
   "domain": "sensor",
   "label": "Cleaning area (m²)",
   "default": ""
  },
  "last_clean": {
   "about": "The sensor for when the last clean ended.",
   "type": "entity",
   "domain": "sensor",
   "label": "Last clean end",
   "default": ""
  },
  "status": {
   "about": "The sensor for what the robot is busy with, in its own words, such as emptying the bin.",
   "type": "entity",
   "domain": "sensor",
   "label": "Robot status",
   "default": ""
  },
  "error": {
   "about": "The sensor for the robot's error, such as a jammed brush.",
   "type": "entity",
   "domain": "sensor",
   "label": "Robot error",
   "default": ""
  },
  "modesel": {
   "about": "The setting that picks the cleaning mode: vacuum, mop or both.",
   "type": "entity",
   "domain": "select",
   "label": "Cleaning mode",
   "default": ""
  },
  "mopsel": {
   "about": "The setting that picks how much water the mop uses.",
   "type": "entity",
   "domain": "select",
   "label": "Water (mop intensity)",
   "default": ""
  },
  "position": {
   "about": "The sensor for where the robot is on the map, as x and y.",
   "type": "entity",
   "domain": "sensor",
   "label": "Robot position (x,y)",
   "default": ""
  },
  "transform": {
   "about": "How to turn the robot's own position numbers into metres on the floor plan, as six numbers separated by commas. Leave empty when they already match.",
   "type": "text",
   "label": "Position to plan metres (a,b,c,d,e,f)",
   "default": ""
  },
  "path": {
   "about": "The sensor whose points are the path the robot has taken on this run.",
   "type": "entity",
   "domain": "sensor",
   "label": "Run path (points attribute)",
   "default": ""
  },
  "areas": {
   "about": "Your rooms as the vacuum knows them, as name:number pairs separated by commas, such as Kitchen:3.",
   "type": "text",
   "label": "Rooms (name:segment, comma list)",
   "default": ""
  },
  "plan": {
   "about": "The floor plan drawn on the map: each room's name, number, corners and label spot.",
   "type": "hidden",
   "default": "Dining|2|0,0 3.6,0 3.6,3 0,3|1.8,1.5;Utility||3.7,0 6.4,0 6.4,1.4 3.7,1.4|;Study||3.7,1.5 6.4,1.5 6.4,3 3.7,3|;Lounge|1|0,3.1 3.9,3.1 3.9,7.2 0,7.2|1.95,5.15;Hall|3|4,3.1 6.4,3.1 6.4,5.6 4,5.6|5.2,4.35;Cloakroom||4,5.7 6.4,5.7 6.4,7.2 4,7.2|"
  },
  "dock": {
   "about": "Where the charging dock sits on the floor plan and which way it faces.",
   "type": "hidden",
   "default": "0,0.5,0.14,0.8,0.36"
  },
  "rooms": {
   "about": "The rooms picked for the next clean.",
   "type": "hidden",
   "default": ""
  },
  "view": {
   "about": "Which view the screen opens on: the room list or the map.",
   "type": "hidden",
   "default": "rooms"
  },
  "demo": {
   "about": "For previews only: which state the sample robot starts in, such as docked or cleaning.",
   "type": "select",
   "options": [
    "docked",
    "cleaning",
    "paused",
    "returning",
    "idle",
    "error"
   ],
   "label": "Sample state",
   "default": "docked"
  }
 },
 "feeds": {
  "panel.vacuum": {
   "source": "$source",
   "vacuum": "$entity",
   "battery": "$battery",
   "room": "$room",
   "progress": "$progress",
   "time": "$time",
   "area": "$area",
   "last_clean": "$last_clean",
   "status": "$status",
   "error": "$error",
   "position": "$position",
   "path": "$path",
   "mode": "$modesel",
   "mop": "$mopsel",
   "sample": "$demo"
  }
 },
 "card": {
  "label": "Vacuum",
  "icon": "vacuum",
  "preview": "vacuum",
  "progress": {
   "e": "panel.vacuum",
   "a": "card_ring"
  },
  "run": {
   "e": "panel.vacuum",
   "a": "card_run"
  },
  "mode": {
   "e": "panel.vacuum",
   "a": "card_mode"
  },
  "value": {
   "e": "panel.vacuum",
   "a": "card_value"
  },
  "text": {
   "e": "panel.vacuum",
   "a": "card_text"
  },
  "sub": {
   "e": "panel.vacuum",
   "a": "card_sub"
  },
  "accent": {
   "e": "panel.vacuum",
   "a": "card_accent"
  }
 },
 "header": {
  "label": "Vacuum",
  "back": true
 },
 "layout": "list",
 "nodes": [
  {
   "c": "segmented",
   "in": "header",
   "p": {
    "options": "Rooms, Map",
    "selected": "$view"
   },
   "on": {
    "change": {
     "do": "screen.param",
     "param": "view"
    }
   }
  },
  {
   "c": "column",
   "p": {}
  },
  {
   "c": "group",
   "in": 1,
   "slot": 0,
   "p": {
    "flow": "stack"
   },
   "show": {
    "e": "",
    "s": "$view",
    "map": {
     "rooms": "1"
    },
    "else": ""
   }
  },
  {
   "c": "status_block",
   "in": 2,
   "p": {
    "size": "hero",
    "caption": "",
    "value": {
     "e": "panel.vacuum",
     "a": "word"
    },
    "line": {
     "e": "panel.vacuum",
     "a": "battery"
    },
    "line2": {
     "e": "panel.vacuum",
     "a": "rest"
    },
    "line3": {
     "e": "panel.vacuum",
     "a": "last"
    },
    "tone": {
     "e": "panel.vacuum",
     "a": "tone"
    }
   },
   "show": {
    "e": "panel.vacuum",
    "a": "idle_show"
   }
  },
  {
   "c": "status_block",
   "in": 2,
   "p": {
    "size": "hero",
    "caption": "",
    "value": {
     "e": "panel.vacuum",
     "a": "word"
    },
    "line": {
     "e": "panel.vacuum",
     "a": "room"
    },
    "line2": {
     "e": "panel.vacuum",
     "a": "progress"
    },
    "line3": {
     "e": "panel.vacuum",
     "a": "minutes"
    },
    "line4": {
     "e": "panel.vacuum",
     "a": "area"
    },
    "tone": {
     "e": "panel.vacuum",
     "a": "tone"
    }
   },
   "show": {
    "e": "panel.vacuum",
    "a": "run_show"
   }
  },
  {
   "c": "level_bar",
   "in": 2,
   "p": {
    "value": {
     "e": "panel.vacuum",
     "a": "progress_n",
     "fmt": "num"
    },
    "mark": -1,
    "tone": "accent"
   },
   "show": {
    "e": "panel.vacuum",
    "a": "run_show"
   }
  },
  {
   "c": "group",
   "in": 2,
   "p": {
    "space": "block"
   }
  },
  {
   "c": "room_tile",
   "in": 6,
   "each": "areas",
   "p": {
    "room": "$item",
    "picked": "$rooms",
    "here": {
     "e": "panel.vacuum",
     "a": "here"
    },
    "state": {
     "e": "panel.vacuum",
     "a": "tile_state"
    }
   },
   "sample": [
    {
     "room": "Lounge:1"
    },
    {
     "room": "Dining:2"
    },
    {
     "room": "Hall:3"
    }
   ],
   "on": {
    "pick": {
     "do": "screen.toggle",
     "param": "rooms"
    }
   }
  },
  {
   "c": "group",
   "in": 2,
   "p": {
    "space": "block"
   }
  },
  {
   "c": "vacuum_mode",
   "in": 8,
   "p": {
    "style": "row",
    "mode": {
     "e": "panel.vacuum",
     "a": "mode"
    },
    "fan": {
     "e": "panel.vacuum",
     "a": "fan"
    },
    "mop": {
     "e": "panel.vacuum",
     "a": "mop"
    }
   },
   "on": {
    "change": {
     "do": "vacuum.control",
     "e": "panel.vacuum"
    }
   }
  },
  {
   "c": "group",
   "in": 1,
   "slot": 0,
   "p": {
    "flow": "stack"
   },
   "show": {
    "e": "",
    "s": "$view",
    "map": {
     "map": "1"
    },
    "else": ""
   }
  },
  {
   "c": "status_block",
   "in": 10,
   "p": {
    "size": "title",
    "caption": "",
    "value": {
     "e": "panel.vacuum",
     "a": "word"
    },
    "value2": {
     "e": "panel.vacuum",
     "a": "battery"
    },
    "line": {
     "e": "panel.vacuum",
     "a": "last"
    },
    "tone": {
     "e": "panel.vacuum",
     "a": "tone"
    }
   },
   "show": {
    "e": "panel.vacuum",
    "a": "idle_show"
   }
  },
  {
   "c": "status_block",
   "in": 10,
   "p": {
    "size": "title",
    "caption": "",
    "value": {
     "e": "panel.vacuum",
     "a": "word"
    },
    "value2": {
     "e": "panel.vacuum",
     "a": "where"
    },
    "line": {
     "e": "panel.vacuum",
     "a": "progress"
    },
    "line2": {
     "e": "panel.vacuum",
     "a": "minutes"
    },
    "line3": {
     "e": "panel.vacuum",
     "a": "area"
    },
    "line4": {
     "e": "panel.vacuum",
     "a": "bat_line"
    }
   },
   "show": {
    "e": "panel.vacuum",
    "a": "run_show"
   }
  },
  {
   "c": "group",
   "in": 10,
   "p": {
    "space": "near"
   }
  },
  {
   "c": "iso_floorplan",
   "in": 13,
   "p": {
    "plan": "$plan",
    "dock": "$dock",
    "transform": "$transform",
    "robot": {
     "e": "panel.vacuum",
     "a": "pos"
    },
    "trail": {
     "e": "panel.vacuum",
     "a": "trail"
    },
    "picked": "$rooms",
    "here": {
     "e": "panel.vacuum",
     "a": "here"
    },
    "state": {
     "e": "panel.vacuum"
    }
   },
   "on": {
    "pick": {
     "do": "screen.toggle",
     "param": "rooms"
    }
   }
  },
  {
   "c": "group",
   "in": 1,
   "slot": 1,
   "p": {
    "align": "end"
   }
  },
  {
   "c": "vacuum_mode",
   "in": 15,
   "p": {
    "style": "button",
    "view": "$view",
    "mode": {
     "e": "panel.vacuum",
     "a": "mode"
    },
    "fan": {
     "e": "panel.vacuum",
     "a": "fan"
    },
    "mop": {
     "e": "panel.vacuum",
     "a": "mop"
    }
   },
   "on": {
    "change": {
     "do": "vacuum.control",
     "e": "panel.vacuum"
    }
   },
   "show": {
    "e": "panel.vacuum",
    "a": "pick_show"
   }
  },
  {
   "c": "button",
   "in": 15,
   "p": {
    "kind": "outline",
    "label": "Dock",
    "width": 112
   },
   "show": {
    "e": "panel.vacuum",
    "a": "dock_show"
   },
   "on": {
    "tap": {
     "do": "vacuum.control",
     "e": "panel.vacuum"
    }
   }
  },
  {
   "c": "button",
   "in": 15,
   "p": {
    "kind": "secondary",
    "label": "Pause",
    "width": 128
   },
   "show": {
    "e": "panel.vacuum",
    "a": "pause_show"
   },
   "on": {
    "tap": {
     "do": "vacuum.control",
     "e": "panel.vacuum"
    }
   }
  },
  {
   "c": "button",
   "in": 15,
   "p": {
    "kind": "primary",
    "label": "Resume",
    "width": 128
   },
   "show": {
    "e": "panel.vacuum",
    "a": "resume_show"
   },
   "on": {
    "tap": {
     "do": "vacuum.control",
     "e": "panel.vacuum"
    }
   }
  },
  {
   "c": "button",
   "in": 15,
   "p": {
    "kind": "primary",
    "label": {
     "e": "",
     "s": "$rooms",
     "fmt": "count",
     "map": {
      "0": "Clean all",
      "1": "Clean {}"
     },
     "else": "Clean {} rooms"
    }
   },
   "show": {
    "e": "panel.vacuum",
    "a": "clean_show"
   },
   "on": {
    "tap": {
     "do": "vacuum.control",
     "e": "panel.vacuum",
     "rooms": "$rooms"
    }
   }
  }
 ]
}
