{
 "v": 1,
 "id": "timer",
 "name": "Timer",
 "rev": 3,
 "role": "page",
 "header": {
  "label": "Timer",
  "back": true
 },
 "layout": "center",
 "nodes": [
  {
   "c": "group",
   "p": {
    "flow": "stack",
    "space": "none",
    "align": "centre"
   }
  },
  {
   "c": "progress_ring",
   "p": {
    "value": {
     "e": "panel.timer",
     "a": "share"
    },
    "size": {
     "e": "panel.timer",
     "a": "bar",
     "map": {
      "1": "compact"
     },
     "else": "normal"
    }
   },
   "in": 0,
   "slot": 0
  },
  {
   "c": "hero_block",
   "p": {
    "n": {
     "e": "panel.timer",
     "a": "left"
    },
    "label": {
     "e": "panel.timer",
     "a": "name"
    },
    "line": {
     "e": "panel.timer",
     "a": "line"
    },
    "accent": false,
    "role": {"e": "panel.timer", "a": "bar", "map": {"1": "value"}, "else": "hero"},
    "layout": "stack"
   },
   "in": 1,
   "slot": 0
  },
  {
   "c": "group",
   "p": {
    "flow": "wrap",
    "space": "block",
    "align": "centre"
   },
   "in": 0,
   "slot": 0,
   "show": {
    "e": "panel.timer",
    "a": "bar",
    "map": {
     "1": "1"
    },
    "else": ""
   }
  },
  {
   "c": "grid",
   "p": {
    "cols": 4,
    "gap": "near",
    "aspect": "hug",
    "items": {
     "e": "panel.timer",
     "a": "all"
    },
    "empty": ""
   },
   "cell": {
    "c": "timer_chip",
    "p": {
     "name": "",
     "key": "$item.id",
     "left": "$item.left",
     "total": "$item.total",
     "state": "$item.state",
     "active": "$item.active"
    }
   },
   "on": {
    "select": {
     "do": "timer.select"
    },
    "stop": {
     "do": "timer.stop"
    }
   },
   "in": 3,
   "slot": 0
  },
  {
   "c": "group",
   "p": {
    "flow": "wrap",
    "space": "block",
    "align": "centre"
   },
   "in": 0,
   "slot": 0,
   "show": {
    "e": "panel.timer",
    "map": {
     "idle": "1",
     "picking": "1"
    },
    "else": ""
   }
  },
  {
   "c": "button",
   "p": {
    "kind": "secondary",
    "label": "3 min"
   },
   "on": {
    "tap": {
     "do": "timer.start",
     "seconds": 180
    }
   },
   "in": 5,
   "slot": 0
  },
  {
   "c": "button",
   "p": {
    "kind": "primary",
    "label": "5 min"
   },
   "on": {
    "tap": {
     "do": "timer.start",
     "seconds": 300
    }
   },
   "in": 5,
   "slot": 0
  },
  {
   "c": "button",
   "p": {
    "kind": "secondary",
    "label": "10 min"
   },
   "on": {
    "tap": {
     "do": "timer.start",
     "seconds": 600
    }
   },
   "in": 5,
   "slot": 0
  },
  {
   "c": "button",
   "p": {
    "kind": "secondary",
    "label": "20 min"
   },
   "on": {
    "tap": {
     "do": "timer.start",
     "seconds": 1200
    }
   },
   "in": 5,
   "slot": 0
  },
  {
   "c": "group",
   "p": {
    "flow": "wrap",
    "space": "none",
    "align": "centre"
   },
   "in": 0,
   "slot": 0,
   "show": {
    "e": "panel.timer",
    "map": {
     "picking": "1"
    },
    "else": ""
   }
  },
  {
   "c": "button",
   "p": {
    "kind": "ghost",
    "label": "Cancel"
   },
   "on": {
    "tap": {
     "do": "timer.back"
    }
   },
   "in": 10,
   "slot": 0
  },
  {
   "c": "group",
   "p": {
    "flow": "wrap",
    "space": "block",
    "align": "centre"
   },
   "in": 0,
   "slot": 0,
   "show": {
    "e": "panel.timer",
    "map": {
     "running": "1"
    },
    "else": ""
   }
  },
  {
   "c": "button",
   "p": {
    "kind": "secondary",
    "label": "+1 min"
   },
   "on": {
    "tap": {
     "do": "timer.extend",
     "s": 60
    }
   },
   "in": 12,
   "slot": 0
  },
  {
   "c": "button",
   "p": {
    "kind": "outline",
    "label": "Cancel"
   },
   "on": {
    "tap": {
     "do": "timer.cancel"
    }
   },
   "in": 12,
   "slot": 0
  },
  {
   "c": "button",
   "p": {
    "kind": "ghost",
    "label": "+ New"
   },
   "on": {
    "tap": {
     "do": "timer.new"
    }
   },
   "in": 12,
   "slot": 0
  },
  {
   "c": "group",
   "p": {
    "flow": "wrap",
    "space": "block",
    "align": "centre"
   },
   "in": 0,
   "slot": 0,
   "show": {
    "e": "panel.timer",
    "map": {
     "done": "1"
    },
    "else": ""
   }
  },
  {
   "c": "button",
   "p": {
    "kind": "primary",
    "label": "Stop"
   },
   "on": {
    "tap": {
     "do": "timer.stop"
    }
   },
   "in": 16,
   "slot": 0
  }
 ]
}