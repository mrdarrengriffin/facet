{
 "v": 1,
 "id": "covers",
 "name": "Blinds and curtains",
 "rev": 2,
 "role": "detail",
 "params": {
  "entity": {"about": "The blind or curtain this screen opens on.", "type": "entity", "domain": "cover", "label": "Window", "default": ""},
  "covers": {"about": "Every blind and curtain you can switch between on this screen.", "type": "entities", "domain": "cover", "label": "Windows", "default": ""}
 },
 "header": {
  "label": "Blinds",
  "back": true
 },
 "layout": "center",
 "nodes": [
  {
   "c": "covers_view",
   "p": {
    "state": {"e": "$entity"},
    "position": {"e": "$entity", "a": "current_position", "fmt": "num"},
    "tilt": {"e": "$entity", "a": "current_tilt_position", "fmt": "num"},
    "device_class": {"e": "$entity", "a": "device_class"},
    "cover": "$entity",
    "covers": "$covers"
   },
   "on": {
    "cover": {"do": "cover.control", "e": "$entity"},
    "window": {"do": "screen.param", "param": "entity", "from": "covers"}
   }
  }
 ]
}
