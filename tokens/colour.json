{
  "about": "Facet colour tokens, the single source for the WASM build (build.sh generates the C++ header from this file). Values = the approved Facet tokens (main: packages/tokens/src/tokens.json color.*, accent sets: packages/settings/src/settings.json setting accent).",
  "groups": [
    {"id": "surfaces", "label": "Backgrounds and surfaces", "about": "The canvas and what sits on it. Dark is the default on panels."},
    {"id": "text", "label": "Text", "about": "Three levels; hierarchy comes from colour, not size."},
    {"id": "lines", "label": "Lines", "about": "1 px outlines and ticks."},
    {"id": "accent", "label": "Accent", "about": "The one colour for what matters. These five roles come from the selected accent set (below); the values here are the default set."},
    {"id": "secondary", "label": "Secondary accents", "about": "Quiet support colours: weather, markers, done states."},
    {"id": "status", "label": "Status", "about": ""},
    {"id": "special", "label": "Special purpose", "about": "Charts, the moon glyph and QR codes (QR stays dark on light in both themes)."},
    {"id": "media", "label": "Media visuals", "about": "Only for the media visuals (disc, cassette, CD, vinyl, reel)."}
  ],
  "colours": {
    "bg": {"group": "surfaces", "dark": "#000000", "light": "#F4F2EE", "role": "canvas"},
    "surface": {"group": "surfaces", "dark": "#0A0B0E", "light": "#FFFFFF", "role": "tile / card / secondary button"},
    "surface-press": {"group": "surfaces", "dark": "#15171C", "light": "#E9E6E0", "role": "pressed surface"},
