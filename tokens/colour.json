  "contrast_about": "WCAG 2 contrast ratio of the exact token values, per theme, for the current accent set. min = what the pair must reach (4.5 text, 3 fills, large text, meta; outlines lower).",
  "contrast": [
    {"fg": "text", "bg": "bg", "min": 4.5, "label": "primary text on the canvas"},
    {"fg": "text", "bg": "surface", "min": 4.5, "label": "primary text on a card"},
    {"fg": "text-dim", "bg": "surface", "min": 4.5, "label": "secondary text on a card"},
    {"fg": "text-mute", "bg": "surface", "min": 3, "label": "meta / disabled on a card"},
    {"fg": "accent-text", "bg": "surface", "min": 4.5, "label": "accent as text on a card"},
    {"fg": "on-accent", "bg": "accent", "min": 4.5, "label": "label on an accent fill"},
    {"fg": "accent", "bg": "bg", "min": 3, "label": "accent fill on the canvas"},
    {"fg": "line-hi", "bg": "surface", "min": 1.5, "label": "active outline on a card"},
    {"fg": "blue", "bg": "surface", "min": 3, "label": "secondary accent on a card"},
    {"fg": "warn", "bg": "surface", "min": 3, "label": "status on a card"}
  ],
  "accent": {
    "about": "The one colour for what matters: playing, needs you, the hero ring. Every set passes contrast in both themes: fill 3:1 against the canvas and cards, accent text 4.5:1, label on accent 4.5:1. Selected per panel by the Accent setting (default ember); a set replaces the five accent roles in both themes.",
    "default": "ember",
    "roles": ["accent", "accent-press", "accent-dim", "accent-text", "on-accent"],
    "min_contrast": {"accent": 3, "accent-text": 4.5, "on-accent": 4.5},
