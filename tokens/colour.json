    "text-mute": {"group": "text", "dark": "#565C66", "light": "#9A9FA6", "role": "meta, disabled"},
    "line": {"group": "lines", "dark": "#22262D", "light": "#DDD9D2", "role": "1 px outlines"},
    "line-hi": {"group": "lines", "dark": "#3A404A", "light": "#B9B4AB", "role": "active / pressed outline, ticks"},
    "accent": {"group": "accent", "dark": "#E8542A", "light": "#E8542A", "role": "signature orange: fills, rings, ticks"},
    "accent-press": {"group": "accent", "dark": "#C2441F", "light": "#C2441F", "role": "pressed orange"},
    "accent-dim": {"group": "accent", "dark": "#5A2414", "light": "#F5CDBF", "role": "disabled orange, working tile outline"},
    "accent-text": {"group": "accent", "dark": "#E8542A", "light": "#B8401A", "role": "orange used as text/icon"},
