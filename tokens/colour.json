    "mv-iri-c": {"group": "media", "dark": "#FFE07A", "light": "#FFE07A", "role": "CD sheen"},
    "mv-vinyl": {"group": "media", "dark": "#0E0E10", "light": "#121214", "role": "vinyl"},
