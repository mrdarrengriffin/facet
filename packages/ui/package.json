{
  "name": "@facet/ui",
  "version": "0.1.0",
  "description": "Facet components and screens in plain TypeScript: factories that return DOM elements, no framework.",
  "license": "MIT",
  "author": "Darren Griffin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./checkbox.css": "./dist/checkbox.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@facet/icons": "workspace:*",
    "@facet/settings": "workspace:*",
    "@facet/tokens": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
