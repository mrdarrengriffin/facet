{
  "name": "@facet/settings",
  "version": "0.1.0",
  "description": "Facet personalisation settings: one schema for the Settings screen, the Home Assistant entities, the ESPHome web_server page and the docs controls.",
  "license": "MIT",
  "author": "Darren Griffin",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settings.json": "./dist/settings.json",
    "./esphome/settings.yaml": "./dist/esphome/settings.yaml"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
