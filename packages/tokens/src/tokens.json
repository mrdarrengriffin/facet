  "font": {
    "$comment": "metrics come from the font files (em units): ascender / descender from hhea, cap height / x-height from OS/2. Text boxes centre the cap height in the type's box.",
    "sans": {
      "family": "Inter",
      "fallback": "system-ui, sans-serif",
      "metrics": {
        "unitsPerEm": 2048,
        "ascender": 0.96875,
        "descender": -0.24121,
        "capHeight": 0.72754,
        "xHeight": 0.5459
      }
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "ui-monospace, monospace",
      "metrics": {
        "unitsPerEm": 1000,
        "ascender": 1.02,
        "descender": -0.3,
        "capHeight": 0.73,
        "xHeight": 0.55
      }
    }
  },
  "screenType": {
    "$comment": "The screen type scale: one hero per screen in a large light weight, everything else quiet. box = the text's line box in px (a multiple of 8). lvgl = the firmware font id.",
