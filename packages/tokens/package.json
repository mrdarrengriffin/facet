{
  "name": "@facet/tokens",
  "version": "0.1.0",
  "description": "Design tokens for Facet: colour, type, layout, motion and sound, as typed objects, CSS variables and ESPHome YAML.",
  "license": "MIT",
  "author": "Darren Griffin",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./esphome/tokens.yaml": "./dist/esphome/tokens.yaml"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
