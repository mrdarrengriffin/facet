---
// The Screens overview: every screen (scripts/extract.mjs screenSet(): the specs + the build's registered screens) as
// a still picture drawn by the WASM renderer on sample data, grouped as on the roadmap; each opens its page.
import Docs from '../../layouts/Docs.astro';
import Live from '../../components/Live.astro';
import { SCREENS, STATUS, screenGroups, screenHref } from '../../lib/data';
import { url } from '../../lib/nav';
const done = SCREENS.filter((s) => s.status !== 'wip').length;
---

<Docs
  title="Screens"
  description={`One job per screen. ${SCREENS.length} screens, each drawn here by the renderer the panels run, on sample data.`}
  group="Screens"
  current={url('/screens/')}
  wide
>
  <p>
    A screen is built from the <a href={url('/components/')}>components</a>: most are a short spec that names its parts
    and settings, and the panel finds the data for them. {done} of {SCREENS.length} are done; the rest are being worked on.
  </p>
  {
    screenGroups().map((g) => (
      <section>
        <h2 class="facet-label">{g.label}</h2>
        <ul class="shots">
          {g.items.map((s) => (
            <li>
              <a class="shot" href={screenHref(s)}>
                <span class="shot__viewport">
                  <Live comp={s.comp} props={s.sampleProps} label={s.name} frame={s.frame} caption={false} still />
                </span>
                <span class="shot__name">{s.name}{s.status === 'wip' && <span class="badge" title={STATUS.wip.hint}>WIP</span>}</span>
                <span class="shot__about">{s.about}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Docs>
