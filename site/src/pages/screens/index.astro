---
// The Screens overview: every screen (scripts/extract.mjs screenSet(): the specs + the build's registered screens) as
// a picture drawn by the WASM renderer at build on sample data (scripts/shots.mjs), grouped as on the roadmap; each
// opens its page.
import Docs from '../../layouts/Docs.astro';
import Shot from '../../components/Shot.astro';
import ChannelBadge from '../../components/ChannelBadge.astro';
import { PANEL_FEATURES, PANEL_LABEL, STATUS, screenGroups, screenHref } from '../../lib/data';
import Count from '../../components/Count.astro';
import { url } from '../../lib/nav';
import { COUNTS } from '../../lib/counts';
import flags from '../../data/features.json';
// Coming soon from the wip branch (renderer/features.json wip): cards that open their spot on /screens/coming-soon/
const WIP = flags.wip as { id: string; label: string; about: string; pictures: { file: string }[] }[];
---

<Docs
  edit="site/src/pages/screens/index.astro"
  title="Screens"
  description={`One job per screen. The ${COUNTS.screens} factory screens, plus Home and Settings, each drawn here by the renderer the panels run, on sample data.`}
  group="Screens"
  current={url('/screens/')}
  wide
>
  <p>
    A screen is built from the <a href={url('/components/')}>components</a>: most are a short spec that names its parts
    and settings, and the panel finds the data for them. Facet comes with <Count k="screens" /> screens, plus Home and
    Settings; choose which are on your panel under <strong>Settings &gt; Screens</strong>. A screen marked
    <strong>Beta</strong> is in a beta of the next version, not yet in a release; <strong>Coming soon</strong> is not on a released
    firmware yet: in the docs, or still being designed (<a href="#coming-soon">below</a>). What every panel has besides its screens (set up, Settings, the idle
    clock and the rest) is under <a href="#panel">{PANEL_LABEL}</a>.
  </p>
  {
    screenGroups().map((g) => (
      <section>
        <h2 class="facet-label">{g.label}</h2>
        <ul class="shots">
          {g.items.map((s) => (
            <li>
              <a class="shot" href={screenHref(s)}>
                <span class="shot__viewport">
                  <Shot id={s.id} kind="half" alt="" />
                </span>
                <span class="shot__name">{s.name}{s.channel !== 'stable' && ' '}<ChannelBadge channel={s.channel} of={s.id} />{s.status === 'wip' && <span class="badge" title={STATUS.wip.hint}>WIP</span>}</span>
                <span class="shot__about">{s.about}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <section>
    <h2 class="facet-label" id="coming-soon">Coming soon</h2>
    <p class="hint">Screens being designed, in no firmware yet. More on each: <a href={url('/screens/coming-soon/')}>Coming soon</a>.</p>
    <ul class="shots">
      {WIP.map((w) => (
        <li>
          <a class="shot" href={url(`/screens/coming-soon/#${w.id}`)}>
            <span class="shot__viewport">
              <img class="shot-img" src={url(`/coming-soon/${w.pictures[0].file}-360.webp`)} srcset={`${url(`/coming-soon/${w.pictures[0].file}-360.webp`)} 360w, ${url(`/coming-soon/${w.pictures[0].file}-720.png`)} 720w`} sizes="240px" width="360" height="360" alt="" loading="lazy" decoding="async" />
            </span>
            <span class="shot__name">{w.label} <ChannelBadge channel="soon" of={w.id} /></span>
            <span class="shot__about">{w.about}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <section>
    <h2 class="facet-label" id="panel">{PANEL_LABEL}</h2>
    <p class="hint">Not screens you add: part of every panel, most of them in Settings.</p>
    <ul class="panel-features">
      {PANEL_FEATURES.map((p) => (
        <li>
          <span class="panel-features__name"><a href={p.href}>{p.label}</a>{p.channel !== 'stable' && ' '}<ChannelBadge channel={p.channel} of={p.id} /></span>
          <span class="panel-features__about">{p.about}</span>
        </li>
      ))}
    </ul>
  </section>
</Docs>

<style>
  .panel-features {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--facet-color-line);
  }
  .panel-features li {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 2fr;
    align-items: baseline;
    column-gap: 24px;
    padding: 12px 0;
    border-bottom: 1px solid var(--facet-color-line);
  }
  .panel-features__name :global(.channel-badge) {
    margin-left: 8px;
    vertical-align: 1px;
  }
  .panel-features__about {
    color: var(--facet-color-text-dim);
  }
  @media (max-width: 640px) {
    .panel-features li {
      grid-template-columns: 1fr;
    }
  }
</style>
