---
// One page per screen, all generated (scripts/extract.mjs screenSet(): renderer/specs/*.json, the build's registered
// screens, renderer/sources/sources.json): a live preview on sample data (the real screen, drawn by the panel
// renderer), what it shows, its settings (the spec's typed parameters), its data sources, the parts it is built from,
// the screens it opens, its status.
import Docs, { type Heading } from '../../layouts/Docs.astro';
import Live from '../../components/Live.astro';
import PreviewBox from '../../components/PreviewBox.astro';
import { ALL, ALL_SCREENS, STATUS, href, screenById, screenGroupOf, screenHref, slug, SCREENS, type Screen } from '../../lib/data';

export function getStaticPaths() {
  return SCREENS.map((s) => ({ params: { id: slug(s.id) }, props: { s } }));
}
const { s } = Astro.props as { s: Screen };
const parts = s.parts.map((id) => ALL.find((e) => e.id === id)).filter((e) => !!e);
const link = (id: string) => screenById(id);
const sources = s.sources;
const typeWord = (p: Screen['params'][number]) =>
  p.options?.length ? 'pick one' : p.type === 'bool' || p.type === 'toggle' ? 'on / off' : p.type === 'entity' ? `one ${p.domain} entity` : p.type === 'entities' ? `a list of ${p.domain} entities` : p.type;
// the values a setting accepts, as written in a spec (null = free text / an entity id)
const valuesOf = (p: Screen['params'][number]): string[] | null =>
  p.options?.length ? p.options : p.type === 'bool' || p.type === 'toggle' ? ['true', 'false'] : null;
// description: the param's own about line when it has one (to come from the source), else its label
const aboutOf = (p: Screen['params'][number] & { about?: string }) => p.about || p.label;
const fill = (f: { param: string; domain: string; integration: string | null; list: boolean }) =>
  `${s.params.find((p) => p.name === f.param)?.label ?? f.param}: ${f.list ? 'every' : 'a'} ${f.domain.replace(/_/g, ' ')}${f.integration ? ` from ${f.integration.replace(/_/g, ' ')}` : ''}`;
const headings: Heading[] = [
  { depth: 2, slug: 'preview', text: 'Preview' },
  { depth: 2, slug: 'settings', text: 'Settings' },
  { depth: 2, slug: 'sources', text: 'Sources' },
  { depth: 2, slug: 'parts', text: 'Parts' },
  { depth: 2, slug: 'status', text: 'Status' },
];
const st = STATUS[s.status];
const DEMO_SETTINGS = 'Its Settings stick: theme, accent, sounds, sound pack and volume are the site\'s own settings too; text size, clock face, transitions, toasts and units apply to the demo. Idle, idle brightness, screen off and Allow AI agents only act on a real panel.';
// the demo runs as on a panel (Darren 2026-10-25): a spec screen is the root of a device stack (spec prop live), so
// its taps open the screens it leads to and Back returns; the root itself has no Back. Home and Settings = the Device component started on them.
const demo = s.comp === 'spec' ? { comp: 'spec', props: { ...s.sampleProps, live: true } }
  : s.comp === 'home' || s.comp === 'settings' ? { comp: 'device', props: { start: s.comp } } : { comp: s.comp, props: s.sampleProps };
---

<Docs title={s.name} description={s.about} group={`Screens · ${screenGroupOf(s.id)}`} current={screenHref(s)} headings={headings} source={s.source} wide>
  <div data-preview-scope>
    <h2 id="preview">Preview</h2>
    <PreviewBox />
    <Live comp={demo.comp} props={demo.props} label={`${s.name} screen`} frame={s.frame} caption={false} />
    <p class="hint">{s.opening ?? 'Sample data: made-up devices and values, not a real home.'} Tap it as on a panel; it keeps its place until you leave the page.</p>
    {demo.comp === 'device' && <p class="hint">{DEMO_SETTINGS}</p>}
  </div>

  <h2 id="settings">Settings</h2>
  {
    s.params.length ? (
      <>
        {s.kind === 'built' && <p>Options of this preview (the screen is built into the panel, not from a spec).</p>}
        <table>
          <thead><tr><th>Setting</th><th>Description</th><th>Values</th><th>Default</th></tr></thead>
          <tbody>
            {s.params.map((p) => (
              <tr>
                <td><code>{p.name}</code></td>
                <td>{aboutOf(p)} <span class="hint">({typeWord(p)})</span></td>
                <td>{valuesOf(p) ? valuesOf(p)!.map((v, i) => <>{i ? ' ' : ''}<code>{v}</code></>) : p.type === 'entity' || p.type === 'entities' ? <>an entity id, e.g. <code>{p.domain}.kitchen</code></> : 'any text'}</td>
                <td>{p.default === null ? 'found by discovery' : p.default === '' ? 'none' : <code>{String(p.default)}</code>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    ) : (
      <p class="hint">No settings: it works as it is.</p>
    )
  }

  <h2 id="sources">Sources</h2>
  {
    sources ? (
      <>
        <p>
          {sources.needs ? <>Needs {sources.needs}.</> : <>Works in every home.</>}
          {sources.from && link(sources.from) && <> Uses the <a href={screenHref(link(sources.from)!)}>{link(sources.from)!.name}</a> screen's source.</>}
          {' '}In order of preference:
        </p>
        <table>
          <thead><tr><th>Source</th><th>Kind</th><th>Needs first</th><th>Fills</th></tr></thead>
          <tbody>
            {sources.list.map((x) => (
              <tr>
                <td>{x.name}</td>
                <td>{x.kindLabel}</td>
                <td>{x.setup.length ? x.setup.join(', ') : 'nothing'}</td>
                <td>{x.fills.length ? x.fills.map(fill).join('; ') : 'the screen itself'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    ) : (
      <p class="hint">Built in: the panel works it out itself, no source to pick.</p>
    )
  }

  <h2 id="parts">Parts</h2>
  {parts.length ? <ul class="tags">{parts.map((p) => <li><a href={href(p)}>{p.name}</a></li>)}</ul> : <p class="hint">Drawn by the screen itself.</p>}
  {
    (s.opens.length > 0 || s.openedFrom.length > 0) && (
      <div class="cols">
        {s.opens.length > 0 && <div><h3 class="facet-label">Opens</h3><ul class="tags">{s.opens.map((id) => <li>{link(id) ? <a href={screenHref(link(id)!)}>{link(id)!.name}</a> : ALL_SCREENS.find((x) => x.id === id)?.name ?? id}</li>)}</ul></div>}
        {s.openedFrom.length > 0 && <div><h3 class="facet-label">Opened from</h3><ul class="tags">{s.openedFrom.map((id) => link(id) && <li><a href={screenHref(link(id)!)}>{link(id)!.name}</a></li>)}</ul></div>}
      </div>
    )
  }

  <h2 id="status">Status</h2>
  <p><span class={`status-badge status-badge--${s.status === 'done' ? 'done' : 'doing'}`}><span class="status-badge__dot" aria-hidden="true" />{st.label}</span> {st.hint}.</p>
</Docs>

