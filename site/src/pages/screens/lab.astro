---
// In the lab: screens being designed that are in no firmware yet (lib/lab.json; their code is on the wip branch), the
// stage before Coming soon and Beta. One card per screen with its pictures (public/lab/), its name, the In the lab
// badge, what it will show and a short note.
import Docs from '../../layouts/Docs.astro';
import { url } from '../../lib/nav';
import lab from '../../lib/lab.json';

// a picture's size at 720 (public/lab/<file>-720.png, lossless: also the README strip's source; <file>-360.webp is
// half of it), so a card's pictures share one height
const SIZE: Record<string, [number, number]> = {
  'f1-circuits': [720, 1264],
  'tennis-wimbledon': [600, 384],
};
const size = (f: string) => SIZE[f] ?? [720, 720];
---

<Docs
  edit="site/src/lib/lab.json"
  title="In the lab"
  description="Screens being designed. They aren't in any firmware yet and may change."
  group="Screens"
  current={url('/screens/lab/')}
  wide
>
  <p>
    Their code is on the <code>wip</code> branch. When one is ready it moves to the
    <a href={url('/screens/')}>screens</a> as <strong>Coming soon</strong>, then <strong>Beta</strong> on the beta
    firmware.
  </p>
  <ul class="lab">
    {lab.list.map((s) => (
      <li class:list={['lab__card', { 'lab__card--wide': s.pictures.length > 1 }]} id={s.id}>
        <div class="lab__pics">
          {s.pictures.map((p) => {
            const [w, h] = size(p.file);
            return (
              <a class="lab__pic" href={url(`/lab/${p.file}-720.png`)} style={`flex-grow:${(w / h).toFixed(3)}`}>
                <img
                  src={url(`/lab/${p.file}-360.webp`)}
                  srcset={`${url(`/lab/${p.file}-360.webp`)} ${w / 2}w, ${url(`/lab/${p.file}-720.png`)} ${w}w`}
                  sizes="(max-width: 640px) 100vw, 400px"
                  width={w / 2}
                  height={h / 2}
                  alt={p.alt}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            );
          })}
        </div>
        <span class="lab__name">{s.name} <span class="badge lab-badge" title="Being designed: in no firmware yet">In the lab</span></span>
        <span class="lab__about">{s.about}</span>
        {s.note && <span class="lab__note">{s.note}</span>}
      </li>
    ))}
  </ul>
</Docs>

<style>
  .lab {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 32px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lab__card {
    display: flex;
    flex-direction: column;
    margin: 0 !important;
    color: var(--facet-color-text-dim);
  }
  .lab__card--wide {
    grid-column: span 2;
  }
  .lab__pics {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .lab__pic {
    flex-basis: 0;
    min-width: 0;
    display: block;
    overflow: hidden;
    border: 1px solid var(--facet-color-line);
    border-radius: 16px;
    background: var(--facet-color-bg-565);
    transition: border-color var(--facet-duration-fade) var(--facet-easing-ease-out);
  }
  .lab__pic:hover {
    border-color: var(--facet-color-line-hi);
  }
  .lab__pic img {
    display: block;
    width: 100%;
    height: auto;
  }
  .lab__name {
    display: block;
    margin-top: 12px;
    color: var(--facet-color-text);
    font-size: 15px;
  }
  .lab__about {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    line-height: 1.4;
  }
  .lab__note {
    display: block;
    margin-top: 6px;
    color: var(--facet-color-text-mute);
    font-size: 12px;
    line-height: 1.4;
  }
  .lab-badge {
    margin-left: 6px;
    vertical-align: 1px;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--facet-color-line-hi);
  }
  @media (max-width: 560px) {
    .lab__card--wide {
      grid-column: auto;
    }
  }
</style>
