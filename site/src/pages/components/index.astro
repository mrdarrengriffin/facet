---
// The components overview, in the explorer layout: the filter sidebar and every component as a still picture (drawn
// by the WASM renderer, not interactive) that opens its page, where people try it.
import Base from '../../layouts/Base.astro';
import ComponentsSidebar from '../../components/ComponentsSidebar.astro';
import Live from '../../components/Live.astro';
import EditPage from '../../components/EditPage.astro';
import { COMPONENTS, componentGroups, defaults, href } from '../../lib/data';
---

<Base title="Components" description={`Every Facet component, live: the real renderer the panels run, with a playground for its props.`} hasSidebar>
  <div class="explorer">
    <ComponentsSidebar />
    <main class="explorer__main" id="main">
      <header class="explorer__head">
        <p class="facet-label">Components</p>
        <h1>Components</h1>
        <p class="lede">{COMPONENTS.length} components, each drawn by the same renderer the panels run. Open one to try it: change its props, tap it, hear it.</p>
      </header>
      {
        componentGroups().map((g) => (
          <section class="explorer__variants">
            <h2 class="facet-label">{g.label}</h2>
            <ul class="shots">
              {g.items.map((c) => (
                <li>
                  <a class="shot" href={href(c)}>
                    <span class="shot__viewport">
                      <Live comp={c.id} props={{ ...defaults(c.meta), ...(c.meta.variants?.[0]?.props ?? {}) }} label={c.name} frame={c.meta.frame} caption={false} still />
                    </span>
                    <span class="shot__name">{c.name}</span>
                    <span class="shot__about">{c.lede}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <footer class="docs__footer"><EditPage path="site/src/pages/components/index.astro" title="Components" /></footer>
    </main>
  </div>
  <script>
    import { initDocsNav } from '../../scripts/docs-nav';
    import { initFilter } from '../../scripts/playground';
    initDocsNav();
    initFilter();
  </script>
</Base>
