---
// Home page: what Facet is in one line, the panel (a render: the Device on Home inside a bezel, until a photo of a
// real panel replaces it), the shipped screens, set up in three steps, then the two panels and Install. No feature
// grid. Every screen here is a picture the WASM renderer made at build on sample data (scripts/shots.mjs); the panel's
// Try it loads the live one, so the page loads no WASM until asked.
import Base from '../layouts/Base.astro';
import Live from '../components/Live.astro';
import Shot from '../components/Shot.astro';
import Count from '../components/Count.astro';
import { SCREENS, screenById, screenHref } from '../lib/data';
import { BOARDS, screenOf } from '../lib/boards';
import { url } from '../lib/nav';

const description = 'Firmware for two 4 inch wall panels that shows and controls your home through Home Assistant.';
// the hero: a whole panel, a picture until Try it (sample data, no Home Assistant)
const hero = screenById('home');
// the shipped screens: every factory spec screen with a page, as a picture; its first sentence under it
const shipped = SCREENS.filter((s) => s.comp === 'spec' && s.status !== 'wip');
const first = (t: string) => t.split(/(?<=\.)\s/)[0];
---

<Base title="Facet" description={description}>
  <main id="main" class="landing">
    <section class="landing__hero">
      <div class="landing__intro">
        <h1 class="landing__title">Facet</h1>
        <p class="landing__lede">{description}</p>
        <p class="landing__intro-text">
          Install it from your browser, add the panel to Home Assistant, then arrange its screens on the panel's own web
          page. It runs on the Waveshare ESP32-P4-86 and the Guition ESP32-S3-4848S040.
        </p>
        <div class="landing__actions">
          <a class="button button--primary" href={url('/install/')}>Install</a>
          <a class="button button--secondary" href={url('/screens/')}>See the screens</a>
        </div>
      </div>

      {
        hero && (
          <figure class="landing__device" data-try-box>
            <div class="landing__bezel">
              <div class="landing__viewport">
                <div class="landing__shot" data-try-shot><Shot id="home" alt="The Facet panel on Home, with made-up devices" /></div>
                <template><Live comp="device" props={{ start: 'home' }} label="Facet panel" frame={hero.frame} caption={false} /></template>
              </div>
            </div>
            <figcaption>
              The panel on made-up devices.
              <button type="button" class="button button--secondary landing__try" data-try>Try it</button>
            </figcaption>
          </figure>
        )
      }
    </section>

    <section class="callout landing__status" aria-label="Project status">
      <span class="dot" aria-hidden="true"></span>
      <p><strong>Facet is new.</strong> Screens and settings still change between releases; <a href={url('/updates/')}>Updates</a> says what is next.</p>
    </section>

    <section class="landing__section" aria-labelledby="screens-title">
      <div class="landing__head">
        <h2 id="screens-title">The screens</h2>
        <p><Count k="screens" /> screens come with Facet, plus Home and Settings. Each one opens its page, where you can try it.</p>
      </div>
      <ul class="shots">
        {shipped.map((sc) => (
          <li>
            <a class="shot" href={screenHref(sc)}>
              <span class="shot__viewport">
                <Shot id={sc.id} kind="half" alt="" />
              </span>
              <span class="shot__name">{sc.name}</span>
              <span class="shot__about">{first(sc.about)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="landing__section" aria-labelledby="setup-title">
      <div class="landing__head">
        <h2 id="setup-title">Set up in three steps</h2>
      </div>
      <ol class="setup">
        <li>
          <h3><span class="build__n">1</span> Install</h3>
          <p>Plug the panel into a computer with a USB-C cable and install Facet from Chrome or Edge. No tools to download.</p>
        </li>
        <li>
          <h3><span class="build__n">2</span> Join Wi-Fi</h3>
          <p>Scan the code on the panel with your phone and pick your home network, or set it while the panel is still plugged in.</p>
        </li>
        <li>
          <h3><span class="build__n">3</span> Add to Home Assistant</h3>
          <p>Home Assistant finds the panel. Add it and allow it to perform actions, so its controls can switch your lights.</p>
        </li>
      </ol>
      <p class="landing__after">Then open the panel's address in a browser: its <a href={url('/editor/')}>editor</a> arranges Home's cards and the screens, and sets each one up.</p>
    </section>

    <section class="landing__section" aria-labelledby="buy-title">
      <div class="landing__head">
        <h2 id="buy-title">Two panels</h2>
        <p>Facet runs on these two 4 inch wall panels. <a href={url('/panels/')}>Panels</a> compares them, with the numbers measured on each.</p>
      </div>
      <ul class="buy">
        {BOARDS.map((b) => (
          <li>
            <h3>{b.name}</h3>
            <p>{screenOf(b)}, {b.chip}. {b.speaker ? 'Speaker for sounds.' : 'No speaker.'}</p>
          </li>
        ))}
      </ul>
      <a class="button button--primary" href={url('/install/')}>Install Facet</a>
    </section>
  </main>
</Base>

<style>
  .landing {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px 96px;
  }

  /* hero: text on the left, the device on the right; stacked on narrow screens */
  .landing__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 574px);
    gap: 64px;
    align-items: center;
    padding: 80px 0 64px;
  }
  .landing__title {
    margin: 0 0 16px;
    font-size: clamp(56px, 9vw, 96px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .landing__lede {
    max-width: 520px;
    margin: 0;
    color: var(--facet-color-text-dim);
    font-size: clamp(18px, 2.2vw, 20px);
    line-height: 1.5;
  }
  .landing__intro-text {
    max-width: 520px;
    margin: 16px 0 0;
    color: var(--facet-color-text-dim);
  }
  .landing__head > p {
    max-width: 640px;
  }
  .landing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .landing__device {
    margin: 0;
  }
  /* nested-radius rule: the screen inside the bezel = bezel radius - (padding + border) */
  .landing__bezel {
    --r-outer: 32px;
    --inset: calc(16px + 1px);
    padding: 16px; /* 16 + 1 border each side: a 574 px frame holds the 720 px panel at exactly 3/4 */
    border: 1px solid var(--facet-color-line);
    border-radius: 32px;
    background: var(--facet-color-surface);
  }
  .landing__viewport {
    position: relative;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: max(0px, calc(var(--r-outer) - var(--inset)));
    background: var(--facet-color-bg-565);
  }
  /* the live panel IS the screen: it fills it edge to edge (the panel UI has its own inset) */
  .landing__viewport :global(.live),
  .landing__viewport :global(.live__stage) {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }
  .landing__viewport :global(.live__canvas) {
    width: 100% !important;
    height: 100%;
    max-width: none;
  }
  .landing__device figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
    color: var(--facet-color-text-dim);
    font-size: 14px;
    text-align: center;
  }
  /* the picture IS the screen, as the live panel after Try it */
  .landing__shot,
  .landing__shot :global(.shot-img) {
    width: 100%;
    height: 100%;
  }

  .landing__status {
    max-width: 720px;
  }

  .landing__section {
    margin-top: 96px;
  }
  .landing__head {
    margin-bottom: 32px;
  }
  .landing__head h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .landing__head p {
    margin: 8px 0 0;
    color: var(--facet-color-text-dim);
  }

  /* components: still previews, five across (the old screens strip; .shot styles in site.css) */
  .landing__section .shots {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }


  /* previews: still PNGs from the WASM build, the site theme's version shown */
  :global(:root[data-theme='light']) .preview__img .for-dark,

  /* how it's built: three numbered steps */
  .build__n {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid var(--facet-color-line-hi);
    border-radius: 999px;
    color: var(--facet-color-text-dim);
    font: 500 13px/1 var(--mono);
  }

  .shot__about {
    color: var(--facet-color-text-dim);
    font-size: 14px;
    line-height: 20px;
  }

  /* set up: three numbered steps in a row */
  .setup {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .setup h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 500;
  }
  .setup p,
  .landing__after {
    margin: 0;
    color: var(--facet-color-text-dim);
  }
  .landing__after {
    margin-top: 32px;
  }

  /* the two panels, then Install */
  .buy {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
  }
  .buy h3 {
    margin: 0 0 4px;
    font-size: 18px;
    font-weight: 500;
  }
  .buy p {
    margin: 0;
    color: var(--facet-color-text-dim);
  }

  @media (max-width: 960px) {
    .landing__hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      padding-top: 56px;
    }
    .landing__device {
      max-width: 574px;
    }
    .landing__section .shots {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .landing {
      padding: 0 var(--gutter) 64px;
    }
    .landing__bezel {
      --r-outer: 24px;
      --inset: calc(8px + 1px);
      padding: 8px;
      border-radius: 24px;
    }
    .landing__section {
      margin-top: 64px;
    }
    .landing__section .shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 16px;
    }
    .setup,
    .buy {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
