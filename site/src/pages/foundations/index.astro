---
import Docs from '../../layouts/Docs.astro';
import { FOUNDATIONS, href } from '../../lib/data';
import { url } from '../../lib/nav';
---

<Docs
  title="Design system"
  description="The tokens and rules every component is built from. Each page is drawn by the panel renderer from the same token files the panels use; this site's colours and fonts come from them too."
  group="Design system"
  current={url('/foundations/')}
>
  <ul class="rows">
    {
      FOUNDATIONS.map((c) => (
        <li class="row">
          <a href={href(c)}>
            <span class="row__title">{c.name}</span>
            <span class="row__desc">{c.lede}</span>
            <span class="row__meta">{(c.meta.variants ?? []).map((v) => v.label).join(' · ')}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Docs>
