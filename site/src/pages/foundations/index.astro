---
import Base from '../../layouts/Base.astro';
import Lede from '../../components/Lede.astro';
import Status from '../../components/Status.astro';
import { BASE, FOUNDATIONS, href } from '../../lib/data';
---

<Base title="Foundations" current={`${BASE}foundations/`}>
  <header class="page-head">
    <p class="label">Foundations</p>
    <h1>Foundations</h1>
    <p class="lede">The tokens and rules every component is built from, each page drawn by the panel renderer from the same token files.</p>
  </header>
  <ul class="cards cards--text">
    {
      FOUNDATIONS.map((c) => (
        <li class="card">
          <a href={href(c)}>
            <span class="card__title">{c.name} <Status status={c.status} /></span>
            <Lede e={c} tag="span" />
            <span class="card__meta">{(c.meta.variants ?? []).map((v) => v.label).join(' · ')}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
