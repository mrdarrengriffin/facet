    background: var(--facet-color-surface-press);
  }
  .snd__play {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--facet-color-line);
    border-radius: 999px;
    background: var(--facet-color-bg);
    color: var(--facet-color-text-dim);
    cursor: pointer;
    transition:
      background var(--facet-duration-fade) var(--facet-easing-ease-out),
      color var(--facet-duration-fade) var(--facet-easing-ease-out);
  }
  .snd__play:hover {
    border-color: var(--facet-color-line-hi);
    color: var(--facet-color-text);
  }
  .snd__play.is-playing,
  .snd__pack.is-playing {
    border-color: var(--facet-color-accent);
    background: var(--accent-tint);
    color: var(--facet-color-accent-text);
  }
  .snd__hint {
    margin: 0;
    padding: 10px 16px 12px;
    border-top: 1px solid var(--facet-color-line);
    color: var(--facet-color-text-mute);
    font-size: 14px;
  }
  .snd-packs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 16px;
    margin: 24px 0;
  }
  .snd-pack {
    display: flex;
    flex-direction: column;
    padding: 18px 20px;
    border: 1px solid var(--facet-color-line);
    border-radius: 16px;
    background: var(--facet-color-surface);
  }
  .snd-pack__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .snd-pack__head .badge {
    margin-left: 0;
    background: var(--accent-tint);
    color: var(--facet-color-accent-text);
  }
  .snd-pack h3 {
    margin: 0;
  }
  .snd-pack p {
    margin: 0 0 12px;
    font-size: 15px;
  }
  .snd-pack .snd-pack__meta {
    margin: 4px 0 10px;
    color: var(--facet-color-text-mute);
    font-size: 13px;
  }
  .snd-pack__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .snd__play {
      transition: none;
    }
  }
</style>

<script>
  import { play, setVolume, SOUND_IDS, type SoundId } from '@facet/sounds';
  import * as S from '@facet/sounds';
  import * as F from '@facet/ui';
  import { TOASTS } from '@facet/demo-data';
  import {
    fitFrame,
    getSitePack,
    initSounds,
    onSitePackChange,
    setSitePack,
  } from '../../scripts/facet-runtime';

  initSounds({ defaultOn: true }); // this page is about sound: on unless the visitor turned it off
  const root = document.querySelector<HTMLElement>('[data-sounds]')!;
  const volume = root.querySelector<HTMLInputElement>('[data-volume]')!;
  setVolume(Number(volume.value) / 100);
  volume.addEventListener('input', () => setVolume(Number(volume.value) / 100));

  // one run at a time: a new run (or Stop) cancels the queued sounds of the previous one
  let run = 0;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const flash = (el: Element | null, ms = 220) => {
    if (!el) return;
    el.classList.add('is-playing');
    setTimeout(() => el.classList.remove('is-playing'), ms);
  };
  const cell = (pack: string, id: SoundId) =>
    root.querySelector(`[data-pack="${pack}"][data-sound="${id}"]`);

  async function playOne(pack: string, id: SoundId, token: number) {
    flash(cell(pack, id), id === 'slider-tick' ? 520 : 260);
    if (id !== 'slider-tick') return void play(id, { pack, always: true });
    // a short sweep: the pitch follows the value
    for (const value of [10, 25, 40, 55, 70, 85, 100]) {
      if (token !== run) return;
      void play('slider-tick', { pack, value, always: true });
      await wait(70);
    }
  }
  const gapAfter: Partial<Record<SoundId, number>> = {
    'slider-tick': 200,
    confirm: 750,
    'timer-done': 1300,
    notify: 900,
  };
  async function playSeq(pack: string, ids: readonly SoundId[]) {
    const token = ++run;
    for (const id of ids) {
      if (token !== run) return;
      await playOne(pack, id, token);
      await wait(gapAfter[id] ?? 420);
    }
  }

  root.addEventListener('click', (e) => {
    const t = e.target as Element;
    const b = t.closest<HTMLButtonElement>('[data-sound]');
    if (b) return void playOne(b.dataset.pack!, b.dataset.sound as SoundId, ++run);
    const head = t.closest<HTMLButtonElement>('[data-play-pack]');
    if (head) {
      flash(head, 1200);
      return void playSeq(head.dataset.playPack!, SOUND_IDS);
    }
    if (t.closest('[data-stop-all]')) run++;
  });

  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-sample]'))
    b.addEventListener('click', () =>
      playSeq(b.dataset.sample!, ['tap', 'toggle-on', 'toggle-off', 'open', 'confirm']),
    );

  const useButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-use-pack]')];
  const syncUse = () => {
    const current = getSitePack();
    for (const b of useButtons) {
      const on = b.dataset.usePack === current;
      b.setAttribute('aria-pressed', String(on));
      b.textContent = on ? 'Used on this site' : 'Use on this site';
    }
  };
  for (const b of useButtons)
    b.addEventListener('click', () => {
      setSitePack(b.dataset.usePack!);
      void play('confirm', { pack: b.dataset.usePack!, always: true });
    });
  onSitePackChange(syncUse);
  syncUse();

  // ---------------------------------------------------------------- Play with the UI
  {
    const box = document.querySelector<HTMLElement>('[data-play]')!;
    const stage = box.querySelector<HTMLElement>('[data-play-stage]')!;
    const group = (label: string, ...kids: Node[]) =>
      F.h(
        'div',
        { class: 'snd-play__group' },
        F.h('span', { class: 'snd-play__label' }, label),
        F.h('div', { class: 'snd-play__row' }, ...kids),
      );
    // big 720-geometry parts sit in a scaled frame (the dial and slider read their real size)
    const scaled = (w: number, hgt: number, k: number, child: Node) => {
      const frame = F.h(
        'div',
        { class: 'snd-play__frame', style: { width: `${w}px`, height: `${hgt}px` } },
        child,
      );
      const vp = F.h(
        'div',
        { class: 'snd-play__vp', style: { width: `${w * k}px`, height: `${hgt * k}px` } },
        frame,
      );
      requestAnimationFrame(() => fitFrame(vp, frame, w, hgt, k));
      return vp;
    };

    let playing = false;
    const play = F.iconButton({
      style: 'play',
      icon: 'play',
      title: 'Play / pause',
      onTap: () => {
        playing = !playing;
        F.setGlyph(play, playing ? 'pause' : 'play');
        F.setState(play, playing ? 'active' : 'default');
      },
    });
    const cb = F.checkbox({ state: 'open', label: 'Water the plants', onChange: () => {} }); // toggles itself
    const layer = F.toastLayer({ position: 'top', onShow: () => void S.play('notify') });
    let ti = 0;
    const toastFrame = F.h(
      'div',
      { class: 'snd-play__toasts' },
      F.h(
        'div',
        { class: 'snd-play__toast-btn' },
        F.button({
          kind: 'secondary',
          text: 'Send a toast',
          onTap: () => layer.push(TOASTS[ti++ % TOASTS.length]!),
        }),
      ),
      layer,
    );

    stage.append(
      group(
        'Buttons',
        F.button({ kind: 'primary', text: 'Start', onTap: () => {} }),
        F.button({ kind: 'secondary', text: 'Cancel', onTap: () => {} }),
        F.button({ kind: 'outline', text: 'Disabled', state: 'disabled' }),
      ),
      group(
        'Media',
        F.iconButton({ style: 'round', icon: 'prev', title: 'Previous', onTap: () => {} }),
        play,
        F.iconButton({ style: 'round', icon: 'next', title: 'Next', onTap: () => {} }),
      ),
      group('Slider', F.slider({ width: 320, value: 42 })),
      group('Checkbox', cb),
      group('Light dial', scaled(560, 560, 0.5, F.dial({ value: 64, on: true }))),
      group('Toasts', scaled(720, 400, 0.5, toastFrame)),
    );

    // pack: the site's pack (same as "Use on this site" above)
    const chips = [...box.querySelectorAll<HTMLButtonElement>('[data-play-pack]')];
    const showPack = (id: string) =>
      chips.forEach((c) => c.setAttribute('aria-checked', String(c.dataset.playPack === id)));
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        setSitePack(c.dataset.playPack!);
        showPack(c.dataset.playPack!);
        void S.play('tap', { always: true });
      }),
    );
    showPack(getSitePack());
    onSitePackChange(showPack);

    const sw = box.querySelector<HTMLButtonElement>('[data-play-sound]')!;
    const swLabel = sw.querySelector<HTMLElement>('[data-play-sound-label]')!;
    const showSound = () => {
      sw.setAttribute('aria-pressed', String(S.settings.enabled));
      swLabel.textContent = S.settings.enabled ? 'Sound on' : 'Sound off';
    };
    sw.addEventListener('click', () => S.setEnabled(!S.settings.enabled));
    S.onSettingsChange(showSound);
    showSound();
  }
</script>
