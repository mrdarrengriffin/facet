---
import Base from '../layouts/Base.astro';
import {
  color,
  font,
  layout,
  motion,
  radius,
  screenType,
  space,
  type,
  type ThemeName,
  type TypeStyle,
} from '@facet/tokens';
import '@facet/ui/styles.css';
import { url } from '../lib/nav';

const themes: ThemeName[] = ['dark', 'light'];
const colors = Object.entries(color);
const screenSample: Record<string, string> = {
  display: '21:47',
  hero: '3',
  value: '18°',
  headline: 'Paper Lanterns',
  title: 'Add a quiet hours schedule',
  body: 'Dry for the next hour',
  label: 'Study · 21:47',
};
const typeSample: Record<string, string> = {
  title: 'Desk lamp',
  'card-title': 'Weather',
  tile: 'Photo backup',
  body: 'Uses the solar noon from the table.',
  label: 'Start',
  'label-sm': 'Back',
  meta: 'done · 4h ago',
  'meta-sm': 'updated 2m',
  'caps-sm': 'ci pass',
  subtitle: 'The Quiet Hours',
  date: 'Mon 19 Oct',
  weather: 'Partly cloudy · 14°',
  number: '8.69',
};
const shownTypes = Object.entries(type).filter(
  ([name]) => !name.startsWith('clock') && name !== 'date-long' && name !== 'display',
);
const fontStack = (name: keyof typeof font) => `'${font[name].family}', ${font[name].fallback}`;
const styleOf = (s: TypeStyle) =>
  [
    `font-family:${fontStack(s.font)}`,
    `font-size:min(${s.size}px, ${(s.size / 6).toFixed(1)}vw + 12px)`,
    `font-weight:${s.weight}`,
    `line-height:${s.box ? 1.1 : s.lineHeight}`,
    `letter-spacing:${s.letterSpacing}px`,
    `text-transform:${s.case === 'upper' ? 'uppercase' : 'none'}`,
  ].join(';');
const spacing = Object.entries(space).filter(([, v]) => v > 0);
const layoutRows = [
  ['inset', layout.inset, 'every side of every screen'],
  ['gutter', layout.gutter, 'inside a group'],
  ['group', layout.group, 'between groups'],
  ['row', layout.row, 'the header row, at y 32'],
  ['top', layout.top, 'where content starts'],
] as const;
---

<Base
  title="Design system"
  description="The Facet design tokens: colour, type, layout, spacing, radius and motion, rendered from @facet/tokens."
>
  <main id="main" class="page page--wide ds">
    <header class="ds__intro">
      <p class="facet-label">Design system</p>
      <h1>Design system</h1>
      <p class="lede">
        Everything on this page is rendered from <code>@facet/tokens</code>: the same numbers the
        web components and the panel firmware use.
      </p>
    </header>

    <section class="ds__section" aria-labelledby="colour">
      <h2 id="colour">Colour</h2>
      <p>Every colour has a dark and a light value. Dark is the default on panels.</p>
      <div class="swatches">
        {
          colors.map(([name, value]) => (
            <div class="swatch">
              <div class="swatch__chips">
                {themes.map((theme) => (
                  <div
                    class="swatch__chip"
                    style={`background:${value[theme]}`}
                    title={`${theme}: ${value[theme]}`}
                  />
                ))}
              </div>
              <div class="swatch__meta">
                <code>{name}</code>
                <span class="swatch__values">
                  {value.dark} · {value.light}
                </span>
                <span class="swatch__use">{value.use}</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="ds__section" aria-labelledby="type">
      <h2 id="type">Type</h2>
      <p>
        {font.sans.family} for words and numbers, {font.mono.family} for labels. Each screen has one hero
        in a large, light weight; everything else stays quiet, and hierarchy comes from colour rather
        than size. Sizes are at the 720 × 720 reference panel. Every style has a line box that's a multiple
        of 8, so text sits on the grid.
      </p>
      <h3>Screen scale</h3>
      <p>Classes <code>.fst-&lt;role&gt;</code>.</p>
      <div class="type-scale">
        {
          Object.entries(screenType).map(([name, style]) => (
            <div class="type-row">
              <div class="type-row__meta">
                <code>{name}</code>
                <span>
                  {style.size}/{style.weight} · {font[style.font].family} · box {style.box}
                </span>
              </div>
              <div class="type-row__sample" style={styleOf(style)}>
                {screenSample[name] ?? name}
              </div>
            </div>
          ))
        }
      </div>
      <h3>Component scale</h3>
      <p>
        Smaller text used inside components: lists, chips, the dial, clocks. Classes <code
          >.ft-&lt;name&gt;</code
        >.
      </p>
      <div class="type-scale">
        {
          shownTypes.map(([name, style]) => (
            <div class="type-row">
              <div class="type-row__meta">
                <code>{name}</code>
                <span>
                  {style.size}/{style.weight} · {font[style.font].family}
                  {style.box ? ` · box ${style.box}` : ''}
                </span>
              </div>
              <div class="type-row__sample" style={styleOf(style)}>
                {typeSample[name] ?? name}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="ds__section" aria-labelledby="layout">
      <h2 id="layout">Layout</h2>
      <p>
        An 8 px grid: every x, y, width and height on a screen is a multiple of 8. One inset on all
        four sides, more space between groups than inside them, and rows separated by hairlines
        rather than boxes.
      </p>
      <div class="space-scale">
        {
          layoutRows.map(([name, value, what]) => (
            <div class="space-row">
              <code>layout.{name}</code>
              <span class="space-row__value">{value}px</span>
              <span class="space-row__bar" style={`width:${Math.min(value * 2, 240)}px`} />
              <span class="space-row__what">{what}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="ds__section" aria-labelledby="space">
      <h2 id="space">Spacing</h2>
      <p>Spacing steps inside components.</p>
      <div class="space-scale">
        {
          spacing.map(([name, value]) => (
            <div class="space-row">
              <code>space.{name}</code>
              <span class="space-row__value">{value}px</span>
              <span class="space-row__bar" style={`width:${value * 4}px`} />
            </div>
          ))
        }
      </div>
    </section>

    <section class="ds__section" aria-labelledby="radius">
      <h2 id="radius">Radius</h2>
      <div class="radius-scale">
        {
          Object.entries(radius).map(([name, value]) => (
            <div class="radius-item">
              <div class="radius-item__box" style={`border-radius:${Math.min(value, 48)}px`} />
              <code>{name}</code>
              <span>{value}px</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="ds__section" aria-labelledby="motion">
      <h2 id="motion">Motion</h2>
      <p>Animate opacity and transform on small things only, so it works on the panels too.</p>
      <div class="motion-grid">
        {
          Object.entries(motion.duration)
            .filter(([, v]) => v <= 1000)
            .map(([name, value]) => (
              <div class="motion-item">
                <code>duration.{name}</code>
                <span>{value} ms</span>
              </div>
            ))
        }
        {
          Object.entries(motion.easing).map(([name, value]) => (
            <div class="motion-item">
              <code>easing.{name}</code>
              <span>{value.css}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="ds__section" aria-labelledby="components">
      <h2 id="components">Components</h2>
      <p>
        Every component and screen is in <code>@facet/ui</code>, plain TypeScript with no framework.
        Try them live, with controls for their props, in the <a href={url('/components/')}
          >UI explorer</a
        >, or see the whole thing running in the <a href={url('/demo/')}>demo</a>.
      </p>
    </section>
  </main>
</Base>
