---
// Updates: Facet's story as a timeline on one page, newest first (Darren 2026-10-22): milestones and visible changes,
// each a title, date + time, a few sentences, an optional picture or before / after pair and links. Entries come from
// src/content/updates/*.md (format: README there). "On this page" lists them by day.
import { getCollection, render } from 'astro:content';
import Docs, { type Heading } from '../layouts/Docs.astro';
import { UPDATES_PAGE, url } from '../lib/nav';
import { linkShown, updateShown } from '../lib/data';

// the route exists only while the Updates page is on (lib/nav.ts UPDATES_PAGE)
export function getStaticPaths() {
  return UPDATES_PAGE ? [{ params: { updates: 'updates' } }] : [];
}

const all = (await getCollection('updates')).filter(updateShown).sort((a, b) =>
  `${b.data.date} ${b.data.time ?? '00:00'}`.localeCompare(`${a.data.date} ${a.data.time ?? '00:00'}`),
);
const entries = await Promise.all(all.map(async (e) => ({ e, Content: (await render(e)).Content })));
const days = [...new Set(entries.map((x) => x.e.data.date))].map((d) => ({ d, items: entries.filter((x) => x.e.data.date === d) }));
const dayLabel = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const shortDay = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const headings: Heading[] = days.flatMap(({ d, items }) => [
  { depth: 2 as const, slug: `day-${d}`, text: dayLabel(d) },
  ...items.map(({ e }) => ({ depth: 3 as const, slug: e.id, text: e.data.title })),
]);
// kinds in filter order (README); an entry without one falls back to its old area
const ORDER = ['New screen', 'New feature', 'New component', 'Improved', 'Fixed', 'Design system', 'Docs', 'Story', 'Behind the scenes'];
const kindOf = (e: (typeof all)[number]) => e.data.kind ?? e.data.area ?? 'Story';
const kinds = [...new Set(all.map(kindOf))].sort((a, b) => (ORDER.indexOf(a) + 99) % 99 - (ORDER.indexOf(b) + 99) % 99);
const pic = (f: string) => url(`/updates/${f}`);
const link = (p: string) => (/^https?:/.test(p) ? p : url(`/${p}`));
---

<Docs title="Updates" description="What's new in Facet, newest first, and how it came to be." group="Project" current={url('/updates/')} headings={headings}>
  <div class="updates__filter" role="group" aria-label="Show">
    <button type="button" class="updates__chip" aria-pressed="true" data-kind="">All</button>
    {kinds.map((k) => <button type="button" class="updates__chip" aria-pressed="false" data-kind={k}>{k}</button>)}
  </div>
  {
    days.map(({ d, items }) => (
      <section class="updates__day">
        <h2 id={`day-${d}`} class="updates__date">{dayLabel(d)}</h2>
        <ol class="progress">
          {items.map(({ e, Content }) => (
            <li class={e.data.milestone ? 'progress__entry progress__entry--milestone' : 'progress__entry'} data-kind={kindOf(e)}>
              <p class="facet-label updates__meta">
                <span class="updates__kind">{e.data.milestone && <span class="progress__mark" aria-hidden="true" />}{kindOf(e)}</span>
                {shortDay(e.data.date)}{e.data.time && <> · {e.data.time}</>}
              </p>
              <h3 id={e.id}>{e.data.title}</h3>
              <Content />
              {e.data.before && e.data.after && (
                <div class="progress__shots">
                  <figure><img src={pic(e.data.before)} alt={`${e.data.alt ?? e.data.title}: before`} loading="lazy" /><figcaption>Before</figcaption></figure>
                  <figure><img src={pic(e.data.after)} alt={`${e.data.alt ?? e.data.title}: after`} loading="lazy" /><figcaption>After</figcaption></figure>
                </div>
              )}
              {e.data.image && (
                <div class="progress__shots progress__shots--one">
                  <figure><img src={pic(e.data.image)} alt={e.data.alt ?? e.data.title} loading="lazy" /></figure>
                </div>
              )}
              {e.data.links.filter(linkShown).length > 0 && (
                <p class="progress__links">
                  {e.data.links.filter(linkShown).map(([label, path], i) => <>{i > 0 && ' · '}<a href={link(path)}>{label}</a></>)}
                </p>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Docs>

<script>
  // filter row: one kind at a time (All = every entry); days left empty hide with their heading
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.updates__chip')];
  for (const c of chips)
    c.addEventListener('click', () => {
      const k = c.dataset.kind ?? '';
      for (const o of chips) o.setAttribute('aria-pressed', String(o === c));
      for (const li of document.querySelectorAll<HTMLElement>('.progress__entry')) li.hidden = !!k && li.dataset.kind !== k;
      for (const d of document.querySelectorAll<HTMLElement>('.updates__day')) d.hidden = !d.querySelector('.progress__entry:not([hidden])');
    });
</script>
