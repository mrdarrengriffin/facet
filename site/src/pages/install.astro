---
// Install: flash Facet onto a panel from the browser (ESP Web Tools over Web Serial), then set up Wi-Fi with Improv
// serial and add the panel to Home Assistant. Design: the firmware's install + onboarding notes (public build, two
// boards). Each board's ESP Web Tools manifest + factory image live under /firmware/<board>/ next to the site (the
// release workflow publishes them there; a local build copies them into public/firmware/, untracked), so the page
// only names the manifest URL.
import Docs, { type Heading } from '../layouts/Docs.astro';
import { url } from '../lib/nav';

import { BOARDS, screenOf, wifiWays } from '../lib/boards';
const boards = BOARDS.map((b) => ({
  id: b.id,
  name: b.name,
  about: `${screenOf(b)}, ${b.chip}${b.radio ? ` with an ${b.radio} for Wi-Fi and Bluetooth` : ''}.`,
  ways: wifiWays(b),
}));
const headings: Heading[] = [
  { depth: 2, slug: 'before', text: 'Before you start' },
  { depth: 2, slug: 'install', text: 'Install' },
  { depth: 2, slug: 'wifi', text: 'Wi-Fi' },
  { depth: 2, slug: 'home-assistant', text: 'Home Assistant' },
  { depth: 2, slug: 'link', text: 'The panel\'s own link' },
  { depth: 2, slug: 'updates', text: 'Updates' },
];
const manifest = (id: string) => url(`/firmware/${id}/manifest.json`);
---

<Docs edit="site/src/pages/install.astro" title="Install" description="Put Facet on your panel from the browser, connect it to Wi-Fi and add it to Home Assistant." group="Use Facet" current={url('/install/')} headings={headings}>
  <p class="lede">Put Facet on your panel from this page, connect it to Wi-Fi and add it to Home Assistant. No tools to install.</p>

  <div class="callout callout--warn">
    <span class="dot" aria-hidden="true"></span>
    <p>Pre-release firmware. Installing replaces what is on the panel now.</p>
  </div>

  <h2 id="before">Before you start</h2>
  <ul>
    <li>One of the <a href={url('/panels/')}>panels</a> Facet runs on so far.</li>
    <li>A computer with <strong>Chrome or Edge</strong>. Flashing uses Web Serial, which other browsers (and phones) do not have.</li>
    <li>A USB-C cable that carries data, not only power.</li>
    <li>Home Assistant with the ESPHome integration (it is built in).</li>
  </ul>

  <h2 id="install">Install</h2>
  <ol>
    <li>Pick your panel.</li>
    <li>Plug it into the computer and press <strong>Install</strong>, then choose its USB port.</li>
    <li>For a first install, say yes to <strong>erase the device</strong>. Flashing takes a minute or two; leave the cable in.</li>
  </ol>

  <fieldset class="boards" data-boards>
    <legend class="facet-label">Your panel</legend>
    {
      boards.map((b, i) => (
        <label class="board">
          <input type="radio" name="board" value={b.id} data-manifest={manifest(b.id)} checked={i === 0} />
          <span class="board__name">{b.name}</span>
          <span class="board__about">{b.about}</span>
          <span class="board__ways">Set up with {b.ways}</span>
        </label>
      ))
    }
  </fieldset>

  <fieldset class="boards channels" data-channels hidden>
    <legend class="facet-label">Release</legend>
    <label class="board">
      <input type="radio" name="channel" value="stable" checked />
      <span class="board__name">Stable</span>
      <span class="board__about">The release we recommend. Updates when a new version is ready.</span>
    </label>
    <label class="board">
      <input type="radio" name="channel" value="beta" />
      <span class="board__name">Beta</span>
      <span class="board__about">Newer builds, more often, that may have rough edges. Switch back in the panel's Settings, Update channel.</span>
      <span class="board__ways" data-beta-version></span>
    </label>
  </fieldset>
  <div class="install">
    <esp-web-install-button manifest={manifest(boards[0].id)} data-install>
      <button slot="activate" class="button button--primary" type="button">Install</button>
      <p slot="unsupported" class="callout callout--warn">
        <span class="dot" aria-hidden="true"></span>
        This browser cannot flash over USB. Open this page in Chrome or Edge on a computer.
      </p>
      <p slot="not-allowed" class="callout callout--warn">
        <span class="dot" aria-hidden="true"></span>
        Flashing needs a secure page (https).
      </p>
    </esp-web-install-button>
  </div>

  <h2 id="wifi">Wi-Fi</h2>
  <p>Pick one of these. The panel remembers the network.</p>
  <ul>
    <li>
      <strong>Right after installing</strong>: the installer offers <strong>Connect to Wi-Fi</strong>. Pick your network
      and type its password; the panel joins while it is still plugged in.
    </li>
    <li>
      <strong>From your phone</strong>: with no Wi-Fi set, the panel starts its own hotspot, named
      <code>Facet-</code> and four letters or digits. It has a password of its own, made by the panel on its first
      start and kept until the next install with erase. Scan the code on the panel to join, then pick your home
      network on the page that opens (if it does not, go to <code>192.168.4.1</code>).
    </li>
    <li>
      <strong>Bluetooth</strong> (Waveshare only): the Home Assistant app finds the panel and asks for your Wi-Fi.
    </li>
  </ul>
  <p class="hint">
    The panel's set up screen shows the hotspot and a code to scan. If you need the name and password in text, they are in the panel's log too:
    press Install again, choose <strong>Logs &amp; console</strong>, then <strong>Reset device</strong>; the line
    starts with <code>hotspot Facet-</code>.
  </p>

  <h2 id="home-assistant">Home Assistant</h2>
  <ol>
    <li>Once the panel is on your Wi-Fi, Home Assistant shows it under <strong>Settings &gt; Devices &amp; services</strong> as a discovered ESPHome device, named <strong>Facet panel</strong> and the end of its address. Press <strong>Add</strong>.</li>
    <li>Home Assistant gives the panel its own encryption key while adding it; there is nothing to copy.</li>
    <li>
      Open the new device, press <strong>Configure</strong> and turn on <strong>Allow the device to perform Home Assistant
      actions</strong>, so the panel can switch lights and control media players.
    </li>
  </ol>

  <h2 id="link">The panel's own link</h2>
  <p>
    When you choose a light or a sensor for a screen, the panel reads the list from Home Assistant itself, with an
    address and a token of its own. After it is added, Set up shows a code to its link page; it is also on the panel
    under <strong>Settings &gt; Home Assistant</strong> while the panel is not linked.
  </p>
  <ol>
    <li>In Home Assistant, <strong>Settings &gt; People &gt; Users</strong>: add a user for this panel, not an administrator.</li>
    <li>Scan the code on the panel, or open <code>http://&lt;the panel's address&gt;/link</code>, in a browser where you are signed in to Home Assistant as that user (a private window is easiest).</li>
    <li>Press <strong>Create a token</strong>: it opens that user's profile. Create a long-lived token there, copy it, and paste it into the link page. The address is filled in when the panel can see <code>homeassistant.local</code>; otherwise type yours. Press <strong>Link</strong>.</li>
  </ol>
  <p>
    The page says <strong>Linked</strong> when the panel has checked the address and token, or why not. The panel keeps
    them when it restarts and never shows the token back. If the link page does not open, see
    <a href={url('/help/troubleshooting/#link')}>Troubleshooting</a>.
  </p>
  <div class="page-shots">
    <figure><img src={url('/install/link-qr.png')} width="720" height="720" alt="The panel's Settings, Home Assistant screen while it is not linked: the link page's address and its QR code." loading="lazy" /><figcaption>On the panel, while it is not linked</figcaption></figure>
    <figure><img src={url('/install/link-page.png')} width="390" height="780" alt="The link page on a phone: Linked, homeassistant.local, the address and token fields and the Link button." loading="lazy" /><figcaption>The link page on a phone</figcaption></figure>
  </div>

  <h2 id="updates">Updates</h2>
  <p>
    Home Assistant shows a <strong>Firmware</strong> update on the panel's device page when a new Facet release is out.
    It installs only when you press Install. Installing from this page again works too, without erasing.
    <a href={url('/help/troubleshooting/')}>Updating and troubleshooting</a> has more, and fixes for common set up problems.
  </p>
</Docs>

<script is:inline type="module" src="https://unpkg.com/esp-web-tools@10.4.0/dist/web/install-button.js?module"></script>
<script>
  // the board pick and the release channel set the installer's manifest: manifest.json (stable) or manifest-beta.json
  // beside it (the beta channel, .github/workflows/release.yml); the channel choice shows only while a beta exists
  const button = document.querySelector<HTMLElement>('[data-install]');
  const channels = document.querySelector<HTMLElement>('[data-channels]');
  const pick = () => {
    const b = document.querySelector<HTMLInputElement>('[data-boards] input[name="board"]:checked');
    const beta = document.querySelector<HTMLInputElement>('[data-channels] input[value="beta"]')?.checked;
    if (button && b?.dataset.manifest) button.setAttribute('manifest', beta ? b.dataset.manifest.replace(/manifest\.json$/, 'manifest-beta.json') : b.dataset.manifest);
  };
  document.querySelectorAll<HTMLInputElement>('[data-boards] input, [data-channels] input').forEach((r) => r.addEventListener('change', pick));
  const first = document.querySelector<HTMLInputElement>('[data-boards] input[name="board"]')?.dataset.manifest;
  if (first && channels)
    fetch(first.replace(/manifest\.json$/, 'manifest-beta.json'), { cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : null))
      .then((m) => {
        if (!m) return;
        channels.hidden = false;
        const v = document.querySelector('[data-beta-version]');
        if (v && m.version) v.textContent = `Now ${m.version}`;
      })
      .catch(() => {});

  // Plausible "Install" event (the stub is in Base.astro). ESP Web Tools fires no DOM event for install progress:
  // its dialog keeps it in the reactive property _installState, which flash() sets (initializing ... finished/error).
  // Wrap that property's setter on the dialog class, so every dialog reports: start (install confirmed, first state),
  // success / failure once each, cancel when the dialog closes mid-install. reason = ESP Web Tools' error code only.
  type Flash = { state: string; manifest?: { version?: string }; details?: { error?: string } } | undefined;
  type Attempt = { phase: 'started' | 'done'; props: Record<string, string> };
  const attempts = new WeakMap<HTMLElement, Attempt>();
  const send = (props: Record<string, string>) => {
    const p = (window as any).plausible;
    if (typeof p === 'function') p('Install', { props });
  };
  const target = (dialog: any) => {
    // the manifest URL the dialog installs from: /firmware/<board>/manifest(-beta).json
    const m = /\/firmware\/([^/]+)\/manifest(-beta)?\.json/.exec(String(dialog.manifestPath || ''));
    return { board: m?.[1] || 'unknown', channel: m?.[2] ? 'beta' : 'stable' };
  };
  const onState = (dialog: any, s: Flash) => {
    let a = attempts.get(dialog);
    if (!s) {
      if (a?.phase === 'done') attempts.delete(dialog); // a new attempt (install again)
      return;
    }
    if (!a) {
      a = { phase: 'started', props: { ...target(dialog), version: s.manifest?.version || dialog._manifest?.version || 'unknown' } };
      attempts.set(dialog, a);
      send({ stage: 'start', ...a.props });
    }
    if (a.phase !== 'started') return;
    if (s.state === 'finished') {
      a.phase = 'done';
      send({ stage: 'success', ...a.props });
    } else if (s.state === 'error') {
      a.phase = 'done';
      const reason = s.details?.error;
      send({ stage: 'failure', ...a.props, ...(reason && /^[a-z_]{1,40}$/.test(reason) ? { reason } : {}) });
    }
  };
  customElements.whenDefined('ewt-install-dialog').then((Dialog) => {
    const proto = Dialog.prototype;
    const d = Object.getOwnPropertyDescriptor(proto, '_installState');
    if (!d?.set || !d.get) return;
    Object.defineProperty(proto, '_installState', {
      ...d,
      get() { return d.get!.call(this); },
      set(v: Flash) {
        d.set!.call(this, v);
        try { onState(this, v); } catch {}
      },
    });
  });
  document.addEventListener('closed', (e) => {
    const dialog = e.target as HTMLElement;
    if (dialog?.localName !== 'ewt-install-dialog') return;
    const a = attempts.get(dialog);
    if (a?.phase === 'started') {
      a.phase = 'done';
      send({ stage: 'cancel', ...a.props });
    }
  });
</script>

<style>
  .boards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin: 24px 0;
    padding: 0;
    border: 0;
  }
  .channels[hidden] {
    display: none;
  }
  .boards legend {
    margin-bottom: 12px;
  }
  .board {
    display: grid;
    gap: 4px;
    padding: 16px 20px;
    border: 1px solid var(--facet-color-line);
    border-radius: 12px;
    background: var(--facet-color-surface);
    cursor: pointer;
  }
  .board:has(input:checked) {
    border-color: var(--facet-color-accent);
  }
  .board:has(input:focus-visible) {
    outline: 2px solid var(--facet-color-accent);
    outline-offset: 2px;
  }
  .board input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .board__name {
    font-weight: 600;
  }
  .board__about,
  .board__ways {
    color: var(--facet-color-text-dim);
    font-size: 0.92em;
  }
  .install {
    margin: 8px 0 32px;
  }
</style>
