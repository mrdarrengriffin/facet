---
// Every page, from the original Facet site (main a5df2ac: site/src/layouts/Base.astro): head (favicons, social card, theme
// before first paint), header, the search dialog. Colours, type, space and motion = the WASM tokens (data/tokens.css,
// generated from renderer/tokens/*.json by scripts/extract.mjs; sizes are the old site's own). Prefs (theme, sound, panel size, accent, pack) are
// one object in localStorage, mirrored on <html data-*> (scripts/prefs.ts).
import '@fontsource/inter/200.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../data/tokens.css';
import '../styles/global.css';
import '../styles/live.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Search from '../components/Search.astro';
import { ACCENTS, BASE, SOUND, TOKENS } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  hasSidebar?: boolean;
  /** Keep the page out of search engines (test pages). */
  noindex?: boolean;
}

const {
  title,
  description = 'Wall panel UI for Home Assistant: one design system for ESP32 touch panels, drawn by the same renderer the panels run.',
  hasSidebar = false,
  noindex = false,
} = Astro.props;
const pageTitle = title === 'Facet' ? 'Facet' : `${title} · Facet`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(`${BASE}social-card.png`, Astro.site).href;
const bg = (TOKENS.colour as { colours: Record<string, { dark: string; light: string }> }).colours.bg;
---

<!doctype html>
<html lang="en" data-accent-default={ACCENTS.default} data-pack-default={SOUND.default}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${BASE}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="icon" href={`${BASE}favicon-16.png`} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={`${BASE}apple-touch-icon.png`} />
    <link rel="manifest" href={`${BASE}manifest.webmanifest`} />
    <meta name="theme-color" content={bg.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={bg.dark} media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // prefs before first paint (no theme flash): stored > system theme; panel 720; accent + pack = the defaults
      (function () {
        var r = document.documentElement, p = {};
        try { p = JSON.parse(localStorage.getItem('facet-docs-prefs') || '{}') || {}; } catch (e) {}
        r.dataset.theme = p.theme === 'light' || p.theme === 'dark' ? p.theme : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        r.dataset.device = String(p.device || 720);
        r.dataset.accent = p.accent || r.dataset.accentDefault;
        r.dataset.sound = p.sound === false ? 'off' : 'on';
        r.dataset.pack = p.pack || r.dataset.packDefault;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header hasSidebar={hasSidebar} />
    <slot />
    <Search />
    <script is:inline>
      // sidebar keeps its scroll across page loads (Darren 2026-10-23: a click lost his place); per sidebar kind
      (function () {
        var s = document.querySelector('[data-sidebar]');
        if (!s) return;
        var k = 'facet-sidebar-scroll:' + (s.classList.contains('explorer__sidebar') ? 'components' : 'docs');
        try { var y = sessionStorage.getItem(k); if (y !== null) s.scrollTop = +y; } catch (e) {}
        var a = s.querySelector('[aria-current="page"]');
        if (a) { var r = a.getBoundingClientRect(), b = s.getBoundingClientRect(); if (r.top < b.top || r.bottom > b.bottom) a.scrollIntoView({ block: 'nearest' }); }
        var save = function () { try { sessionStorage.setItem(k, String(s.scrollTop)); } catch (e) {} };
        s.addEventListener('click', save, true);
        addEventListener('pagehide', save);
      })();
    </script>
    <script>
      import { initPrefs } from '../scripts/prefs';
      import { initLive } from '../scripts/live';
      import { initSound } from '../scripts/sound';
      import { initSelects } from '../scripts/fselect';
      initPrefs();
      initSelects();
      initSound();
      initLive();
    </script>
  </body>
</html>
