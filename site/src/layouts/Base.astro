---
import '@fontsource/inter/200.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/200.css';
import '@fontsource/jetbrains-mono/300.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@facet/tokens/tokens.css';
import '@facet/ui/checkbox.css';
import '../styles/global.css';
import '../styles/live.css';
import Header from '../components/Header.astro';
import Search from '../components/Search.astro';
import { url } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  hasSidebar?: boolean;
}

const { title, description, hasSidebar = false } = Astro.props;
const pageTitle = title === 'Facet' ? 'Facet' : `${title} · Facet`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(url('/social-card.png'), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={url('/favicon-16.png')} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="theme-color" content="#F4F2EE" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // Set the theme before first paint so there's no flash.
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('facet-theme');
        } catch {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.facetTheme = theme;
      })();
    </script>
    <!-- Plausible analytics (self-hosted, cookieless) -->
    <script defer data-domain="mrdarrengriffin.github.io" src="https://plausible.mrdarrengriffin.com/js/script.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header hasSidebar={hasSidebar} />
    <slot />
    <Search />
    <script>
      import { initTheme } from '../scripts/theme';
      initTheme();
    </script>
  </body>
</html>
