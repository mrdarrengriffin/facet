---
// A live preview of one Facet screen on the mock house. Interactive, but there's no back button and Home cards don't
// navigate: it's one screen. Follows the site theme unless overridden.
import '@facet/icons/weather.css';
import '@facet/ui/styles.css';
import ThemeSwitch from './ThemeSwitch.astro';
import SoundToggle from './SoundToggle.astro';
import { TOASTS } from '@facet/demo-data';
import { CLOCK_FACES } from '@facet/ui';

interface Props {
  /** Screen id, or `toasts` for the toast layer over Home. */
  screen: string;
  title: string;
}
const { screen, title } = Astro.props;
---

<figure class="preview" data-preview={screen}>
  <div class="preview__bar">
    <span class="facet-label">Live preview</span>
    <span class="preview__spacer"></span>
    <SoundToggle />
    <ThemeSwitch />
  </div>
  {
    screen === 'clock' && (
      <div class="preview__bar preview__bar--options" role="group" aria-label="Clock face">
        {CLOCK_FACES.map((f, i) => (
          <button
            type="button"
            class="chip-button"
            data-face={f.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            title={f.what}
          >
            {f.name}
          </button>
        ))}
      </div>
    )
  }
  {
    screen === 'toasts' && (
      <div class="preview__bar preview__bar--options" role="group" aria-label="Send a toast">
        {TOASTS.map((t) => (
          <button type="button" class="chip-button" data-toast={t.key}>
            {t.name}
          </button>
        ))}
      </div>
    )
  }
  <div class="preview__viewport" data-viewport>
    <div class="preview__frame" data-frame aria-label={`${title} screen, live`}></div>
  </div>
  <figcaption class="preview__caption">
    Running on the mock house from <code>@facet/demo-data</code>. Tap, drag and scroll as you would
    on a panel.
  </figcaption>
</figure>

<script>
  import { initScreenPreviews } from '../../scripts/screen-preview';
  initScreenPreviews();
</script>
