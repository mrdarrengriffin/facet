---
// Turns Facet's UI sounds on or off for the whole site (remembered in this browser).
---

<button class="chip-button" type="button" data-sound-toggle aria-pressed="false">
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
    ><path
      d="M4 9 L8 9 L13 5 L13 19 L8 15 L4 15 Z M16.5 9 A4 4 0 0 1 16.5 15 M19 6.5 A7.5 7.5 0 0 1 19 17.5"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path></svg
  >
  <span data-sound-label>Sound off</span>
</button>
