---
// The original Facet site's header (main a5df2ac site/src/components/Header.astro); new: the links, the settings
// popover (accent + sound pack).
import Logo from './Logo.astro';
import SiteSettings from './SiteSettings.astro';
import { getSidebar, headerLinks, url } from '../lib/nav';

interface Props {
  /** kept for the layouts; the mobile menu now shows on every page */
  hasSidebar?: boolean;
}
const path = Astro.url.pathname;

const links = headerLinks;
const sections = getSidebar();
const here = (href: string) => href.replace(/\/?$/, '/') === path.replace(/\/?$/, '/');
---

<header class="header">
  <div class="header__inner">
    <button
      class="icon-button header__menu"
      type="button"
      aria-label="Open menu"
      aria-haspopup="dialog"
      aria-controls="mmenu"
      aria-expanded="false"
      data-menu-open
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
      </svg>
    </button>
    <a class="header__brand" href={url('/')}>
      <Logo />
      <span>Facet</span>
    </a>
    <nav class="header__nav" aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.match.some((m) => path.startsWith(m)) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="header__actions">
      <button class="search-button" type="button" data-search-open aria-label="Search the docs">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.5" fill="none"
          ></circle>
          <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
          ></path>
        </svg>
        <span class="search-button__label">Search</span>
        <kbd>/</kbd>
      </button>
      <SiteSettings />
      <button class="icon-button" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <svg
          class="theme-icon theme-icon--sun"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" fill="none"
          ></circle>
          <path
            d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
        <svg
          class="theme-icon theme-icon--moon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
        >
          <path
            d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <a
        class="icon-button header__support"
        href="https://buymeacoffee.com/mrdarrengriffin"
        aria-label="Support Facet"
        title="Support Facet"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M12 20s-7.5-4.6-7.5-10A4.5 4.5 0 0 1 12 7.1 4.5 4.5 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <a
        class="icon-button header__gh"
        href="https://github.com/mrdarrengriffin/facet"
        aria-label="Facet on GitHub"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<!-- Mobile menu (Darren 2026-10-25: the header nav was unreachable on phones): a modal sheet from the left with the
     header links, then this page's sidebar (a docs or components page: its own list, current page marked) or the docs
     sections. Escape, the close button or the backdrop close it; focus stays inside while open (modal dialog + Tab wrap). -->
<dialog class="mmenu" id="mmenu" aria-label="Menu" data-menu>
  <div class="mmenu__head">
    <a class="header__brand" href={url('/')}>
      <Logo />
      <span>Facet</span>
    </a>
    <button class="icon-button" type="button" aria-label="Close menu" data-menu-close>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <div class="mmenu__body">
    <nav class="mmenu__nav" aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.match.some((m) => path.startsWith(m)) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mmenu__sections" data-menu-sections>
      <nav aria-label="Docs">
        {
          sections.map((g) => (
            <section class="sidebar__group">
              <h2 class="facet-label">{g.label}</h2>
              <ul>
                {g.links.map((link) => (
                  <li>
                    {link.href ? (
                      <a href={link.href} aria-current={here(link.href) ? 'page' : undefined}>
                        {link.label}
                        {link.badge && <span class="badge">{link.badge}</span>}
                      </a>
                    ) : (
                      <span class="sidebar__soon">
                        {link.label}
                        {link.badge && <span class="badge">{link.badge}</span>}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </nav>
    </div>
    <div class="mmenu__foot">
      <a href="https://buymeacoffee.com/mrdarrengriffin">Support Facet</a>
      <a href="https://github.com/mrdarrengriffin/facet">GitHub</a>
    </div>
  </div>
</dialog>

<script>
  import { initMenu } from '../scripts/menu';
  initMenu();
</script>
