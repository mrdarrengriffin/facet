---
import Logo from './Logo.astro';
import { url } from '../lib/nav';

interface Props {
  /** Show the menu button that opens the docs sidebar on small screens. */
  hasSidebar?: boolean;
}
const { hasSidebar = false } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { label: 'Docs', href: url('/docs/getting-started/'), match: url('/docs/') },
  { label: 'Design system', href: url('/design-system/'), match: url('/design-system/') },
  { label: 'Demo', href: url('/demo/'), match: url('/demo/') },
  { label: 'Install', href: url('/install/'), match: url('/install/') },
];
---

<header class="header">
  <div class="header__inner">
    {
      hasSidebar && (
        <button
          class="icon-button header__menu"
          type="button"
          aria-label="Open navigation"
          aria-controls="sidebar"
          aria-expanded="false"
          data-nav-toggle
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              d="M4 7h16M4 12h16M4 17h16"
              stroke="currentColor"
              stroke-width="1.5"
              fill="none"
              stroke-linecap="round"
            />
          </svg>
        </button>
      )
    }
    <a class="header__brand" href={url('/')}>
      <Logo />
      <span>Facet</span>
    </a>
    <nav class="header__nav" aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href} aria-current={path.startsWith(link.match) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="header__actions">
      <button class="search-button" type="button" data-search-open aria-label="Search the docs">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.5" fill="none"
          ></circle>
          <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
          ></path>
        </svg>
        <span class="search-button__label">Search</span>
        <kbd>/</kbd>
      </button>
      <button class="icon-button" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <svg
          class="theme-icon theme-icon--sun"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" fill="none"
          ></circle>
          <path
            d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
        <svg
          class="theme-icon theme-icon--moon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
        >
          <path
            d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <a
        class="icon-button"
        href="https://github.com/mrdarrengriffin/facet"
        aria-label="Facet on GitHub"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>
