---
// Which panel draws the examples: 720 = the Waveshare 1.5x build, 480 = the Guition 1x build (site-wide pref).
---

<div class="seg" role="group" aria-label="Panel size">
  <button type="button" data-pref="device" data-value="720" title="720 x 720 panels (1.5x)" aria-pressed="true">720</button>
  <button type="button" data-pref="device" data-value="480" title="480 x 480 panels (1x)" aria-pressed="false">480</button>
</div>
