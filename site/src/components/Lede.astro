---
// The page's one-line public description (meta "about", else the first clause of the README row).
import type { Entry } from '../lib/data';
interface Props { e: Entry; tag?: 'p' | 'span'; class?: string }
const { e, tag = 'p', class: cls = 'lede' } = Astro.props;
const T = tag;
---

<T class={cls}>{e.lede}</T>
