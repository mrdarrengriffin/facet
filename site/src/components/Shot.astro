---
// A screen picture made at build (scripts/shots.mjs: the renderer on the sample Home Assistant, src/data/shots.json):
// one <img> whose file follows the panel size (720 / 480, the site pref) and the theme (the box's preview theme, else
// the site's); src/scripts/shots.ts swaps it. Without script it shows the 720 dark picture. kind = main (full size:
// the screen page, the homepage panel), half (the grids) or a state id (the states strip, half size).
import shots from '../data/shots.json';
import { BASE } from '../lib/data';

type Srcs = Record<string, Record<string, string>>;
interface Props { id: string; kind?: string; alt: string; class?: string }
const { id, kind = 'main', alt, class: cls } = Astro.props;
const rec = (shots as Record<string, { main: Srcs; half: Srcs; states: { id: string; src: Srcs }[] }>)[id];
const srcs: Srcs | undefined = !rec ? undefined : kind === 'main' || kind === 'half' ? rec[kind] : rec.states.find((s) => s.id === kind)?.src;
if (!srcs) throw new Error(`Shot: no ${kind} picture for screen ${id} (scripts/shots.mjs)`);
const full = Object.fromEntries(Object.entries(srcs).map(([size, t]) => [size, Object.fromEntries(Object.entries(t).map(([th, p]) => [th, BASE + p]))]));
const w = kind === 'main' ? 720 : 360;
---

<img class:list={['shot-img', cls]} src={full['720'].dark} data-shot={JSON.stringify(full)} width={w} height={w} alt={alt} loading="lazy" decoding="async" />
