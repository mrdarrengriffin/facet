# generated by scripts/extract.mjs (npm run extract)
src/data/
public/wasm/
# build output (dist/ the one place a build goes; any other dist* folder is ignored too, never a dirty tree)
dist*/
.astro/
public/sound.json
public/previews/
# screen pictures + their cache key (scripts/shots.mjs)
public/shots/
# firmware images + manifests: published by the release workflow (GitHub Pages); copied in locally, never committed
public/firmware/
