---
// Facet release flags: /wasm/release (workbench nav > Tools > Release). Read-only view of renderer/features.json
// (the one manifest of what ships: docs site, status label, panel firmware) through its own reader
// renderer/tools/features.mjs, plus the build check (a shown feature needing a hidden one, a source in no feature).
// Flipping a flag = one edit in features.json (renderer/README.md "Features").
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { existsSync } from 'node:fs';
import { pathToFileURL } from 'node:url';
import { REPO } from '../../lib/repo';

const trees = [REPO];
const tree = trees.find((t) => existsSync(`${t}/renderer/features.json`) && existsSync(`${t}/renderer/tools/features.mjs`));
type Ft = { id: string; label: string; docs: boolean; status: string; firmware: boolean; screens?: string[]; components?: string[]; foundations?: string[]; core?: string[]; bench?: string[] };
let feats: (Ft & { lib?: number })[] = [], errors: string[] = [], statusLabel: Record<string, string> = {}, fail = '';
if (tree) {
  try {
    const F = await import(/* @vite-ignore */ `${pathToFileURL(`${tree}/renderer/tools/features.mjs`).href}?t=${Date.now()}`);
    const L = F.load();
    errors = F.check(L);
    statusLabel = L.man.status;
    const libCount = L.sources.filter((s: { feature: Ft | null; kind: string }) => s.feature?.id === 'library').reduce((n: number, s: { ids: string[] }) => n + s.ids.length, 0);
    feats = L.features.map((f: Ft) => (f.id === 'library' ? { ...f, lib: libCount } : f));
  } catch (e) { fail = String(e); }
}
const fwIn = feats.filter((f) => f.firmware), fwOut = feats.filter((f) => !f.firmware);
const scr = (fs: Ft[]) => fs.reduce((n, f) => n + (f.screens?.length ?? 0), 0);
const parts = (f: Ft & { lib?: number }) => {
  if (f.lib) return `${f.lib} components and foundations not listed under a feature`;
  return [f.screens?.length && `screens: ${f.screens.join(', ')}`, f.components?.length && `own parts: ${f.components.join(', ')}`,
    f.foundations?.length && `foundations: ${f.foundations.join(', ')}`, f.bench?.length && `bench: ${f.bench.join(', ')}`].filter(Boolean).join(' · ');
};
---

<Base title="Facet release" description="Which Facet features ship: docs site, status label and panel firmware, from the feature manifest.">
  <main class="rl">
    <header>
      <a class="rl-back" href="/wasm">Workbench</a>
      <h1>Release</h1>
      <p class="rl-muted">What goes into the docs site and the panel firmware, per feature (a screen plus the parts only it uses). Read-only: to flip one, edit <code>renderer/features.json</code> (set <code>"docs"</code> / <code>"firmware"</code> to true or false, <code>"status"</code> to done, wip or preview); the next build checks it.</p>
      {tree && <p class="rl-muted rl-small">Source: <code>{tree}/renderer/features.json</code></p>}
    </header>

    {!tree && <p class="rl-note"><span class="rl-dot rl-bad" />No features.json found in {trees.join(' or ')}.</p>}
    {fail && <p class="rl-note"><span class="rl-dot rl-bad" />Could not read the manifest: {fail}</p>}

    {feats.length > 0 && (
      <>
        <section class="rl-sum" aria-label="Summary">
          <div><strong>{fwIn.length - 1}</strong> features + the library in firmware ({scr(fwIn)} screens)</div>
          <div><strong>{fwOut.length}</strong> features left out ({scr(fwOut)} screens)</div>
          <div><strong>{feats.filter((f) => f.docs).length}</strong> shown in the docs</div>
          <div class={errors.length ? 'rl-err' : 'rl-ok'}><span class={`rl-dot ${errors.length ? 'rl-bad' : 'rl-good'}`} />{errors.length ? `${errors.length} check error(s)` : 'Check passes'}</div>
        </section>
        {errors.length > 0 && <ul class="rl-errors">{errors.map((e) => <li>{e}</li>)}</ul>}

        <div class="rl-wrap">
          <table class="rl-table">
            <thead><tr><th>Feature</th><th>Firmware</th><th>Docs</th><th>Status</th><th>What it is</th></tr></thead>
            <tbody>
              {feats.map((f) => (
                <tr class={f.firmware ? '' : 'rl-off'}>
                  <td><strong>{f.label}</strong><br /><code class="rl-small">{f.id}</code></td>
                  <td><span class={`rl-dot ${f.firmware ? 'rl-good' : 'rl-none'}`} />{f.firmware ? 'In' : 'Out'}</td>
                  <td><span class={`rl-dot ${f.docs ? 'rl-good' : 'rl-none'}`} />{f.docs ? 'Shown' : 'Hidden'}</td>
                  <td>{statusLabel[f.status] ?? f.status}</td>
                  <td class="rl-small rl-muted">{parts(f)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
  </main>
  <style>
    .rl { max-width: 1200px; margin: 0 auto; padding: 24px 16px 48px; color: var(--text); }
    .rl h1 { margin: 4px 0 8px; font-size: 28px; }
    .rl-muted { color: var(--muted); margin: 0 0 8px; font-size: 14px; line-height: 20px; }
    .rl-small { font-size: 12px; line-height: 16px; }
    .rl-back { color: var(--accent); text-decoration: none; font-size: 14px; }
    .rl-back::before { content: '\2039\00a0'; }
    .rl-sum { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 24px 0 16px; padding: 16px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); font-size: 14px; }
    .rl-note { padding: 12px 16px; border-radius: var(--radius); background: var(--surface); margin: 16px 0; }
    .rl-errors { margin: 0 0 16px; padding: 12px 16px 12px 32px; border-radius: var(--radius); background: var(--surface); color: var(--bad); font-size: 13px; }
    .rl-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 8px; vertical-align: middle; }
    .rl-good { background: var(--ok); }
    .rl-bad { background: var(--bad); }
    .rl-none { background: transparent; border: 1px solid var(--muted); width: 6px; height: 6px; }
    .rl-wrap { overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--border); }
    .rl-table { width: 100%; border-collapse: collapse; font-size: 14px; background: var(--surface); }
    .rl-table th, .rl-table td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
    .rl-table th { color: var(--muted); font-weight: 500; font-size: 12px; }
    .rl-table tr:last-child td { border-bottom: 0; }
    .rl-off td:first-child strong { color: var(--muted); }
    @media (max-width: 600px) { .rl-table td:last-child, .rl-table th:last-child { display: none; } }
  </style>
</Base>
