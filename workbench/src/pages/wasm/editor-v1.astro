---
// Facet editor v1 (scope workbench/EDITOR-V1.md) in the workbench: parts 1-3 (Screens, the grid, Settings) and Save
// (review, check, Undo). The page and its boot data: src/wasm/editor-v1-page.mjs (shared with the bundle a panel
// serves, scripts/editor-device.mjs). Here the host is src/wasm/editor-v1-host.ts: nothing is sent, "the panel" is this
// page's memory, Home Assistant is a stub (screens show sample data), entity pickers list tests/editor/fixtures.
export const prerender = false;
import { join } from 'node:path';
import { editorPage } from '../../wasm/editor-page.mjs';
import { v1Boot, v1Body } from '../../wasm/editor-v1-page.mjs';
import { REPO } from '../../lib/repo';

const { css } = editorPage(join(REPO, 'renderer'));
const body = v1Body(v1Boot(REPO), '<span>Editor v1 · parts 1 to 3, Screens, the grid, Settings</span><span class="dim">Nothing reaches a panel: "the panel" is this page. Home Assistant is a stub, so screens show sample data.</span>');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Facet editor v1</title>
    <meta name="description" content="Facet editor v1: your screens as tabs (part 1), cards on each screen's grid (part 2), the panel's Settings (part 3), and Save with review and check." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline set:html={css}></style>
  </head>
  <body set:html={body}>
  </body>
  <script>
    import '../../wasm/editor-v1-fonts.css';
    import '../../wasm/editor-v1.css';
    import { start } from '../../wasm/editor-v1';
    start();
  </script>
</html>
