---
// Editor lab (/wasm/editor-lab): the scratch page for prototyping a new panel editor (the current one is
// /wasm/editor). Hot reload, the real WASM engine for the preview. Code: src/wasm/editor-lab.ts.
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editor lab</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      :root { --bg: #0b0b0d; --panel: #141417; --line: #26262b; --text: #ececf0; --muted: #8b8b95; --accent: #e8613a; }
      @media (prefers-color-scheme: light) { :root { --bg: #f4f2ee; --panel: #ffffff; --line: #e2dfd8; --text: #18181b; --muted: #6b6b73; } }
      html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 14px/1.45 Inter, system-ui, sans-serif; }
      .lab { display: grid; grid-template-columns: 280px 1fr 320px; grid-template-rows: 52px 1fr; height: 100vh; }
      .lab > header { grid-column: 1 / -1; display: flex; align-items: center; gap: 12px; padding: 0 18px; border-bottom: 1px solid var(--line); }
      .lab > header strong { font-size: 15px; }
      .lab > header .muted, .muted { color: var(--muted); }
      .lab > header a { color: var(--muted); margin-left: auto; text-decoration: none; }
      .lab > header a:hover { color: var(--text); }
      aside { padding: 18px; border-right: 1px solid var(--line); background: var(--panel); overflow: auto; }
      aside.right { border-right: 0; border-left: 1px solid var(--line); }
      aside h2 { margin: 0 0 8px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      .stagewrap { display: flex; align-items: center; justify-content: center; padding: 24px; overflow: auto; }
      #dev canvas:not(#taps) { display: block; border-radius: 18px; box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35); image-rendering: pixelated; }
      .empty { border: 1px dashed var(--line); border-radius: 10px; padding: 14px; color: var(--muted); font-size: 13px; }
      #dev { position: relative; }
      #ov { position: absolute; left: 0; top: 0; pointer-events: none; }
      #ov button { position: absolute; pointer-events: auto; background: none; border: 0; padding: 0; margin: 0; cursor: pointer; border-radius: 10px; font: inherit; color: var(--accent); }
      .ov-node { outline: 1px solid transparent; outline-offset: -1px; }
      .ov-node:hover, .ov-node.on { outline-color: var(--accent); }
      .ov-node .tag { position: absolute; left: 6px; top: -10px; font-size: 11px; padding: 1px 6px; border-radius: 6px; background: var(--accent); color: #fff; opacity: 0; pointer-events: none; }
      .ov-node:hover .tag, .ov-node.on .tag { opacity: 1; }
      .ov-slot { display: flex; align-items: center; justify-content: center; line-height: 1; box-sizing: border-box; border: 1.5px dashed color-mix(in srgb, var(--accent) 55%, transparent) !important; font-size: 28px !important; font-weight: 300; background: color-mix(in srgb, var(--accent) 6%, transparent) !important; }
      .ov-slot::before, .ov-slot::after { content: ''; position: absolute; left: 50%; top: 50%; width: 18px; height: 2px; margin: -1px 0 0 -9px; border-radius: 1px; background: currentColor; }
      .ov-slot::after { transform: rotate(90deg); }
      .ov-slot:hover, .ov-slot.on { background: color-mix(in srgb, var(--accent) 16%, transparent) !important; border-style: solid !important; }
      .search { width: 100%; box-sizing: border-box; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--text); margin: 8px 0 12px; }
      .minis { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .mini { display: flex; flex-direction: column; align-items: stretch; gap: 6px; padding: 8px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg); color: var(--text); cursor: pointer; font: inherit; }
      .mini:hover { border-color: var(--accent); }
      .mini .pic { height: 96px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
      .mini canvas { border-radius: 6px; }
      .mini .nm { font-size: 12px; text-align: center; }
      .prop input:not([type=checkbox]), .prop select { width: 100%; box-sizing: border-box; padding: 6px 8px; border-radius: 6px; border: 1px solid var(--line); background: var(--bg); color: var(--text); }
      .btn { margin-top: 14px; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--line); background: none; color: var(--text); cursor: pointer; }
      .btn:hover { border-color: var(--accent); }
      #taps { position: absolute; left: 0; top: 0; pointer-events: none; display: none; }
      #tapsum { font-size: 12px; }
      #tapsbtn, #specbtn { margin-left: 8px; padding: 5px 10px; border-radius: 7px; border: 1px solid var(--line); background: none; color: var(--muted); cursor: pointer; font: inherit; }
      #revertbtn, #target { padding: 5px 10px; border-radius: 7px; border: 1px solid var(--line); background: none; color: var(--muted); cursor: pointer; font: inherit; }
      #sendmsg { font-size: 12px; max-width: 360px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      #sendmsg.bad { color: #e5484d; }
      #tapsbtn[aria-pressed=true], #specbtn[aria-pressed=true] { color: var(--text); border-color: var(--accent); }
      .specpane { display: none; }
      body.spec .specpane { display: flex; flex-direction: column; gap: 8px; height: 100%; }
      body.spec .outline { display: none; }
      #spec { flex: 1; min-height: 300px; width: 100%; box-sizing: border-box; font: 12px/1.4 ui-monospace, monospace; background: var(--bg); color: var(--text); border: 1px solid var(--line); border-radius: 8px; padding: 8px; resize: none; }
      #err { font: 12px/1.4 ui-monospace, monospace; color: var(--muted); white-space: pre-wrap; }
      #err.bad { color: #e5484d; }
      .sidetop { position: sticky; top: -18px; margin: -18px -18px 12px; padding: 14px 18px 12px; background: var(--panel); border-bottom: 1px solid var(--line); display: flex; gap: 12px; align-items: flex-start; z-index: 2; }
      .sidetop .ttl { flex: 1; min-width: 0; }
      .sidetop h2 { margin: 0; font-size: 15px; letter-spacing: 0; text-transform: none; color: var(--text); }
      .sidetop .muted { margin: 4px 0 0; font-size: 12px; }
      .done { padding: 7px 14px; border-radius: 8px; border: 0; background: var(--accent); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
      .group { margin-bottom: 16px; }
      .group h3 { margin: 0 0 8px; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); display: flex; gap: 6px; align-items: center; }
      .group h3 .n { font-size: 11px; padding: 0 6px; border-radius: 9px; background: var(--line); color: var(--muted); letter-spacing: 0; }
      .prop { display: block; margin: 0 0 14px; }
      .prop .pl { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
      .prop .help { margin: 6px 0 0; font-size: 12px; color: var(--muted); line-height: 1.4; }
      .chips { display: flex; flex-wrap: wrap; gap: 6px; }
      .chip, .switch { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg); color: var(--text); font: inherit; font-size: 13px; cursor: pointer; }
      .chip.on, .switch.on { background: var(--accent); border-color: var(--accent); color: #fff; }
      .btn.danger { color: #e5484d; }
      .cardrow .pl { margin-bottom: 6px; }
      .chip:disabled { opacity: 0.4; cursor: default; }
      /* a Home card's dialog (step 1 of the new editor, ported from the old editor's card modal) */
      .lab-dialog { width: min(880px, 94vw); max-height: 86vh; padding: 0; border: 1px solid var(--line); border-radius: 16px; background: var(--panel); color: var(--text); }
      .lab-dialog::backdrop { background: rgba(0, 0, 0, 0.55); }
      .cm { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px 24px; padding: 20px 24px 24px; align-items: start; }
      .cm-head { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-start; }
      .cm-head .ttl { flex: 1; min-width: 0; }
      .cm-head .cap { font-size: 12px; color: var(--muted); }
      .cm-head h2 { margin: 2px 0 0; font-size: 18px; letter-spacing: 0; text-transform: none; color: var(--text); }
      .cm-head .btn { margin-top: 0; }
      .cm-prev { display: flex; align-items: center; justify-content: center; padding: 24px; min-height: 200px; box-sizing: border-box; background: var(--bg); border: 1px solid var(--line); border-radius: 12px; position: sticky; top: 0; }
      .cm-crop { position: relative; overflow: hidden; opacity: 0; transition: opacity 0.15s; pointer-events: none; }
      .cm-crop.ready, .cm-crop.full { opacity: 1; }
      .cm-crop canvas { position: absolute; display: block; height: auto; }
      .cm-crop.full { width: 100%; }
      .cm-crop.full canvas { position: static; width: 100%; }
      .cm-acts { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 12px; border-top: 1px solid var(--line); }
      .cm-acts .btn { margin-top: 0; }
      .cm-acts .btn:disabled { opacity: 0.4; cursor: default; }
      .linkish { background: none; border: 0; padding: 0; color: var(--text); font: inherit; font-weight: 600; cursor: pointer; text-align: left; }
      .linkish:hover { color: var(--accent); }
      #ov .ov-card { border-radius: 12px; }
      #ov .ov-card .tag { white-space: nowrap; max-width: calc(100% - 12px); overflow: hidden; text-overflow: ellipsis; }
      @media (max-width: 700px) { .lab-dialog { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; border: 0; border-radius: 0; } .cm { grid-template-columns: minmax(0, 1fr); padding: 16px; } .cm-prev { position: static; } }
      /* step 2: a selected Home card's settings in the side panel (bottom sheet on a phone), staged until Save */
      .note { display: flex; gap: 8px; align-items: center; margin: 0 0 14px; padding: 8px 12px; border-radius: 10px; font-size: 13px; background: color-mix(in srgb, var(--muted) 12%, transparent); color: var(--text); }
      .note::before { content: ''; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
      .note.warn { background: color-mix(in srgb, #e8b33a 16%, transparent); }
      .note.warn::before { background: #e8b33a; }
      .note.ok { background: color-mix(in srgb, #5dbe7e 16%, transparent); }
      .note.ok::before { background: #5dbe7e; }
      .note.quiet { color: var(--muted); }
      .cs-foot { position: sticky; bottom: -18px; margin: 16px -18px -18px; padding: 12px 18px; background: var(--panel); border-top: 1px solid var(--line); display: flex; gap: 8px; justify-content: flex-end; z-index: 2; }
      .cs-foot .btn { margin-top: 0; }
      .cs-foot .done:disabled { opacity: 0.45; cursor: default; }
      /* pick up a Home card: it lifts and follows the pointer, the others glide out of its way */
      #dev.dragging, #dev.dragging * { cursor: grabbing !important; }
      #dev.dragging #ov button { opacity: 0; }
      #ov .ov-card { touch-action: manipulation; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
      .ed-lift { position: fixed; left: 0; top: 0; z-index: 1000; pointer-events: none; border-radius: 12px; overflow: hidden; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45); transition: scale 0.18s cubic-bezier(0.2, 0, 0, 1); will-change: transform; }
      .ed-lift.up { scale: 1.04; }
      .ed-lift.landing { transition: transform 0.22s cubic-bezier(0.2, 0, 0, 1), scale 0.22s cubic-bezier(0.2, 0, 0, 1); }
      .ed-lift > canvas { display: block; width: 100%; height: 100%; }
      .ed-lay { position: absolute; left: 0; top: 0; overflow: hidden; pointer-events: none; border-radius: 18px; }
      .ed-lay > .bg { display: block; width: 100%; height: 100%; box-shadow: none !important; border-radius: 0 !important; }
      .ed-lay > .g { position: absolute; display: block; box-shadow: none !important; border-radius: 0 !important; transition: left 0.22s cubic-bezier(0.2, 0, 0, 1), top 0.22s cubic-bezier(0.2, 0, 0, 1); }
      .ed-lay > .slot { border-radius: 12px; box-shadow: inset 0 0 0 2px var(--accent) !important; background: color-mix(in srgb, var(--accent) 12%, transparent); }
      @media (prefers-reduced-motion: reduce) { .ed-lift, .ed-lift.landing, .ed-lay > .g { transition: none; } .ed-lift.up { scale: 1; } }
      #ov .ov-card.on { outline: 2px solid var(--accent); outline-offset: 2px; }
      /* the Home's header buttons: the header box on the glass, the list in the side panel (drag a row to reorder) */
      #ov .ov-head { border-radius: 12px; }
      #ov .ov-head.on { outline: 2px solid var(--accent); outline-offset: 2px; }
      .hb-list { display: flex; flex-direction: column; gap: 8px; margin: 0 0 12px; }
      .hb-row { border: 1px solid var(--line); border-radius: 10px; padding: 0 12px; background: var(--panel); }
      .hb-row.open { border-color: var(--accent); padding-bottom: 12px; }
      .hb-row.lifted { box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35); border-color: var(--accent); }
      .hb-head { display: flex; gap: 10px; align-items: center; width: 100%; min-height: 44px; padding: 8px 0; border: 0; background: none; color: var(--text); font: inherit; text-align: left; cursor: pointer; touch-action: manipulation; -webkit-user-select: none; user-select: none; }
      .hb-head .muted { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
      .hb-grip { color: var(--muted); cursor: grab; letter-spacing: -2px; }
      @media (max-width: 900px) {
        body.card-sel aside.right { position: fixed; left: 0; right: 0; bottom: 0; max-height: 46vh; overflow: auto; z-index: 20; border-top: 1px solid var(--line); border-radius: 16px 16px 0 0; box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.35); }
        body.card-sel .lab { padding-bottom: 46vh; }
        .lab { grid-template-columns: minmax(0, 1fr) !important; } .lab > * { min-width: 0; } .lab > header { overflow-x: auto; }
        body.card-sel .stagewrap { padding: 12px 16px; scroll-margin-top: 0; }
      }
      @media (max-width: 900px) { .lab { grid-template-columns: 1fr; grid-template-rows: 52px auto auto auto; height: auto; } aside { border: 0; } }
    </style>
  </head>
  <body>
    <div class="lab">
      <header>
        <strong>Editor lab</strong><span class="muted">prototype 1 · slot-first · Home, your screens, built-ins</span>
        <span id="tapsum" class="muted"></span>
        <button id="tapsbtn" type="button" aria-pressed="false">Tap areas</button>
        <button id="specbtn" type="button" aria-pressed="false">Spec</button>
        <span id="sendmsg" class="muted"></span>
        <select id="target" title="Which panel"><option value="waveshare">Waveshare</option><option value="guition">Guition</option><option value="browser">Browser panel</option></select>
        <button id="revertbtn" type="button" title="Put the panel back to its factory deck and screens">Revert panel</button>
        <button id="sendbtn" class="done" type="button" title="Send your Home and your screens to the panel">Send to panel</button>
      </header>
      <aside><div class="prop"><span class="pl">Screen</span><select id="screen"></select></div><div class="outline"><h2>How it works</h2><p class="muted">The panel is the editor. Dashed boxes with + are empty slots: tap one to see only what fits there. Tap any part of the screen to change it. Esc to deselect.</p></div><div class="specpane"><h2>Spec</h2><textarea id="spec" spellcheck="false"></textarea><div id="err"></div></div></aside>
      <main class="stagewrap"><div id="dev"></div></main>
      <aside class="right" id="side"></aside>
    </div>
    <dialog id="cm" class="lab-dialog" aria-label="Card"></dialog>
    <script>
      import { start } from '../../wasm/editor-lab';
      start();
    </script>
  </body>
</html>
